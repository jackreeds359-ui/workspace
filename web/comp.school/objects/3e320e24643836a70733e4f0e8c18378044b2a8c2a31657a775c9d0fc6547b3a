const t=1,e=JSON.parse(`[{"source":"data/pdf/j277/module-resources/1.1/frayer-1.pdf","sourceSha256":"4d495d0b0d3f2d368396464772fcb56496a0e720799a711aff93c817b174641f","code":"1.1.1","title":"CPU architecture","terms":[{"term":"Fetch-decode-execute cycle","windows":{"definition":[["The repeated process in which the CPU fetches an instruction from ",{"answer":"memory"},", decodes it and then executes it."]],"characteristics":[["Fetch: the address in the PC is copied to the MAR, the instruction is copied to the MDR and the PC is ",{"answer":"incremented"},". Decode: the CU works out what to do. Execute: it is carried out."]],"examples":[["For ADD 5: the instruction is fetched from RAM, the CU decodes it, then the ",{"answer":"ALU"}," adds 5 to the accumulator."]],"nonExamples":[["The cycle does not run once per program. It repeats for ",{"answer":"every instruction"},", billions of times per second, until the program ends."]]},"wordBank":["ALU","every instruction","incremented","memory"],"sketch":{"cloze":{"page":5,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":6,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Central processing unit (CPU)","windows":{"definition":[["The component that processes data and ",{"answer":"executes instructions"}," by repeating the fetch-decode-execute cycle."]],"characteristics":[["Contains the control unit, ALU, cache and registers. Its performance depends on ",{"answer":"clock speed"},", cache size and the number of cores."]],"examples":[["When a game runs, each instruction is copied from RAM to the CPU, which ",{"answer":"decodes"}," it and carries it out."]],"nonExamples":[["The CPU is not the whole computer tower, and it does not keep files long term: that is ",{"answer":"secondary storage"},". RAM is also separate from the CPU."]]},"wordBank":["clock speed","decodes","executes instructions","secondary storage"],"sketch":{"cloze":{"page":8,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":9,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Program counter (PC)","windows":{"definition":[["A register that stores the ",{"answer":"address"}," of the next instruction to be fetched."]],"characteristics":[["At the start of each cycle its contents are copied to the MAR. It is then ",{"answer":"incremented"}," (1 is added) so that it points to the next instruction."]],"examples":[["The PC holds 120. Address 120 is copied to the MAR, then the PC becomes ",{"answer":"121"},"."]],"nonExamples":[["The PC does not count how many programs are open, and it does not hold the instruction itself: a fetched instruction is held in the ",{"answer":"MDR"},"."]]},"wordBank":["121","address","incremented","MDR"],"sketch":{"cloze":{"page":11,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":12,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Memory address register (MAR)","windows":{"definition":[["A register that holds the memory ",{"answer":"address"}," of the instruction or data to be fetched from, or written to, memory."]],"characteristics":[["It holds an address, never the data itself. During the fetch stage the address is copied into it from the ",{"answer":"program counter"},"."]],"examples":[["To read location 240, the MAR holds 240. RAM then sends the contents of that location to the ",{"answer":"MDR"},"."]],"nonExamples":[["The MAR does not hold the ",{"answer":"data"}," found at the address: that is the job of the MDR. MAR = where to look; MDR = what was found there."]]},"wordBank":["address","data","MDR","program counter"],"sketch":{"cloze":{"page":14,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":15,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Memory data register (MDR)","windows":{"definition":[["A register that holds the ",{"answer":"data or instruction"}," that has just been fetched from memory, or is about to be written to memory."]],"characteristics":[["It holds contents, not locations. A fetched instruction is held here before it is ",{"answer":"decoded"},". It works as a pair with the MAR."]],"examples":[["Address 240 contains the value 19. After a read, the MAR holds 240 and the MDR holds ",{"answer":"19"},"."]],"nonExamples":[["The MDR does not store the address being accessed: that is the ",{"answer":"MAR"},". It does not store the results of calculations either: that is the accumulator."]]},"wordBank":["19","data or instruction","decoded","MAR"],"sketch":{"cloze":{"page":17,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":18,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Accumulator (ACC)","windows":{"definition":[["A register that stores the ",{"answer":"result"}," of arithmetic and logical operations carried out by the ALU."]],"characteristics":[["It is inside the CPU and works closely with the ALU. It holds the data currently being ",{"answer":"processed"},"; each new result overwrites the last one."]],"examples":[["The ALU adds 12 and 9. The answer, ",{"answer":"21"},", is stored in the accumulator ready for the next instruction."]],"nonExamples":[["The ACC does not store ",{"answer":"addresses"}," (that is the PC and MAR), and it does not perform the calculation itself: the ALU does that."]]},"wordBank":["21","addresses","processed","result"],"sketch":{"cloze":{"page":20,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":21,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Arithmetic logic unit (ALU)","windows":{"definition":[["The CPU component that performs ",{"answer":"arithmetic"}," calculations and logical operations."]],"characteristics":[["Arithmetic: add and subtract. Logic: comparisons such as greater than, and ",{"answer":"AND, OR, NOT"},". Its results are stored in the accumulator."]],"examples":[["For if score > 50, the ALU makes the ",{"answer":"comparison"},". For score = score + 1, it does the addition."]],"nonExamples":[["The ALU does not decode instructions or send control signals: that is the ",{"answer":"control unit"},". It does not store the results it produces."]]},"wordBank":["AND, OR, NOT","arithmetic","comparison","control unit"],"sketch":{"cloze":{"page":23,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":24,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Control unit (CU)","windows":{"definition":[["The CPU component that ",{"answer":"decodes"}," instructions and coordinates the other parts of the CPU."]],"characteristics":[["Sends ",{"answer":"control signals"}," to manage the flow of data around the CPU and to memory. Controls and synchronises the fetch-decode-execute cycle."]],"examples":[["The CU decodes the instruction ADD 5, then signals the ",{"answer":"ALU"}," to carry out the addition."]],"nonExamples":[["The CU does not perform ",{"answer":"calculations"}," or comparisons itself. It works out what an instruction means, then tells other components what to do."]]},"wordBank":["ALU","calculations","control signals","decodes"],"sketch":{"cloze":{"page":26,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":27,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Cache","windows":{"definition":[["Very fast memory inside or close to the CPU that stores ",{"answer":"frequently used"}," instructions and data."]],"characteristics":[["Faster to access than RAM, but much ",{"answer":"smaller"}," in capacity and more expensive. The CPU checks cache first, so it spends less time waiting."]],"examples":[["A loop repeats 1000 times. Its instructions are held in cache, so the CPU avoids slower trips to ",{"answer":"RAM"},"."]],"nonExamples":[["Cache is not secondary storage and is not the same as RAM. It is ",{"answer":"volatile"},", and it holds only the most frequently used items, not every open program."]]},"