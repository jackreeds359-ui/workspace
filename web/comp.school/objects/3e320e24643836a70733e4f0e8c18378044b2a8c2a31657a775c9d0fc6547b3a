688}}}]},{"source":"data/pdf/j277/module-resources/1.1/frayer-2.pdf","sourceSha256":"c6328628864459524907d5399d39b2f03900408c8cffdc9f0db98abf0c2195b8","code":"1.1.2","title":"CPU performance","terms":[{"term":"Clock speed","windows":{"definition":[["The number of fetch-decode-execute ",{"answer":"cycles per second"}," that the CPU can carry out, measured in hertz (Hz)."]],"characteristics":[["A higher clock speed means more instructions are executed per second, so programs run faster. 1 GHz = 1 ",{"answer":"billion"}," cycles per second."]],"examples":[["Computer A is 3.2 GHz and Computer B is 1.2 GHz. Both are single core, so ",{"answer":"Computer A"}," usually runs faster."]],"nonExamples":[["A higher clock speed does not always win: a CPU with more ",{"answer":"cores"}," or a larger cache may be faster. In exams write 'clock speed', not just 'speed'."]]},"wordBank":["billion","Computer A","cores","cycles per second"],"sketch":{"cloze":{"page":5,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":6,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Number of cores","windows":{"definition":[["The number of independent processing units in a CPU, each able to run its own ",{"answer":"fetch-decode-execute cycle"},"."]],"characteristics":[["More cores mean more instructions can be processed ",{"answer":"simultaneously"},", which helps multitasking. Dual core = 2 cores; quad core = 4 cores."]],"examples":[["A 3D flight simulator runs faster on a quad-core CPU because its work is ",{"answer":"split"}," across the 4 cores."]],"nonExamples":[["Doubling the cores does not always double the speed: some tasks cannot be divided up, and the software must be ",{"answer":"written"}," to use several cores."]]},"wordBank":["fetch-decode-execute cycle","simultaneously","split","written"],"sketch":{"cloze":{"page":8,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":9,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Cache size","windows":{"definition":[["The amount of fast cache memory in the CPU available to hold ",{"answer":"frequently used"}," instructions and data."]],"characteristics":[["A larger cache holds more instructions and data, so the CPU fetches from slower ",{"answer":"RAM"}," less often and spends less time waiting."]],"examples":[["CPU X has 4 MB of cache; CPU Y has 16 MB. With equal clock speed and cores, ",{"answer":"CPU Y"}," should be faster."]],"nonExamples":[["Cache size is not RAM size or storage capacity. Cache is measured in ",{"answer":"megabytes"}," (around 8 MB), far smaller than RAM (around 16 GB), as it is expensive."]]},"wordBank":["CPU Y","frequently used","megabytes","RAM"],"sketch":{"cloze":{"page":11,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":12,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}}]},{"source":"data/pdf/j277/module-resources/1.1/frayer-3.pdf","sourceSha256":"431f03e050a93d79d89b0cffb5d689ee5514e2b3c66a90b4097c81b962784fc1","code":"1.1.3","title":"Embedded systems","terms":[{"term":"Embedded system","windows":{"definition":[["A computer system ",{"answer":"built into"}," a larger device that has a dedicated (specific) function."]],"characteristics":[["Has ",{"answer":"limited functions"},", a microprocessor, dedicated hardware such as sensors, and built-in software stored in ROM. Hard to change or update."]],"examples":[["A washing machine: a microprocessor reads the water ",{"answer":"sensor"}," and controls the motor and heater."]],"nonExamples":[["A laptop is not embedded: it is ",{"answer":"general purpose"}," and runs many applications. 'Built into the car' earns no mark if the question already says so."]]},"wordBank":["built into","general purpose","limited functions","sensor"],"sketch":{"cloze":{"page":5,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":6,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Dedicated function","windows":{"definition":[["The single, specific task (or limited set of tasks) that an embedded system is ",{"answer":"designed"}," to carry out."]],"characteristics":[["The hardware and software are built only for that task, so the system can be small, cheap, reliable and use little ",{"answer":"power"},". Users cannot easily change what it does."]],"examples":[["A dishwasher controller only runs ",{"answer":"wash programs"},": it cannot browse the web or edit documents."]],"nonExamples":[["Dedicated does not mean one instruction: a bread maker heats, times and mixes, but all for ",{"answer":"one purpose"},". A phone that runs many apps is not dedicated."]]},"wordBank":["designed","one purpose","power","wash programs"],"sketch":{"cloze":{"page":8,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":9,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Firmware","windows":{"definition":[["Software stored in ",{"answer":"ROM"}," inside a device that controls its hardware and runs as soon as the device is switched on."]],"characteristics":[["Stored in ",{"answer":"non-volatile"}," memory, so it is kept with no power. Written for one specific device; the maker may update it, but the user rarely changes it."]],"examples":[["A microwave's firmware holds the instructions for its keypad, ",{"answer":"timer"}," and display."]],"nonExamples":[["Firmware is not an app that the user installs, and it is not held in ",{"answer":"RAM"},", where it would be lost at power off. Sensor readings are data, not firmware."]]},"wordBank":["non-volatile","RAM","ROM","timer"],"sketch":{"cloze":{"page":11,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":12,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"General-purpose computer","windows":{"definition":[["A computer designed to carry out ",{"answer":"many different tasks"}," by running a wide range of software."]],"characteristics":[["The user can ",{"answer":"install"}," new programs to change what it does. Usually has a full operating system and more RAM and storage than an embedded system."]],"examples":[["A laptop used for coding, browsing the web and editing video, all by running different ",{"answer":"applications"},"."]],"nonExamples":[["A sat nav or washing machine is not general purpose: it is an ",{"answer":"embedded system"}," with limited functions that the user cannot change."]]},"wordBank":["applications","embedded system","install","many different tasks"],"sketch":{"cloze":{"page":14,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":15,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}}]},{"source":"data/pdf/j277/module-resources/1.2/frayer-1.pdf","sourceSha256":"33242aa288c0819860ab6fe236e4ac6836f4ff299d3b9165fe045f8fd868c4bc","code":"1.2.1","title":"Primary storage","terms":[{"term":"RAM (random access memory)","windows":{"definition":[["Primary storage that holds the programs, instructions and data ",{"answer":"currently in use"},", including the running operating system."]],"characteristics":[[{"answer":"Volatile"},": contents are lost when the power is off. Can be read from and written to. Much larger than ROM; more RAM means less need for virtual memory."]],"examples":[["A laptop's RAM holds the running operating system, an open web browser and the ",{"answer":"unsaved"}," essay being typed."]],"nonExamples":[["RAM does not keep saved files after shutdown: that is ",{"answer":"secondary storage"},". It does not hold the boot program: that is ROM."]]},"wordBank":["currently in use","secondary storage","unsaved","Volatile"],"sketch":{"cloze":{"page":5,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":6,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"ROM (read only memory)","windows":{"definition":[["Primary storage whose contents cannot normally be changed; it holds the ",{"answer":"start-up instructions"}," for the computer."]],"characteristics":[[{"answer":"Non-volatile"},": contents are kept with no power. Read only, so it is not written to in normal use. Much smaller capacity than RAM."]],"examples":[["A sat nav's boot program is held in ROM, so it is not ",{"answer":"lost"}," when the sat nav is switched off."]],"nonExamples":[["ROM does not hold open maps, routes or documents: data that changes is held in ",{"answer":"RAM"},". ROM is not secondary storage, even though it keeps its contents."]]},"wordBank":["lost","Non-volatile","RAM","start-up instructions"],"sketch":{"cloze":{"page":8,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":9,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Virtual memory","windows":{"definition":[["An area of ",{"answer":"secondary storage"}," that is used as if it were RAM when the RAM is full."]],"characteristics":[["Data not in use is moved from RAM to VM, then ",{"answer":"transferred back"}," when needed. VM is slower than RAM; more RAM reduces the need for VM."]],"examples":[["An artist opens many large images. RAM is full, so images not being edited are ",{"answer":"moved"}," to VM on the SSD."]],"nonExamples":[["VM is not extra RAM chips, and ROM never overflows into it. It does not make the computer ",{"answer":"faster"},": heavy use of VM slows the computer down."]]},"wordBank":["faster","moved","secondary storage","transferred back"],"sketch":{"cloze":{"page":11,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688},"answers":{"page":12,"top":0.3297,"bottom":0.6507,"left":0.7308,"right":0.9688}}},{"term":"Volatile memory","windows":{"definition":[["Memory that ",{"answer":"loses its contents"}," when the power is turned off."]],"characteristics":[["RAM and cache are volatile. They hold ",{"answer":"temporary"}," working data, so work must be saved to secondary storage to keep it."]],"examples":[["A power cut happens while a student types an essay: the ",{"answe