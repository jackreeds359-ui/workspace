.aquatic-scene{background:radial-gradient(ellipse 80% 45% at 50% -5%,rgba(125,211,252,.28) 0%,transparent 70%),linear-gradient(180deg,#0f5a80,#0b3f60 30%,#082c46 62%,#061d30)}.aquatic-scene .aquatic-rays{position:absolute;inset:0;overflow:hidden;pointer-events:none}.aquatic-scene .aquatic-rays span{position:absolute;top:-10%;height:75%;width:14%;background:linear-gradient(180deg,rgba(186,230,253,.16) 0%,transparent 100%);filter:blur(6px);transform-origin:top center;animation:aquatic-ray-sway 9s ease-in-out infinite alternate}.aquatic-scene .aquatic-rays span:nth-child(1){left:12%;transform:rotate(14deg)}.aquatic-scene .aquatic-rays span:nth-child(2){left:38%;width:9%;transform:rotate(8deg);animation-delay:-3s}.aquatic-scene .aquatic-rays span:nth-child(3){left:63%;width:12%;transform:rotate(-6deg);animation-delay:-6s}.aquatic-scene .aquatic-rays span:nth-child(4){left:84%;width:7%;transform:rotate(-12deg);animation-delay:-1.5s}@keyframes aquatic-ray-sway{0%{opacity:.55;margin-left:-1.5%}to{opacity:1;margin-left:1.5%}}.aquatic-scene .aquatic-bubbles span{position:absolute;bottom:-20px;border:1.5px solid rgba(224,242,254,.55);border-radius:9999px;background:radial-gradient(circle at 30% 30%,rgba(255,255,255,.35),transparent 60%);animation:aquatic-rise linear infinite;pointer-events:none}@keyframes aquatic-rise{0%{transform:translate(0);opacity:0}10%{opacity:.9}50%{transform:translate(10px,-50vh)}to{transform:translate(-6px,-100vh);opacity:0}}@media(prefers-reduced-motion:reduce){.aquatic-scene .aquatic-rays span,.aquatic-scene .aquatic-bubbles span{animation:none}.aquatic-scene .aquatic-bubbles{display:none}}.aquatic-scene:fullscreen [data-sea-content]{padding-top:calc(env(safe-area-inset-top,0px) + 4.25rem)}
