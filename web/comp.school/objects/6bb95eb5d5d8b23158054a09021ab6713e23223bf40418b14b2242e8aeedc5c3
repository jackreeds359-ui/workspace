t_ids[i] == target:\\n        index = i\\n\\nif index == -1:\\n    print(\\"ID\\", target, \\"not found\\")\\nelse:\\n    print(\\"ID\\", target, \\"artist:\\", artists[index])\\n"},{"id":"silver-linear-count-word","level":"Silver","levelNumber":2,"challengeNumber":4,"algorithm":"Linear search","title":"Count Pop artists","illustration":"count","animalContext":"Count every Pop entry in a genre list. Do not stop after the first match.","learningGoal":"Use linear search to count all matches, not just the first match.","sourceType":"hybrid","sourceLabel":"Lesson style","sourceReference":"Artist and genre list adapted from the lesson context.","fixCount":6,"instructions":["Write the loop as for genre in genres: - the numbered recipe shows the two steps.","Compare each genre with target using ==.","Add 1 to count for every match, not just the first one."],"starterCode":"# Silver 2 - count matches with linear search\\ngenres = [\\"Grime\\", \\"Pop\\", \\"Pop\\", \\"Afrobeats\\", \\"Pop\\", \\"Rap\\"]\\ntarget = \\"Pop\\"\\ncount = 0\\n\\n# Write a FOR loop that checks every genre in genres:\\n#   IF genre matches target\\n#        count goes up by 1\\n\\nprint(target, \\"appears\\", count, \\"times\\")\\n","expectedOutput":"Pop appears 3 times","checks":["The loop checks each genre in genres.","The if statement compares genre with target.","The count increases by 1 for each match.","The final print uses the target, count and times text.","The search does not break after the first match.","The output is exactly Pop appears 3 times."],"hints":["Use print(genre) inside the loop to see every value being checked.","Use count = count + 1 only inside the if block.","Remove any test print() lines before the final check."],"teacherSolution":"# Silver 2 - count matches with linear search\\ngenres = [\\"Grime\\", \\"Pop\\", \\"Pop\\", \\"Afrobeats\\", \\"Pop\\", \\"Rap\\"]\\ntarget = \\"Pop\\"\\ncount = 0\\n\\nfor genre in genres:\\n    if genre == target:\\n        count = count + 1\\n\\nprint(target, \\"appears\\", count, \\"times\\")\\n"},{"id":"gold-bubble-linked-names","level":"Gold","levelNumber":3,"challengeNumber":5,"algorithm":"Bubble sort","title":"Sort artists by albums","illustration":"bubble-sort","animalContext":"Artist names and Spotify album counts are in matching positions. Sort the counts highest first and keep each artist attached to the correct number.","learningGoal":"Bubble sort matching lists by swapping related values together.","sourceType":"hybrid","sourceLabel":"Lesson style","sourceReference":"Artist-name and album-count sorting cards combined.","fixCount":6,"instructions":["The bubble sort swaps album_counts with a temporary variable, just like Bronze 2.","Swap the matching artists the same way, using their own temporary variable.","Then set swapped = True inside the if, after both swaps, so the early-stop check works."],"starterCode":"# Gold 1 - bubble sort matching lists\\nartists = [\\"Stormzy\\", \\"Raye\\", \\"Dua Lipa\\", \\"Burna Boy\\"]\\nalbum_counts = [3, 1, 5, 7]\\n\\nfor pass_num in range(len(album_counts)):\\n    swapped = False\\n    for i in range(len(album_counts) - 1):\\n        if album_counts[i] < album_counts[i + 1]:\\n            album_temp = album_counts[i]\\n            album_counts[i] = album_counts[i + 1]\\n            album_counts[i + 1] = album_temp\\n            # the album counts swapped above - now swap the matching artists with a temporary variable\\n            # then set swapped to True so the early-stop check below can work\\n    if swapped == False:\\n        break\\n\\nfor i in range(len(artists)):\\n    print(artists[i], album_counts[i])\\n","expectedOutput":"Burna Boy 7\\nDua Lipa 5\\nStormzy 3\\nRaye 1","checks":["The comparison moves higher album counts left.","Both album counts and artists are swapped using temporary variables.","The artist swap is indented inside the if, like the album-count swap.","swapped is set to True inside the if, after the swaps.","The highest album count belongs to Burna Boy.","The full output is exactly the sorted artist list."],"hints":["Use print(artists, album_counts) after a swap to check they stay matched.","When album_counts swap, artists must swap on the same indented line level.","Remove any test print() lines before the final check."],"teacherSolution":"# Gold 1 - bubble sort matching lists\\nartists = [\\"Stormzy\\", \\"Raye\\", \\"Dua Lipa\\", \\"Burna Boy\\"]\\nalbum_counts = [3, 1, 5, 7]\\n\\nfor pass_num in range(len(album_counts)):\\n    swapped = False\\n    for i in range(len(album_counts) - 1):\\n        if album_counts[i] < album_counts[i + 1]:\\n            album_temp = album_counts[i]\\n            album_counts[i] = album_counts[i + 1]\\n            album_counts[i + 1] = album_temp\\n            artist_temp = artists[i]\\n            artists[i] = artists[i + 1]\\n            artists[i + 1] = artist_temp\\n            swapped = True\\n    if swapped == False:\\n        break\\n\\nfor i in range(len(artists)):\\n    print(artists[i], album_counts[i])\\n"},{"id":"gold-insertion-plays","level":"Gold","levelNumber":3,"challengeNumber":6,"algorithm":"Insertion sort","title":"Insert play counts","illustration":"bubble-sort","animalContext":"Sort track play counts (in millions) into ascending order with an insertion sort. Each pass picks up the next track as current, slides bigger counts one place right, then drops current into the gap.","learningGoal":"Fix an insertion sort so larger items shift right and the current item is inserted into the gap.","sourceType":"hybrid","sourceLabel":"OCR style","sourceReference":"Insertion sort: shift larger items right, then insert the current item.","fixCount":7,"instructions":["The for loop picks up each value from position 1 onwards as current - it is written for you.","Fix the while condition so values bigger than current shift right: plays[position - 1] > current.","After the while loop (lined up with the word while, not inside it), insert current into the gap with plays[position] = current.","Do not use sort() or sorted()."],"starterCode":"# Gold 2 - insertion sort\\nplays = [42, 17, 58, 23, 9]\\n\\nfor i in range(1, len(plays)):\\n    current = plays[i]\\n    position = i\\n    # Slide values on the left one place right to open a gap for current\\n    while position > 0 and plays[position - 1] < current:\\n        plays[position] = plays[position - 1]\\n        position = position - 1\\n    # Bug to fix: current is never put back into the gap\\n\\nprint(\\"Sorted plays:\\", plays)\\n","expectedOutput":"Sorted plays: [9, 17, 23, 42, 58]","checks":["The for loop starts at position 1.","The while loop shifts values bigger than current.","Each shift copies the left value right and moves position down by 1.","current is inserted with plays[position] = current after the while loop.","The code does not use sort() or sorted().","The program prints the plays list.","The output is exactly the ascending list."],"hints":["Use print(i, plays) as the last line inside the for loop to watch the sorted part grow.","Bigger values slide right; the while loop stops at a smaller value or at position 0.","plays[position] = current runs once per pass, so it goes after the while loop, not inside it.","Remove any test print() lines before the final check."],"teacherSolution":"# Gold 2 - insertion sort\\nplays = [42, 17, 58, 23, 9]\\n\\nfor i in range(1, len(plays)):\\n    current = plays[i]\\n    position = i\\n    while position > 0 and plays[position - 1] > current:\\n        plays[position] = plays[position - 1]\\n        position = position - 1\\n    plays[position] = current\\n\\nprint(\\"Sorted plays:\\", plays)\\n"},{"id":"gold-binary-write-function","level":"Gold","levelNumber":3,"challengeNumber":7,"algorithm":"Binary search","title":"Write binary_search","illustration":"function","animalContext":"The artist list is already alphabetical. Write a reusable binary search function to find Taylor Swift.","learningGoal":"Implement binary search as a function that returns the index or -1.","sourceType":"real","sourceLabel":"Lesson data","sourceReference":"Artist-name sorting card context.","fixCount":7,"instructions":["The low/high setup and the final return -1 are written for you.","Follow the numbered recipe to write the while loop and the three branches.","Return mid when items[mid] equals target."],"starterCode":"# Gold 3 - write a binary search function\\nartists = [\\"Burna Boy\\", \\"Dave\\", \\"Dua Lipa\\", \\"Raye\\", \\"Stormzy\\", \\"Taylor Swift\\", \\"The Weeknd\\"]\\ntarget = \\"Taylor Swift\\"\\n\\ndef binary_search(items, target):\\n    low = 0\\n    high = len(items) - 1\\n    # WHILE low is less than or equal to high. Each time round the loop:\\n    #   middle position is (low plus high) divided by 2 (whole number, rounded down)\\n    #   1. IF items[mid] is the target, return mid back as the answer\\n    #   2. ELIF items[mid] is too small, low becomes mid + 1\\n    #   3. ELSE items[mid] is too big, high becomes mid - 1\\n    return -1\\n\\nresult = binary_search(artists, target)\\nprint(target, \\"found at\\", result)\\n","expectedOutput":"Taylor Swift found at 5","checks":["The function is named binary_search and takes items and target.","The search loop continues while low <= high.","The midpoint is calculated from low and high.","The too-low branch moves low to mid + 1.","The too-high branch moves high to mid - 1.","The function returns mid when the target is found.","The output is exactly Taylor Swift found at 5."],"hints":["Use print(low, high, mid, items[mid]) inside the while loop to trace each half-search.","Strings in a sorted list can be compared with < just like numbers.","Return -1 after the loop, not inside the loop."],"teacherSolution":"# Gold 3 - write a binary search function\\nartists = [\\"Burna Boy\\", \\"Dave\\", \\"Dua Lipa\\", \\"Raye\\", \\"Stormzy\\", \\"Taylor Swift\\", \\"The Weeknd\\"]\\ntarget = \\"Taylor Swift\\"\\n\\ndef binary_search(items, target):\\n    low = 0\\n    high = len(items) - 1\\n    while low <= high:\\n        mid = (low + high) // 2\\n        if items[mid] == target:\\n            return mid\\n        elif items[mid] < target:\\n            low = mid + 1\\n        else:\\n            high = mid - 1\\n    return -1\\n\\nresult = binary_search(artists, target)\\nprint(target, \\"found at\\", result)\\n"},{"id":"diamond-merge-pairs","level":"Diamond","levelNumber":4,"challengeNumber":8,"algorithm":"Merge sort","title":"Merge album-count pairs","illustration":"merge-sort","animalContext":"A merge sort has split album counts down to single items. Fix the first merge step so each pair is in ascending order.","learningGoal":"Apply the merge step by comparing two one-item lists at a time.","sourceType":"real","sourceLabel":"OCR anchor","sourceReference":"OCR merge sort exam tasks: split to single items, then merge ordered lists.","fixCount":6,"instructions":["Keep the loop stepping through singletons two at a time.","Append the smaller value before the larger value.","Do not use sort() or sorted()."],"starterCode":"# Diamond 1 - merge sort first merge step\\nsingletons = [[7], [2], [10], [3], [5], [1], [9], [4]]\\npairs = []\\n\\nfor i in range(0, len(singletons), 2):\\n    left = singletons[i][0]\\n    right = singletons[i + 1][0]\\n    # Bug to fix: each pair should list the smaller number first - check both append lines.\\n    if left < right:\\n        pairs.append([right, left])\\n    else:\\n        pairs.append([left, right])\\n\\nprint(\\"Pairs:\\", pairs)\\n","expectedOutput":"Pairs: [[2, 7], [3, 10], [1, 5], [4, 9]]","checks":["The loop processes singletons in steps of 2.","The code compares left with right.","When left is smaller, [left, right] is appended.","When right is smaller, [right, left] is appended.","The code does not use sort() or sorted().","The output is exactly the ascending pairs."],"hints":["Use print(left, right) inside the loop to see the pair being merged.","For each pair, append the smaller number first.","Remove any test print() lines before the final check."],"teacherSolution":"# Diamond 1 - merge sort first merge step\\nsingletons = [[7], [2], [10], [3], [5], [1], [9], [4]]\\npairs = []\\n\\nfor i in range(0, len(singletons), 2):\\n    left = singletons[i][0]\\n    right = singletons[i + 1][0]\\n    if left < right:\\n        pairs.append([left, right])\\n    else:\\n        pairs.append([right, left])\\n\\nprint(\\"Pairs:\\", pairs)\\n"},{"id":"diamond-merge-sort-fix","level":"Diamond","levelNumber":4,"challengeNumber":9,"algorithm":"Merge sort","title":"Fix merge sort order","illustration":"merge-sort","animalContext":"The recursive merge sort structure is already written, but the merge comparison is building a descending album-count list. Fix it for ascending order.","learningGoal":"Repair the merge comparison inside a full merge sort.","sourceType":"hybrid","sourceLabel":"OCR style","sourceReference":"Based on OCR merge sort trace questions, converted into runnable Python.","fixCount":6,"instructions":["Keep the recursive split and merge structure.","Fix the comparison inside merge().","Do not replace the algorithm with sort() or sorted()."],"starterCode":"# Diamond 2 - fix full merge sort\\nalbum_counts = [7, 2, 10, 3, 5, 1, 9, 4]\\n\\ndef merge(left, right):\\n    result = []\\n    i = 0\\n    j = 0\\n    while i < len(left) and j < len(right):\\n        # Bug to fix: for ascending order, the smaller front value should be added first.\\n        if left[i] > right[j]:\\n            result.append(left[i])\\n            i = i + 1\\n        else:\\n            result.append(right[j])\\n            j = j + 1\\n    result.extend(left[i:])\\n    result.extend(right[j:])\\n    return result\\n\\ndef merge_sort(items):\\n    if len(items) <= 1:\\n        return items\\n    mid = len(items) // 2\\n    left = merge_sort(items[:mid])\\n    right = merge_sort(items[mid:])\\n    return merge(left, right)\\n\\nprint(\\"Merged:\\", merge_sort(album_counts))\\n","expectedOutput":"Merged: [1, 2, 3, 4, 5, 7, 9, 10]","checks":["The merge(left, right) function remains in place.","The merge_sort(items) function remains in place.","The merge sort still uses recursive calls.","The merge comparison chooses the smaller left value first.","The code does not use sort() or sorted().","The output is exactly the ascending merged list."],"hints":["Use print(left, right, result) inside merge() to trace the merge.","Ascending order means append the smaller front value first.","Remove any test print() lines before the final check."],"teacherSolution":"# Diamond 2 - fix full merge sort\\nalbum_counts = [7, 2, 10, 3, 5, 1, 9, 4]\\n\\ndef merge(left, right):\\n    result = []\\n    i = 0\\n    j = 0\\n    while i < len(left) and j < len(right):\\n        if left[i] < right[j]:\\n            result.append(left[i])\\n            i = i + 1\\n        else:\\n            result.append(right[j])\\n            j = j + 1\\n    result.extend(left[i:])\\n    result.extend(right[j:])\\n    return result\\n\\ndef merge_sort(items):\\n    if len(items) <= 1:\\n        return items\\n    mid = len(items) // 2\\n    left = merge_sort(items[:mid])\\n    right = merge_sort(items[mid:])\\n    return merge(left, right)\\n\\nprint(\\"Merged:\\", merge_sort(album_counts))\\n"},{"id":"platinum-sort-then-binary","level":"Platinum","levelNumber":5,"challengeNumber":10,"algorithm":"Bubble sort + binary search","title":"Sort IDs then search","illustration":"sort-then-search","animalContext":"Artist IDs arrive unsorted. The bubble sort and its matching album_counts swaps are done for you - your job is to make the binary search find the album count for ID 107.","learningGoal":"Fix the direction of a binary search that reads a matching value from a sorted list.","sourceType":"hybrid","sourceLabel":"Lesson style","sourceReference":"Artist-ID and album-count sorting cards combined.","fixCount":4,"instructions":["The bubble sort and its temporary-variable swaps are written for you.","The binary search is written too, but it moves the wrong way.","Fix the two branches: too low should move low up to mid + 1, too high should move high down to mid - 1."],"starterCode":"# Platinum 1 - sort first, then binary search\\nartist_ids = [111, 101, 107, 103]\\nalbum_counts = [10, 3, 5, 7]\\n\\n# Bubble sort the IDs, swapping album_counts to match (done for you).\\nfor pass_num in range(len(artist_ids)):\\n    for i in range(len(artist_ids) - 1):\\n        if artist_ids[i] > artist_ids[i + 1]:\\n            id_temp = artist_ids[i]\\n            artist_ids[i] = artist_ids[i + 1]\\n            artist_ids[i + 1] = id_temp\\n            album_temp = album_counts[i]\\n            album_counts[i] = album_counts[i + 1]\\n            album_counts[i + 1] = album_temp\\n\\ntarget = 107\\nlow = 0\\nhigh = len(artist_ids) - 1\\nfound_albums = \\"not found\\"\\n\\n# Bug to fix: the search moves the wrong way. Too low means the target is in the\\n# right half (move low up); too high means it is in the left half (move high down).\\nwhile low <= high:\\n    mid = (low + high) // 2\\n    if artist_ids[mid] == target:\\n        found_albums = album_counts[mid]\\n        break\\n    elif artist_ids[mid] < target:\\n        high = mid - 1\\n    else:\\n        low = mid + 1\\n\\nprint(\\"ID\\", target, \\"albums:\\", found_albums)\\n","expectedOutput":"ID 107 albums: 5","checks":["The binary search checks artist_ids[mid] against target.","The too-low branch moves low to mid + 1.","The too-high branch moves high to mid - 1.","The output is exactly ID 107 albums: 5."],"hints":["Use print(artist_ids, album_counts) after swaps to check the matching data.","Use print(low, high, mid, artist_ids[mid]) inside the while loop to trace the search.","Remove any test print() lines before the final check."],"teacherSolution":"# Platinum 1 - sort first, then binary search\\nartist_ids = [111, 101, 107, 103]\\nalbum_counts = [10, 3, 5, 7]\\n\\n# Bubble sort the IDs, swapping album_counts to match (done for you).\\nfor pass_num in range(len(artist_ids)):\\n    for i in range(len(artist_ids) - 1):\\n        if artist_ids[i] > artist_ids[i + 1]:\\n            id_temp = artist_ids[i]\\n            artist_ids[i] = artist_ids[i + 1]\\n            artist_ids[i + 1] = id_temp\\n            album_temp = album_counts[i]\\n            album_counts[i] = album_counts[i + 1]\\n            album_counts[i + 1] = album_temp\\n\\ntarget = 107\\nlow = 0\\nhigh = len(artist_ids) - 1\\nfound_albums = \\"not found\\"\\n\\nwhile low <= high:\\n    mid = (low + high) // 2\\n    if artist_ids[mid] == target:\\n        found_albums = album_counts[mid]\\n        break\\n    elif artist_ids[mid] < target:\\n        low = mid + 1\\n    else:\\n        high = mid - 1\\n\\nprint(\\"ID\\", target, \\"albums:\\", found_albums)\\n"},{"id":"platinum-merge-sort-write","level":"Platinum","levelNumber":5,"challengeNumber":11,"algorithm":"Merge sort","title":"Write merge_sort","illustration":"function","animalContext":"Write a merge sort from scratch for a short list of Spotify album counts.","learningGoal":"Implement merge sort without using Python's built-in sort helpers.","sourceType":"made-up","sourceLabel":"Lesson style","sourceReference":"Created for this Year 10 lane from the lesson success criteria.","fixCount":7,"instructions":["The recursive split (base case, mid, left, right) is written for you.","Follow the pseudocode recipe to merge left and right - use result.append() to add each value.","Do not use sort() or sorted()."],"starterCode":"# Platinum 2 - write merge sort\\nalbum_counts = [2, 7, 3, 1, 10, 6, 5, 4]\\n\\ndef merge_sort(items):\\n    if len(items) <= 1:\\n        return items\\n    mid = len(items) // 2\\n    left = merge_sort(items[:mid])\\n    right = merge_sort(items[mid:])\\n\\n    result = []\\n    i = 0\\n    j = 0\\n    # Merge left and right into result. In pseudocode:\\n    #   WHILE i < length(left) AND j < length(right):\\n    #     IF left[i] < right[j]:\\n    #       add left[i] to the end of result using the append method, then i = i + 1\\n    #     ELSE:\\n    #       add right[j] to the end of result using the append method, then j = j + 1\\n    #   After the loop, add any leftover items: the rest of left, then the rest of right.\\n    return result\\n\\nresult = merge_sort(album_counts)\\nprint(\\"Sorted:\\", result)\\n","expectedOutput":"Sorted: [1, 2, 3, 4, 5, 6, 7, 10]","checks":["A merge_sort function is defined.","The function calls merge_sort recursively.","The merge loop runs while i < len(left) and j < len(right).","The merge appends left[i] and right[j] to result.","The code does not use sort() or sorted().","The program prints the result returned by merge_sort.","The output is exactly the sorted list."],"hints":["Use print(left, right) after the recursive calls to see each split.","Use print(result) inside the merge loop to see the sorted list being built.","Remove any test print() lines before the final check."],"teacherSolution":"# Platinum 2 - write merge sort\\nalbum_counts = [2, 7, 3, 1, 10, 6, 5, 4]\\n\\ndef merge_sort(items):\\n    if len(items) <= 1:\\n        return items\\n    mid = len(items) // 2\\n    left = merge_sort(items[:mid])\\n    right = merge_sort(items[mid:])\\n    result = []\\n    i = 0\\n    j = 0\\n    while i < len(left) and j < len(right):\\n        if left[i] < right[j]:\\n            result.append(left[i])\\n            i = i + 1\\n        else:\\n            result.append(right[j])\\n            j = j + 1\\n    result.extend(left[i:])\\n    result.extend(right[j:])\\n    return result\\n\\nresult = merge_sort(album_counts)\\nprint(\\"Sorted:\\", result)\\n"}]`);export{e as default};
