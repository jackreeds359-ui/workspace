.squeeze-depot{background:repeating-linear-gradient(-45deg,transparent 0 14px,rgba(251,191,36,.025) 14px 28px),radial-gradient(ellipse at top,#172033,#0b1120 70%)}.squeeze-depot .squeeze-gauge-fill{transition:width .35s cubic-bezier(.4,0,.2,1)}.squeeze-depot .squeeze-stamp{position:absolute;left:50%;top:50%;padding:4px 14px;border:4px double currentColor;border-radius:6px;background:#0f172ac7;font-family:ui-monospace,Courier New,monospace;font-size:clamp(.9rem,3.4vw,1.35rem);font-weight:800;letter-spacing:.14em;white-space:nowrap;transform:translate(-50%,-50%) rotate(-10deg);animation:squeeze-stamp-slam .45s cubic-bezier(.4,0,.2,1);pointer-events:none}.squeeze-depot .squeeze-stamp-good{color:#6ee7b7}.squeeze-depot .squeeze-stamp-bad{color:#fda4af}@keyframes squeeze-stamp-slam{0%{opacity:0;transform:translate(-50%,-50%) rotate(-28deg) scale(2.6)}65%{opacity:1;transform:translate(-50%,-50%) rotate(-8deg) scale(.92)}to{transform:translate(-50%,-50%) rotate(-10deg) scale(1)}}.squeeze-depot .squeeze-slider{accent-color:#fbbf24;height:1.75rem;cursor:pointer}.squeeze-depot .squeeze-slider:focus-visible{outline:2px solid #5eead4;outline-offset:2px;border-radius:4px}@media(prefers-reduced-motion:reduce){.squeeze-depot .squeeze-stamp{animation:none}.squeeze-depot .squeeze-gauge-fill{transition:none}}html[data-reduce-motion=true] .squeeze-depot .squeeze-stamp{animation:none}html[data-reduce-motion=true] .squeeze-depot .squeeze-gauge-fill{transition:none}
