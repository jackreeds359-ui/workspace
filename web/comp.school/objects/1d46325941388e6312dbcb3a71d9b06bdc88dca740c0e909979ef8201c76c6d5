.secret-agents{background:radial-gradient(ellipse at top left,rgba(45,212,191,.08),transparent 55%),linear-gradient(180deg,#0b1220,#050912);position:relative;isolation:isolate}.secret-agents:before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;background-image:linear-gradient(rgba(148,163,184,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.05) 1px,transparent 1px);background-size:24px 24px;pointer-events:none}.secret-agents .font-typewriter{font-family:Special Elite,Courier New,monospace}.secret-agents .agents-stamp{display:inline-block;padding:4px 14px;border:3px double currentColor;font-family:Special Elite,Courier New,monospace;font-weight:700;letter-spacing:.18em;transform:rotate(-4deg)}.secret-agents .agents-photo{position:relative;padding:8px;border-radius:6px;background:#020617;box-shadow:0 0 0 1px #94a3b840,0 10px 24px #00000073}.secret-agents .agents-photo:before,.secret-agents .agents-photo:after{content:"";position:absolute;width:16px;height:16px;border:2px solid #2dd4bf;pointer-events:none}.secret-agents .agents-photo:before{top:3px;left:3px;border-right:0;border-bottom:0}.secret-agents .agents-photo:after{right:3px;bottom:3px;border-left:0;border-top:0}.secret-agents .agents-photo svg{display:block;width:100%;height:auto;border-radius:3px}.secret-agents .agents-rec{animation:agents-blink 1.4s steps(2,start) infinite}.secret-agents .agents-blink{animation:agents-blink 1.6s ease-in-out infinite}.secret-agents .agents-steam{animation:agents-steam 3s ease-in-out infinite}.secret-agents .agents-codebook{background:linear-gradient(180deg,#fef3c7,#fde68a);color:#1c1917;box-shadow:0 4px 12px #00000059;transform:rotate(-.6deg)}.secret-agents .agents-bit{width:1.75rem;height:2.25rem;border-radius:.4rem;border:1px solid #334155;background:#0f172a;color:#64748b;font-family:ui-monospace,DejaVu Sans Mono,monospace;font-weight:700;transition:background-color .12s,color .12s,box-shadow .12s}.secret-agents .agents-bit[aria-press