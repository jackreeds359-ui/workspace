import{j as e,r as W}from"./react-vendor-BK1G6oO1.js";import{aq as ti,aT as ii}from"./GameNotebook-b0Qw2wzd.js";import{T as Ct}from"./action-styles-DWMwPIR0.js";import{I as si}from"./immersive-picker-PA4Q0OWd.js";import{d as ri,K as li}from"./keyword-deck-Bo8inXG8.js";import{u as ue}from"./keyword-flashcards-Ha6Msavb.js";import{O as ai,Q as ci,V as hi,z as oi,U as ni,H as di,W as xi,Y as fi,Z as ji,v as yi}from"./ui-components-DeMDYLzO.js";import{m as me}from"./proxy-DGk2Wawc.js";import"./index-DjyiOHey.js";import"./use-cover-art-CyGvgy9q.js";const B=[{id:"pen_testers",name:"Penetration Testing",cost:2e5},{id:"anti_malware",name:"Anti-Malware Software",cost:1e5},{id:"firewall",name:"Firewall",cost:15e4},{id:"user_access",name:"User Access Levels",cost:5e4},{id:"password_policy",name:"Strong Password Policy",cost:5e4},{id:"account_lockout",name:"Account Lockout",cost:5e4},{id:"two_factor",name:"Two-Factor Authentication",cost:1e5},{id:"encryption",name:"Encryption",cost:1e5},{id:"physical_security",name:"Physical Security",cost:1e5},{id:"staff_training",name:"Staff Training",cost:1e5},{id:"input_validation",name:"Input Validation",cost:1e5}],pi={pen_testers:["1.4","Penetration Testing"],anti_malware:["1.4","Anti-Malware Software"],firewall:["1.4","Firewall"],user_access:["1.4","User Access Levels"],password_policy:["1.4","Passwords"],account_lockout:["1.4","Account Lockout"],two_factor:["1.4","Two-Factor Authentication"],encryption:["1.4","Encryption"],physical_security:["1.4","Physical Security"],staff_training:["1.4","Staff Training"],input_validation:["2.3","Input Validation"]},O="Phishing is social engineering: it attacks people, not machines. Staff training stops it, because staff learn to check sender addresses, spot pressure tactics and hover over links before clicking. Two-factor authentication also stops it, because a stolen password is useless without the code sent to the real owner's phone. User access levels cannot stop the trick, but they limit how much a stolen account can reach.",Q="A brute-force attack tries password after password until one works. Three defences stop it: a strong password policy makes the right answer take far too long to guess, account lockout stops the guessing after a few wrong attempts, and two-factor authentication means even a guessed password is not enough. A firewall can block traffic from the attacking addresses, but bots simply switch to new ones.",U="SQL injection hides database commands inside a form field. If the website does not check what is typed, the database runs the attacker's code. Input validation stops it by rejecting anything that is not a normal answer. Penetration testing stops it too, by finding the weakness so it can be fixed before criminals do. User access levels limit the damage, because the website's database account can only reach the tables it needs.",Z="Blagging is social engineering where the attacker invents a story and piles on pressure until someone hands over access. Staff training stops it: staff learn to slow down, check who is calling using details already on file, and never change accounts or share passwords over the phone. Technical defences cannot help when a person willingly gives access away.",Y="A denial of service attack does not steal data: it floods a server with so much traffic that real users cannot get through. A firewall inspects incoming traffic against rules, so it can block the attacking sources and limit how many requests reach the server. Anti-malware, passwords and encryption do not help, because nothing is installed, nobody logs in and no data is taken.",G="Data interception means capturing data as it travels across a network, often with packet-sniffing software. You cannot stop someone capturing signals, but encryption makes what they capture useless: the data is scrambled with a key and cannot be read without it. A firewall checks what enters and leaves your network, but it cannot stop someone listening along the route.",K="Shouldering, or shoulder surfing, is social engineering where someone simply watches a person type a password or PIN, in person or through a camera. Staff training stops it: staff learn to shield the keyboard, check who is nearby and never log in where they can be overlooked. Two-factor authentication also stops it, because a password seen over a shoulder is useless without the code sent to the owner's phone. User access levels cannot stop the login, but they limit how much a stolen account can reach.",gi=[{id:"police_ransomware",name:"999 Ransomware",attackType:"Malware",scenario:"At 2am a call handler opens an attachment called 'Shift rota.xls'. Hidden inside is ransomware. Within minutes every screen in the 999 control room locks: 'Your dispatch system is encrypted. Pay £3 million in Bitcoin.' Emergency calls are queuing and no one can see where the patrol cars are.",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software recognised the ransomware inside the attachment and quarantined it before it could run. The control room never noticed and every 999 call was answered.",outcomePartial:"The ransomware ran, but it only had the call handler's access level. It encrypted one desk's files and could not reach the dispatch servers, so the control room switched desks and kept going.",outcomeVulnerable:"The ransomware spread to every dispatch server. For six hours officers were sent out by pen, paper and radio, response times tripled and the force faced a choice between paying criminals or rebuilding everything.",learning:"Ransomware is malware that encrypts your files and demands payment. Anti-malware software stops it by checking files against known malware signatures and watching for suspicious behaviour, then quarantining anything dangerous before it runs. User access levels limit the damage, because malware can only reach what the infected account can reach.",consequence:"999 dispatch down for 6 hours · £3m ransom demand · Lives put at risk"},{id:"police_interception",name:"Bodycam Interception",attackType:"Data Interception and Theft",scenario:"An organised crime gang parks a van near a busy police station. Inside, a laptop running packet-sniffing software captures the bodycam footage and radio messages that officers send back over public mobile networks, including names of witnesses and the time of a planned raid.",protectedBy:["encryption"],alsoHelpedBy:[],outcomeProtected:"The gang captured thousands of packets, but every one was encrypted. Without the key they had scrambled nonsense, and the raid went ahead as planned.",outcomePartial:"Some of the data was protected, but the gang still read a batch of messages.",outcomeVulnerable:"Everything travelled as plain data. The gang read witnesses' names and the raid time, cleared out before officers arrived and the witnesses had to be moved into protection.",learning:G,consequence:"Raid tipped off · Witnesses in danger · Case collapses"},{id:"police_evidence_theft",name:"Evidence Store Break-in",attackType:"Data Theft",scenario:"A stranger in a delivery uniform follows an officer through the station's back door, walks into the evidence store and leaves with a laptop. On it: the real names of the force's secret informants.",protectedBy:["physical_security"],alsoHelpedBy:["encryption"],outcomeProtected:"The evidence store needed a keycard, the door alarm sounded when it was forced and CCTV caught everything. The intruder was arrested in the car park.",outcomePartial:"The intruder escaped with the laptop, but its drive was encrypted. The hardware was gone, but the list of informants was unreadable.",outcomeVulnerable:"The laptop walked out of the station and nothing on it was protected. Within days the informants' names were being passed around by the gangs they had reported.",learning:"Not every attack comes over the internet. Physical security, such as locks, keycards, alarms and CCTV, stops people getting their hands on the hardware at all. Encryption is the backup plan: if a device is stolen anyway, the data on it cannot be read without the key.",consequence:"Informants exposed · Lives at risk · Public trust shattered"},{id:"police_shouldering",name:"Custody Desk Shoulder Surf",attackType:"Social Engineering",scenario:"A man waiting at the custody desk leans on the counter and watches a sergeant type a password into the intelligence database. He films it on his phone, slowly, key by key. That night a stranger tries to log in from outside the station.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained sergeant angled the screen away, shielded the keyboard and reported the man for filming, or the filmed password was useless without the code sent to the sergeant's phone. The stranger never got into the database.",outcomePartial:"He filmed the whole password and the stranger logged in, but user access levels meant the sergeant's account could only search the custody records for that station. He saw who had been arrested that week, not the force's surveillance targets.",outcomeVulnerable:"He filmed the whole password and nothing else was needed. The stranger logged into the intelligence database and downloaded a list of addresses under police watch.",learning:K,consequence:"Intelligence database breached · Surveillance targets warned · Operations blown"},{id:"police_ddos",name:"Manhunt Appeal DDoS",attackType:"Denial of Service",scenario:"A dangerous prisoner has escaped and the force's website is running an urgent public appeal with his photo. Within an hour a botnet of hijacked computers floods the site with millions of fake requests, and tip-offs from the public stop arriving.",protectedBy:["firewall"],alsoHelpedBy:[],outcomeProtected:"Your firewall recognised the flood from the botnet and its rules blocked those sources. The appeal stayed online, a dog walker sent in a sighting and the prisoner was caught by morning.",outcomePartial:"Some of the flood was filtered, but the appeal page was down for an hour.",outcomeVulnerable:"The website collapsed for the whole evening. Sightings went unreported, the prisoner slipped across the county border and the manhunt took another week.",learning:Y,consequence:"Appeal offline · Sightings lost · Escaped prisoner still at large"},{id:"police_phishing",name:"Overtime Claim Phish",attackType:"Social Engineering",scenario:"Officers coming off a night shift get an email from 'Northgate Payroll': 'Your overtime claim has been rejected. Log in and resubmit before midnight or it will not be paid.' The link opens a perfect copy of the force login page on a lookalike web address.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your officers spotted the lookalike address and reported the email, or the stolen passwords were useless without the code sent to each officer's phone. The attackers never got past the login page.",outcomePartial:"Thirty officers gave away their passwords and the attackers logged in, but user access levels meant each account could only open that officer's own cases, not the force's crime records.",outcomeVulnerable:"Thirty officers gave away their passwords and their accounts could search everything. The attackers downloaded years of crime reports, including the names and addresses of victims and witnesses.",learning:O,consequence:"Officer accounts stolen · Crime reports downloaded · Victims exposed"},{id:"police_brute_force",name:"Officer Email Brute Force",attackType:"Brute-Force",scenario:"A gang copies the names of 200 officers from the 'Meet your local team' pages on the force website. Their bots then hammer the force email login with every name, trying thousands of passwords a minute: 'Northgate1', 'Police2026', 'Bobby123'.",protectedBy:["password_policy","account_lockout","two_factor"],alsoHelpedBy:["firewall"],outcomeProtected:"The bots got nowhere: the passwords were too long to guess, each account locked after a few wrong tries, or a second code was needed. Not one officer inbox was opened.",outcomePartial:"Your firewall blocked the busiest attacking addresses, but the bots switched to new ones and cracked three officers' weak passwords before IT noticed the strange logins.",outcomeVulnerable:"The bots cracked sixty weak passwords overnight. The gang read officers' emails about planned raids and used their accounts to send convincing fake messages to other forces.",learning:Q,consequence:"60 inboxes cracked · Raid plans read · Fake emails sent to other forces"},{id:"police_sql_injection",name:"Crime Tracker SQL Injection",attackType:"SQL Injection",scenario:"Victims of crime can check the progress of their case on the force website by typing in a report reference. An attacker types ' OR 1=1; -- into the box instead. If the page passes it straight to the database, it will send back every crime report the force holds.",protectedBy:["input_validation","pen_testers"],alsoHelpedBy:["user_access"],outcomeProtected:"The tracker rejected the code, either because it checks every reference matches the pattern NG followed by eight digits, or because your penetration testers had already found and fixed the hole. The attacker got an error message.",outcomePartial:"The injection worked, but the tracker's database account could only read the case status table. The attacker got a list of report numbers and progress updates, not victims' names or statements.",outcomeVulnerable:"The database handed over 300,000 crime reports, complete with victims' names, phone numbers, home addresses and statements. Some victims were contacted by the very people they had reported.",learning:U,consequence:"300,000 crime reports leaked · Victims contacted · ICO investigation"},{id:"police_blagging",name:"Fake Detective Blag",attackType:"Social Engineering",scenario:"The control room takes a call from a withheld number. 'DS Hughes, Westshire CID. A child is missing and I think she is with her mum. I need the address you hold for her right now.' The address is protected because the mum moved to escape the caller.",protectedBy:["staff_training"],alsoHelpedBy:[],outcomeProtected:"Your trained call handler said she would ring Westshire back through their main switchboard. Westshire had no DS Hughes and no missing child, and the call was traced to the man the mum had fled.",outcomePartial:"The call handler refused to give the address, but confirmed which town the mum now lives in.",outcomeVulnerable:"Under pressure, the call handler read out the address. The caller turned up that night, and the mum and her daughter had to be moved to emergency housing in another county.",learning:Z,consequence:"Protected address given away · Family in danger · Emergency rehousing"},{id:"police_spyware",name:"CCTV Player Spyware",attackType:"Malware",scenario:"A shopkeeper emails a detective some CCTV footage of a robbery, but it will not open. The detective downloads a 'free CCTV player' from a forum. Hidden inside is spyware, malware that secretly records every key pressed and screen opened, and sends it all to a gang.",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software scanned the download, recognised the spyware and quarantined it before it could install. The detective got a safe player from IT and watched the footage that afternoon.",outcomePartial:"The spyware ran for a fortnight, but the detective's account could only open their own team's robbery cases. The gang learned about a few burglaries, not the force's undercover work.",outcomeVulnerable:"The spyware ran for three months on a laptop that could open every case in the force. The gang read the real names of undercover officers and the plans for Operation Kestrel.",learning:"Spyware is malware that secretly records what you do, such as keys pressed and screens opened, and sends it to the attacker. Anti-malware software stops it by scanning downloads and quarantining anything that matches known malware or behaves suspiciously. User access levels limit the damage, because spyware can only see what the infected account can open.",consequence:"Undercover officers exposed · Operation abandoned · Gang tipped off"}],bi=[{id:"hospital_worm",name:"Hospital Worm",attackType:"Malware",scenario:"A worm, malware that copies itself from computer to computer with no one clicking anything, gets onto one old PC in radiology. By lunchtime it is spreading across the hospital network towards the MRI scanners, theatre computers and A&E.",protectedBy:["anti_malware"],alsoHelpedBy:["firewall"],outcomeProtected:"Your anti-malware software spotted the worm on the first PC and quarantined it before it could copy itself anywhere else. Operations went ahead as normal.",outcomePartial:"Firewall rules between the hospital departments stopped the worm crossing into theatres and A&E, but radiology was down for a day and scans had to be rebooked.",outcomeVulnerable:"The worm spread to every department. Scanners went dark, 300 operations were cancelled and ambulances were diverted to other hospitals for two days.",learning:"A worm is malware that spreads across a network on its own. Anti-malware software stops it by recognising it and quarantining it before it can copy itself. A firewall helps contain it by blocking the traffic it uses to jump between parts of the network, but it does not remove it.",consequence:"300 operations cancelled · Ambulances diverted · Patients at risk"},{id:"hospital_phishing",name:"Phishing the Doctors",attackType:"Social Engineering",scenario:"Doctors get an urgent email: 'Your patient records login expires today. Verify now or lose access.' The link leads to a convincing fake hospital login page. Busy doctors between patients have seconds to decide whether to type in their passwords.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your staff spotted the fake web address and reported it, or the stolen passwords were useless without the code sent to each doctor's phone. The attackers never got into a single patient record.",outcomePartial:"Twelve doctors gave away their passwords and the attackers logged in, but user access levels meant each account could only see that doctor's own patients, not the whole hospital.",outcomeVulnerable:"Twelve doctors gave away their passwords and their accounts could open everything. The attackers copied 400,000 patients' medical records and threatened to publish them.",learning:O,consequence:"400,000 medical records stolen · Patients blackmailed · Huge fine"},{id:"hospital_brute_force",name:"Portal Brute Force",attackType:"Brute-Force",scenario:"Consultants log in from home through a remote-access portal. Overnight, bots start hammering it with thousands of password guesses a minute: 'password1', 'nhs2024', 'doctor!', pets' names, football teams.",protectedBy:["password_policy","account_lockout","two_factor"],alsoHelpedBy:["firewall"],outcomeProtected:"The bots got nowhere: long passwords, locked accounts after a few wrong guesses, or a second code they could never receive. Not one consultant account was cracked.",outcomePartial:"Your firewall blocked the busiest attacking addresses, but the bots switched to new ones and cracked two consultants with weak passwords before IT noticed.",outcomeVulnerable:"The bots cracked forty weak passwords overnight and walked straight into the hospital network with consultant-level access.",learning:Q,consequence:"Consultant accounts hijacked · Network breached · Records exposed"},{id:"hospital_sql_injection",name:"Prescription SQL Injection",attackType:"SQL Injection",scenario:"On the hospital's online repeat-prescription form, an attacker types ' OR 1=1; -- into the NHS number box. If the form passes it straight to the database, the database will send back every patient's medicines and home address.",protectedBy:["input_validation","pen_testers"],alsoHelpedBy:["user_access"],outcomeProtected:"The form rejected the code, either because it checks every NHS number is ten digits or because your penetration testers had already found and fixed the weakness. The attacker got an error message and nothing else.",outcomePartial:"The injection worked, but the form's database account could only read the prescriptions table, not full medical histories. A few thousand medicine lists leaked before the hole was closed.",outcomeVulnerable:"The database handed over 900,000 patients' medicines, conditions and home addresses. People on HIV and cancer drugs were sent blackmail letters within a month.",learning:U,consequence:"900,000 prescriptions stolen · Patients blackmailed · ICO fine"},{id:"hospital_blagging",name:"Fake IT Engineer Blag",attackType:"Social Engineering",scenario:"A night-shift nurse takes a call. 'Hi, it's Dan from the IT service desk. Your ward's drug cabinet system is about to crash. I just need your login to patch it before the 3am medicines round.' There is no Dan.",protectedBy:["staff_training"],alsoHelpedBy:[],outcomeProtected:"Your trained nurse knew IT never asks for passwords, hung up and rang the real service desk on the number on the wall. Dan was reported and the call was traced.",outcomePartial:"The nurse refused to give the password, but did confirm their username and ward.",outcomeVulnerable:"The nurse read out their password. The caller used it to unlock the ward's controlled-drugs records and changed the stock counts to cover a theft of strong painkillers.",learning:Z,consequence:"Controlled drugs stolen · Records falsified · Police investigation"},{id:"hospital_interception",name:"Pager Interception",attackType:"Data Interception and Theft",scenario:"St Elm's doctors still carry pagers, and every message is broadcast by radio across the city. A man a mile away plugs a cheap radio receiver into his laptop and decodes them all: patient names, bed numbers and what is wrong with them.",protectedBy:["encryption"],alsoHelpedBy:[],outcomeProtected:"Every pager message was encrypted before it was broadcast. The man captured thousands of messages of scrambled nonsense and not one patient name.",outcomePartial:"Some pagers were protected, but a batch of messages was readable.",outcomeVulnerable:"Every message went out as plain text. The man posted months of messages online, including famous patients' names and conditions, and journalists were outside the hospital by morning.",learning:G,consequence:"Patient messages published · Famous patients exposed · Data breach fine"},{id:"hospital_ddos",name:"Blood Appeal DDoS",attackType:"Denial of Service",scenario:"A motorway pile-up has sent 38 casualties to St Elm and the blood bank is running out of O-negative, the blood type any patient can be given. The hospital launches an urgent online appeal for donors to book emergency slots. Within minutes a botnet of hijacked computers floods the appeal page with millions of fake requests, and no donor can book.",protectedBy:["firewall"],alsoHelpedBy:[],outcomeProtected:"Your firewall recognised the flood from the botnet and its rules blocked those sources. The appeal stayed online, 300 donors booked slots by teatime and every casualty who needed blood got it.",outcomePartial:"Some of the flood was filtered, but the appeal page was down for two hours while the O-negative supply ran dangerously low.",outcomeVulnerable:"The appeal page was down all night. Not a single donor could book, the O-negative ran out before midnight and surgeons had to wait for emergency blood to be driven in from another region.",learning:Y,consequence:"Appeal offline · No donors booked · O-negative runs out"},{id:"hospital_laptop_theft",name:"Visiting Hours Laptop Theft",attackType:"Data Theft",scenario:"During busy visiting hours, a man carrying flowers wanders down the children's ward, slips into the unlocked staff office and walks out with a laptop. On it is the ward's patient list with every child's name, address and condition.",protectedBy:["physical_security"],alsoHelpedBy:["encryption"],outcomeProtected:"The staff office needed a keycard, so the door would not open. CCTV picked him out trying the handle and security met him at the ward exit.",outcomePartial:"The man escaped with the laptop, but its drive was encrypted. The hospital lost the hardware, but not a single readable patient record.",outcomeVulnerable:"The laptop left the hospital and nothing on it was protected. Parents started getting calls from strangers who knew their child's name and illness.",learning:"Not every attack comes over the internet. Physical security, such as keycard doors, CCTV and security staff, stops people getting their hands on the hardware at all. Encryption is the backup plan: if a laptop is stolen anyway, the data on its drive cannot be read without the key.",consequence:"Children's records stolen · Families targeted · Ward security review"},{id:"hospital_shouldering",name:"Night Ward Shoulder Surf",attackType:"Social Engineering",scenario:"At 3am on a busy A&E ward, a nurse logs into the patient records system on the computer on wheels at the nurses' station. A man wearing a visitor sticker leans on the counter with his phone pointed at her keyboard and records every key she presses. Nobody has asked who he is visiting.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained nurse spotted the phone, turned the computer away and called security, who found he had no patient on the ward, or the recorded password was useless without the code sent to the nurse's phone. Not one record was opened.",outcomePartial:"He recorded the whole password and logged in from home, but user access levels meant the nurse's account could only open patients on her own ward that night. He read a handful of A&E notes before the account was locked, not the footballer's file.",outcomeVulnerable:"He recorded the whole password and nothing else was needed. From home he logged into the patient records system, read the A&E notes of 40 patients and sold the story of a footballer's secret injury to the papers.",learning:K,consequence:"Nurse account misused · 40 patient records read · Story sold to the papers"},{id:"hospital_ransomware",name:"Pathology Lab Ransomware",attackType:"Malware",scenario:"A pop-up on a pathology lab computer says 'Your browser is out of date. Click to update.' A lab technician clicks it. It is ransomware, and the lab system that tracks every blood test locks with a message: 'Pay £4 million or your results are gone for good.'",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software recognised the fake update as ransomware and quarantined it before it ran. The lab kept testing and every result reached the wards on time.",outcomePartial:"The ransomware ran, but the technician's account could only reach one analyser. That machine was offline for a morning while the rest of the lab kept running.",outcomeVulnerable:"The ransomware locked the whole lab system. With no blood test results, 1,000 operations were postponed, blood transfusions were rationed and the lab took a month to recover.",learning:"Ransomware is malware that encrypts your files and demands payment. It often arrives disguised as something harmless, such as a fake software update. Anti-malware software stops it by recognising it from known signatures and suspicious behaviour, then quarantining it before it runs. User access levels limit the damage, because malware can only reach what the infected account can reach.",consequence:"Blood tests stopped · 1,000 operations postponed · £4m ransom demand"}],wi=[{id:"civil_sql_injection",name:"Passport SQL Injection",attackType:"SQL Injection",scenario:"On the online passport application, an attacker types SQL code into the Surname box: ' OR 1=1; --. If the website passes it straight to the database, the database will obey and send back every citizen's passport record.",protectedBy:["input_validation","pen_testers"],alsoHelpedBy:["user_access"],outcomeProtected:"The form rejected the code, either because it checks every input or because your penetration testers found this weakness last year and it was fixed. The attacker got an error message and nothing else.",outcomePartial:"The injection worked, but the application form's database account could only read the applications table, not the passport register. A few hundred half-finished applications leaked before the hole was closed.",outcomeVulnerable:"The database handed over 50 million citizens' names, dates of birth and passport numbers. Every one of them is now at risk of identity fraud.",learning:U,consequence:"50 million passport records stolen · Identity fraud · Questions in Parliament"},{id:"civil_blagging",name:"Minister's Office Blag",attackType:"Social Engineering",scenario:"The help desk phone rings. 'This is the Secretary of State's private secretary. The minister flies to a summit in an hour and the passport record is wrong. Change the details now or I'll have your job.' The caller is not who they say they are.",protectedBy:["staff_training"],alsoHelpedBy:[],outcomeProtected:"Your trained officer stayed calm, refused to change anything over the phone and called the minister's office back on the number on file. The real private secretary had never called.",outcomePartial:"The officer hesitated, but still confirmed some personal details before hanging up.",outcomeVulnerable:"Under pressure, the officer changed the record. A criminal now holds a valid passport in a minister's name, and the story is on every front page.",learning:Z,consequence:"Fake passport issued · National security alert · Front-page scandal"},{id:"civil_ddos",name:"Tax Deadline DDoS",attackType:"Denial of Service",scenario:"It's 11pm on 31 January, the deadline for millions of tax returns. Just as the rush peaks, a botnet of hijacked computers floods the online tax service with millions of fake requests a second.",protectedBy:["firewall"],alsoHelpedBy:[],outcomeProtected:"Your firewall recognised the flood from the botnet and its rules blocked those sources, so real taxpayers could still file before midnight.",outcomePartial:"Some of the flood was filtered, but the service was still down for an hour.",outcomeVulnerable:"The service collapsed for the final hour. Millions missed the deadline, the deadline had to be extended and the government faced a furious public.",learning:Y,consequence:"Tax service down · Millions miss the deadline · Public fury"},{id:"civil_spyware",name:"Benefits Office Spyware",attackType:"Malware",scenario:"A caseworker plugs in a USB stick handed out at a conference. It quietly installs spyware, malware that records every key pressed and every screen opened, and sends it to a server abroad. The caseworker's PC can open benefits claims for the whole North West.",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software scanned the USB stick the moment it was plugged in, recognised the spyware and quarantined it before it could install.",outcomePartial:"The spyware ran for a week, but the caseworker's account could only open their own caseload. A few hundred claims leaked, not the whole region.",outcomeVulnerable:"The spyware ran for three months. It recorded logins, bank details and medical notes from 200,000 benefits claims and sent them all abroad.",learning:"Spyware is malware that secretly records what you do, such as keys pressed and screens opened, and sends it to the attacker. Anti-malware software stops it by scanning files and devices and quarantining anything that matches known malware or behaves suspiciously. User access levels limit the damage, because spyware can only see what the infected account can open.",consequence:"200,000 claims spied on · Bank details stolen · Vulnerable people exposed"},{id:"civil_server_theft",name:"Data Centre Break-in",attackType:"Data Theft",scenario:"At 4am two people in hi-vis jackets wave a clipboard at the night guard, walk into the government data centre and start unscrewing a backup server from its rack. It holds copies of every passport photo in the country.",protectedBy:["physical_security"],alsoHelpedBy:["encryption"],outcomeProtected:"The server hall needed a keycard and a PIN, CCTV flagged the clipboard trick and the alarm sounded as the rack door opened. Both intruders were arrested inside.",outcomePartial:"The intruders escaped with the server, but its drives were encrypted. The government lost the hardware, but not a single readable passport photo.",outcomeVulnerable:"The server left the building and nothing on it was protected. Millions of passport photos turned up for sale, ready-made for forged identity documents.",learning:"Not every attack comes over the internet. Physical security, such as keycard doors, PIN pads, guards, CCTV and alarms, stops intruders reaching the hardware at all. Encryption is the backup plan: if a server or drive is stolen anyway, the data on it is unreadable without the key.",consequence:"Passport photos stolen · Forged IDs on sale · National security review"},{id:"civil_phishing",name:"Civil Service Bonus Phish",attackType:"Social Engineering",scenario:"Every tax officer gets an email that seems to come from the Cabinet Office: 'All civil servants will receive a £500 cost of living bonus. Log in with your work account by Friday to claim it.' The login page is a fake on a lookalike web address, and these accounts can open any citizen's tax record.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained officers spotted the lookalike web address and reported the email, or the stolen passwords were useless without the code sent to each officer's phone. Not one tax record was opened.",outcomePartial:"Forty officers gave away their passwords and the attackers logged in, but user access levels meant each account could only open its own team's cases. A few hundred tax records leaked, not millions.",outcomeVulnerable:"Forty officers gave away their passwords and every account could search the whole country. The attackers downloaded the tax records of 3 million citizens, including their incomes and home addresses.",learning:O,consequence:"3 million tax records stolen · Fake bonus email · Staff accounts locked down"},{id:"civil_brute_force",name:"Tax Refund Brute Force",attackType:"Brute-Force",scenario:"In April, when tax refunds are paid, bots start trying password after password on citizens' online tax accounts: 'password1', 'Summer2026', pet names and birthdays. Every account they crack lets them change the bank details so the refund lands in a criminal's account.",protectedBy:["password_policy","account_lockout","two_factor"],alsoHelpedBy:["firewall"],outcomeProtected:"The bots got nowhere: passwords were too strong to guess, accounts locked after a few wrong tries, or a code from the citizen's phone was needed. Every refund went to the right bank account.",outcomePartial:"Your firewall blocked the busiest attacking addresses, but the bots switched to new ones and cracked 2,000 accounts before the refunds were frozen.",outcomeVulnerable:"The bots cracked 90,000 weak passwords and redirected £40 million of tax refunds to criminal bank accounts. Families who were counting on that money got nothing.",learning:Q,consequence:"90,000 tax accounts cracked · £40m refunds stolen · Families left short"},{id:"civil_interception",name:"Passport Scan Interception",attackType:"Data Interception and Theft",scenario:"Every night a regional passport office sends the day's scanned applications to the Whitehall printing centre over the internet: photos, birth certificates and signatures. A criminal has opened a street cabinet on the route and clipped a laptop onto the line to capture every packet.",protectedBy:["encryption"],alsoHelpedBy:[],outcomeProtected:"Every scan was encrypted before it left the office. The criminal captured a whole night of traffic and could not read a single photo or birth certificate.",outcomePartial:"Most scans were protected, but one batch went across unencrypted and was read.",outcomeVulnerable:"The scans travelled as plain data. Twelve thousand birth certificates, photos and signatures were copied, everything a forger needs to apply for a passport in someone else's name.",learning:G,consequence:"12,000 applications copied · Forged identities · Passport office shut down"},{id:"civil_shouldering",name:"Departure Lounge Shoulder Surf",attackType:"Social Engineering",scenario:"Final call for the 09:40 to Geneva. At Gate B22, a senior Digital Identity Office manager opens a work laptop to approve one last batch and logs into the passport records system, which can issue or cancel any passport in the country. A traveller standing behind the seats raises a phone and quietly films every key.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained manager shielded the keyboard, spotted the phone and reported the traveller to airport security, or the filmed password was useless without the code sent to the manager's phone. Nobody else got into the passport system.",outcomePartial:"The traveller filmed the whole password and criminals logged in that evening, but user access levels meant the manager's account could approve batches, not issue new passports. They read a day's applications before the account was locked.",outcomeVulnerable:"The traveller filmed the whole password and nothing else was needed. Before the plane had landed, criminals logged in and issued 300 real passports in made-up names to a smuggling gang.",learning:K,consequence:"300 passports issued to criminals · Identity records altered · Border alert raised"},{id:"civil_ransomware",name:"Passport Printer Ransomware",attackType:"Malware",scenario:"It's June and half a million families are waiting for passports before the summer holidays. A technician downloads a 'printer driver update' from a website onto the PC that controls the passport printing line. It is ransomware, and the screen turns red: 'Pay £8 million or no passport is printed.'",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software recognised the fake driver as ransomware and quarantined it before it ran. The printers kept going and every family flew on time.",outcomePartial:"The ransomware ran, but the technician's account could only reach one printing line. That line stopped for two days while the others kept printing.",outcomeVulnerable:"The ransomware spread to every printing line in the country. No passports were printed for three weeks and thousands of families missed their holidays.",learning:"Ransomware is malware that encrypts your files and demands payment. Anti-malware software stops it by recognising it from known signatures and suspicious behaviour, then quarantining it before it runs. User access levels limit the damage, because ransomware can only encrypt what the infected account can reach.",consequence:"Passport printing stopped · Holidays cancelled · £8m ransom demand"}],ki=[{id:"threadline_ddos",name:"Black Friday DDoS",attackType:"Denial of Service",scenario:"Black Friday, 9am, the biggest sales hour of Threadline's year. Suddenly the website stops responding: a botnet of hijacked computers is sending millions of requests a second. Every minute offline costs £500,000 in lost sales.",protectedBy:["firewall"],alsoHelpedBy:[],outcomeProtected:"Your firewall spotted the flood from the botnet and its rules blocked those sources, so real shoppers kept checking out. Black Friday broke sales records.",outcomePartial:"Some of the flood was filtered, but the site was down for an hour.",outcomeVulnerable:"The site was down for six hours on the busiest day of the year. Shoppers went to rivals and Threadline lost £180 million in sales.",learning:Y,consequence:"Site down 6 hours · £180m lost sales · Shoppers gone to rivals"},{id:"threadline_brute_force",name:"Account Takeover",attackType:"Brute-Force",scenario:"Bots start trying millions of passwords against Threadline customer accounts, working through lists of common passwords like 'fashion1', 'qwerty' and 'Summer2026'. Every account they crack has a saved card and a home address.",protectedBy:["password_policy","account_lockout","two_factor"],alsoHelpedBy:["firewall"],outcomeProtected:"The bots got nowhere: passwords were too strong to guess, accounts locked after a few wrong tries, or a second code was needed. Not one customer account was taken over.",outcomePartial:"Your firewall blocked the busiest attacking addresses, but the bots moved to new ones and took over 3,000 accounts before IT noticed.",outcomeVulnerable:"The bots cracked 200,000 weak passwords and went shopping on customers' saved cards, sending designer orders to new addresses.",learning:Q,consequence:"200,000 accounts hijacked · Fraudulent orders · Refunds and fines"},{id:"threadline_interception",name:"Card Interception",attackType:"Data Interception and Theft",scenario:"A criminal has tapped into the network route between Threadline's checkout and its payment provider, and is running packet-sniffing software on everything that passes: names, card numbers and expiry dates.",protectedBy:["encryption"],alsoHelpedBy:[],outcomeProtected:"Every payment was encrypted. The criminal captured millions of packets of scrambled nonsense and not one card number.",outcomePartial:"Some payments were protected, but a batch of card numbers was readable.",outcomeVulnerable:"Card details travelled as plain data. Two million cards were copied and sold online within a week, and the banks had to cancel every one.",learning:G,consequence:"2 million cards stolen · Banks cancel cards · Trust in Threadline gone"},{id:"threadline_phishing",name:"Supplier Invoice Phish",attackType:"Social Engineering",scenario:"Threadline's finance team gets an email that looks exactly like it is from their biggest denim supplier: 'Our bank details have changed. Log in to the supplier portal to approve this month's £4 million invoice.' The portal is a fake on a lookalike address.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your finance team spotted the lookalike address and rang the supplier on a number they already had, or the stolen passwords were useless without the code sent to each person's phone. Not a penny moved.",outcomePartial:"One finance clerk gave away their password and the attackers logged in, but user access levels meant the clerk could only view invoices, not approve payments.",outcomeVulnerable:"A finance manager gave away their password and their account could approve anything. £4 million was paid into the criminals' account and never recovered.",learning:O,consequence:"£4m paid to criminals · Supplier unpaid · Auditors called in"},{id:"threadline_ransomware",name:"Warehouse Ransomware",attackType:"Malware",scenario:"Three weeks before Christmas, a warehouse worker downloads a 'free shift-swap app' onto a picking terminal. It is ransomware. The screens on every conveyor and label printer turn red: 'Pay £10 million or no parcel leaves this building.'",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software flagged the fake app as ransomware and quarantined it before it ran. The conveyors kept moving and every Christmas parcel went out on time.",outcomePartial:"The ransomware ran, but the picking terminal's account could only reach its own zone. One aisle stopped for a day while the rest of the warehouse kept packing.",outcomeVulnerable:"The ransomware locked every system in the warehouse. A million Christmas orders sat on the shelves for ten days, customers were refunded and Threadline trended for all the wrong reasons.",learning:"Ransomware is malware that encrypts your files and demands payment. Anti-malware software stops it by recognising it from known signatures and suspicious behaviour, then quarantining it before it runs. User access levels limit the damage, because malware can only reach what the infected account can reach.",consequence:"Warehouse frozen 10 days · 1 million orders late · £10m ransom demand"},{id:"threadline_sql_injection",name:"Promo Code SQL Injection",attackType:"SQL Injection",scenario:"At the Threadline checkout, someone types SQL code into the promo code box instead of a discount code: ' OR 1=1; --. If the website passes it straight to the database, it will send back every customer's name, email and home address.",protectedBy:["input_validation","pen_testers"],alsoHelpedBy:["user_access"],outcomeProtected:"The promo code box rejected the code, either because it only accepts letters and numbers or because your penetration testers found this weakness last spring and it was fixed. The attacker just saw 'Code not recognised'.",outcomePartial:"The injection worked, but the checkout's database account could only read the promo codes table. The attacker got a list of discount codes, not a single customer.",outcomeVulnerable:"The database handed over the names, emails and home addresses of 25 million customers. Within days they were all getting convincing scam emails in Threadline's name.",learning:U,consequence:"25 million customers leaked · Scam emails flood in · Data watchdog fine"},{id:"threadline_blagging",name:"Fake Courier Blag",attackType:"Social Engineering",scenario:"The dispatch office phone rings. 'It's the courier depot. Our system has crashed and 40,000 parcels will miss Christmas. Email me today's delivery list right now or it's on you.' The caller is not from the courier.",protectedBy:["staff_training"],alsoHelpedBy:[],outcomeProtected:"Your trained dispatcher did not send anything. They rang the courier back on the number in the contract, and the real depot said its system was running perfectly.",outcomePartial:"The dispatcher hesitated, but still read out a few customer addresses before hanging up.",outcomeVulnerable:"The dispatcher emailed the list. A gang now knew exactly which homes had expensive parcels arriving and when, and doorstep thefts and fake 'missed delivery' texts followed.",learning:Z,consequence:"40,000 addresses handed over · Parcels stolen from doorsteps · Fake delivery texts"},{id:"threadline_warehouse_theft",name:"Shift Change Tailgater",attackType:"Data Theft",scenario:"At the 10pm shift change, a stranger in a Threadline hoodie follows a crowd of workers through the warehouse turnstile. They walk into the IT room and fill a bag with the backup drives, which hold a copy of every customer's order history and address.",protectedBy:["physical_security"],alsoHelpedBy:["encryption"],outcomeProtected:"The turnstile only let one keycard through at a time, the IT room needed a keycard and a PIN, and CCTV flagged the stranger at once. Security stopped them before they reached the drives.",outcomePartial:"The stranger got out with the drives, but every one was encrypted. Threadline lost the hardware, but not one readable customer record.",outcomeVulnerable:"The drives left the building and nothing on them was protected. Millions of customer addresses and order histories went on sale online.",learning:"Not every attack comes over the internet. Physical security, such as turnstiles, keycard doors, PIN pads, guards and CCTV, stops intruders reaching the hardware at all. Encryption is the backup plan: if a drive is stolen anyway, the data on it is unreadable without the key.",consequence:"Backup drives stolen · Customer data on sale · Warehouse security review"},{id:"threadline_shouldering",name:"Pop-up Shop Shoulder Surf",attackType:"Social Engineering",scenario:"At Threadline's first pop-up shop in London, the store manager logs into the stock and customer system on the counter tablet. A 'shopper' browsing the rail behind them holds up a phone and films every key of the admin password.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained manager turned the tablet away, covered the screen and spotted the phone, or the filmed password was useless without the code sent to the manager's phone. The break-in attempt that night got nowhere.",outcomePartial:"The shopper filmed the whole password and logged in that night, but user access levels meant a store manager could only change the pop-up shop's stock, not issue store credit or open the customer list. A few prices were changed before head office noticed.",outcomeVulnerable:"The shopper filmed the whole password and nothing else was needed. That night they logged in as an admin, gave themselves £50,000 of store credit and downloaded the customer list.",learning:K,consequence:"Admin account hijacked · £50,000 store credit stolen · Customer list taken"},{id:"threadline_spyware",name:"Browser Add-on Spyware",attackType:"Malware",scenario:"A customer service agent installs a free 'size chart helper' add-on in their web browser. It is spyware: it secretly records every key pressed and every customer record opened, and sends it to a server abroad. Agents can see addresses, orders and the last four digits of cards.",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software recognised the add-on as spyware and quarantined it the moment it was installed. Nothing left the building.",outcomePartial:"The spyware ran for a week, but the agent's account could only open the customers they were helping. A few hundred records leaked, not the whole customer base.",outcomeVulnerable:"The spyware ran for two months. It recorded the agent's password and every customer record they opened, and criminals used the details to pass security checks and take over accounts.",learning:"Spyware is malware that secretly records what you do, such as keys pressed and screens opened, and sends it to the attacker. Anti-malware software stops it by scanning new software and quarantining anything that matches known malware or behaves suspiciously. User access levels limit the damage, because spyware can only see what the infected account can open.",consequence:"Customer records spied on · Agent login stolen · Accounts taken over"}],ui=[{id:"law_phishing",name:"Shared Document Phish",attackType:"Social Engineering",scenario:"Lawyers get an email: 'A client has shared a confidential document with you. Log in to view.' The link leads to a convincing fake login page on a lookalike web address. The firm handles celebrity divorces and billion-pound mergers.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your lawyers spotted the lookalike web address and reported it, or the stolen passwords were useless without the code sent to their phones. No case file was touched.",outcomePartial:"Three lawyers gave away their passwords, but user access levels meant each could only open their own cases. The attackers saw one property deal, not the firm's secrets.",outcomeVulnerable:"Three lawyers gave away their passwords and their accounts could open everything. Details of a secret merger leaked and the share price moved before it was announced.",learning:O,consequence:"Merger secrets leaked · Clients leave · Regulator investigates"},{id:"law_laptop_theft",name:"Laptop Snatched on a Train",attackType:"Data Theft",scenario:"A partner falls asleep on the evening train. When they wake up, their laptop has gone from the luggage rack. On it is the full file for a celebrity divorce that every newspaper wants.",protectedBy:["encryption"],alsoHelpedBy:["password_policy"],outcomeProtected:"The laptop was gone, but its drive was encrypted. To the thief the divorce file was unreadable scrambled data, and the story never came out.",outcomePartial:"The laptop's long password kept the thief out, so he wiped it and sold it on. The divorce file probably never leaked, but the drive was not encrypted, so nobody could be sure and the firm had to report the loss to the regulator as a data breach.",outcomeVulnerable:"Nothing on the laptop was protected. Within a week the divorce file was on the front pages and the celebrity was suing the firm.",learning:"Physical security cannot help once a device leaves the building, which is why encryption matters: if a laptop is stolen, the data on its drive is unreadable without the key. A strong password only protects the account: anyone who removes the drive and plugs it into another computer can read everything that is not encrypted.",consequence:"Celebrity file leaked · Firm sued · Reputation destroyed"},{id:"law_ransomware",name:"Leak-Site Ransomware",attackType:"Malware",scenario:"A trainee installs a free 'PDF converter' from a website. It is ransomware. It encrypts the firm's case files and posts a message: 'Pay £5 million or we publish every client's secrets on our leak site.'",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software flagged the fake converter as ransomware and quarantined it before it ran. Not one case file was touched.",outcomePartial:"The ransomware ran, but the trainee's account could only reach their own team's folders. A handful of files were encrypted and the rest of the firm carried on.",outcomeVulnerable:"The ransomware encrypted every case file in the firm and the criminals began publishing clients' secrets one by one.",learning:"Ransomware is malware that encrypts your files and demands payment, and modern gangs also threaten to publish what they steal. Anti-malware software stops it by recognising it and quarantining it before it runs. User access levels limit the damage, because malware can only reach what the infected account can reach.",consequence:"Every case file encrypted · £5m ransom · Client secrets published"},{id:"law_brute_force",name:"Client Portal Brute Force",attackType:"Brute-Force",scenario:"Harcourt & Vale's clients log in to a portal to read their case documents. A rival's hired hacker points a bot at a billionaire client's account and fires thousands of guesses a minute: 'yacht2024', 'Monaco!', 'password123'.",protectedBy:["password_policy","account_lockout","two_factor"],alsoHelpedBy:["firewall"],outcomeProtected:"The bot got nowhere: the password was too long to guess, the account locked after a few wrong tries, or a second code was needed. The billionaire's documents were never opened.",outcomePartial:"Your firewall blocked the first attacking addresses, but the bot switched to new ones and cracked the password after two days. IT spotted the strange login and locked it within the hour.",outcomeVulnerable:"The bot cracked the weak password in minutes. The rival read the billionaire's whole takeover strategy and outbid them the next morning.",learning:Q,consequence:"Client account cracked · Takeover strategy leaked · Client sues the firm"},{id:"law_court_interception",name:"Court Wi-Fi Interception",attackType:"Data Interception and Theft",scenario:"During a huge fraud trial, Harcourt & Vale's barristers send witness statements back to the office over the court's free Wi-Fi. A journalist on the public benches runs packet-sniffing software on the same network and captures everything.",protectedBy:["encryption"],alsoHelpedBy:[],outcomeProtected:"Every statement was encrypted before it left the laptop. The journalist captured thousands of packets of scrambled nonsense and the trial carried on.",outcomePartial:"Some files were protected, but one witness statement was readable.",outcomeVulnerable:"Everything travelled as plain data. The statements were in a newspaper the next day, the judge halted the trial and the firm was reported to the regulator.",learning:G,consequence:"Witness statements leaked · Trial halted · Firm reported to the regulator"},{id:"law_sql_injection",name:"Case Tracker SQL Injection",attackType:"SQL Injection",scenario:"Harcourt & Vale's clients check on their house purchase by typing a case reference into a 'Track your case' box. An attacker types ' OR 1=1; -- instead. If the box passes it straight to the database, it will send back every client's case notes, home address and bank details.",protectedBy:["input_validation","pen_testers"],alsoHelpedBy:["user_access"],outcomeProtected:"The box rejected the code, either because it only accepts a case reference like HV-123456 or because your penetration testers had already found and fixed the weakness. The attacker got an error message and nothing else.",outcomePartial:"The injection worked, but the tracker's database account could only read the progress table, not the case files. A list of clients' names and purchase stages leaked before the hole was closed.",outcomeVulnerable:"The database handed over 60,000 clients' case notes, home addresses and bank details. Fraudsters used them to pose as the firm and ask clients to send money.",learning:U,consequence:"60,000 client files stolen · Clients targeted by fraudsters · ICO fine"},{id:"law_blagging",name:"Completion Day Blag",attackType:"Social Engineering",scenario:"On completion day, a conveyancing assistant takes a call from someone claiming to be a client selling her house. 'I've changed banks this morning. Send the £640,000 from the sale to my new account before 2pm or the whole chain collapses!' It is not the client.",protectedBy:["staff_training"],alsoHelpedBy:[],outcomeProtected:"Your trained assistant refused to change bank details over the phone and rang the client back on the number already on file. The real client had not changed banks, and the money went to the right account.",outcomePartial:"The assistant did not send the money, but confirmed the client's address and sale price to the caller.",outcomeVulnerable:"Under pressure, the assistant typed in the new bank details and sent the money. The £640,000 vanished through accounts abroad within an hour, and the firm had to repay the client.",learning:Z,consequence:"£640,000 sent to criminals · House sale delayed · Firm repays the client"},{id:"law_ddos",name:"Deal Data Room DDoS",attackType:"Denial of Service",scenario:"Harcourt & Vale runs the online data room for a £2 billion takeover, and every bidder must upload its final offer by midnight. At 9pm a botnet of hijacked computers floods the data room with millions of fake requests, and the bidders cannot get in.",protectedBy:["firewall"],alsoHelpedBy:[],outcomeProtected:"Your firewall recognised the flood from the botnet and its rules blocked those sources. Every bidder uploaded on time and the deal was signed the next morning.",outcomePartial:"Some of the flood was filtered, but the data room was down for two hours before midnight.",outcomeVulnerable:"The data room stayed down until well after midnight. Two bidders missed the deadline, the sale had to be restarted and the client blamed the firm.",learning:Y,consequence:"Data room offline · Final bids missed · £2bn deal delayed"},{id:"law_shouldering",name:"Courtside Café Shoulder Surf",attackType:"Social Engineering",scenario:"A trainee grabs a coffee near the Royal Courts and logs into the firm's case system on a laptop to check a hearing time. A man at the next table angles his phone at the keyboard and films every key. That evening a stranger tries to log in.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained trainee sat with their back to the wall, shielded the keyboard and noticed the phone, or the filmed password was useless without the code sent to the trainee's phone. The stranger never got in.",outcomePartial:"He filmed the whole password and the stranger logged in, but user access levels meant a trainee could only open their own team's cases. He saw a hearing list, not the celebrity's files.",outcomeVulnerable:"He filmed the whole password and nothing else was needed. The stranger logged into the case system and copied the files on a celebrity's upcoming court case.",learning:K,consequence:"Case system breached · Celebrity case leaked · Client loses trust"},{id:"law_office_break_in",name:"Archive Room Break-in",attackType:"Data Theft",scenario:"Late on a Friday, a man in a cleaner's tabard pushes a trolley past reception, walks into the archive room and unplugs the backup drive. It holds scanned copies of every will, deed and contract the firm has handled in twenty years.",protectedBy:["physical_security"],alsoHelpedBy:["encryption"],outcomeProtected:"The archive room needed a keycard, CCTV flagged a cleaner who was not on the rota and the door alarm sounded. Security stopped him at the lifts with the drive still on his trolley.",outcomePartial:"He escaped with the backup drive, but it was encrypted. The firm lost the hardware, but not a single readable will or deed.",outcomeVulnerable:"The drive left the building and nothing on it was protected. Clients' wills, property deeds and family secrets were offered for sale online.",learning:"Not every attack comes over the internet. Physical security, such as keycard doors, CCTV, alarms and checking who should be in the building, stops intruders reaching the hardware at all. Encryption is the backup plan: if a drive is stolen anyway, the data on it cannot be read without the key.",consequence:"Twenty years of wills stolen · Clients' secrets for sale · Regulator investigates"}],mi=[{id:"vidora_brute_force",name:"Mega-Creator Takeover",attackType:"Brute-Force",scenario:"Bots start hammering the login of Vidora's biggest creator, with 40 million subscribers, trying thousands of passwords a minute. Whoever gets in can post to 40 million people.",protectedBy:["password_policy","account_lockout","two_factor"],alsoHelpedBy:["firewall"],outcomeProtected:"The bots got nowhere: the password was too strong, the account locked after a few wrong guesses, or a second code was needed. The channel was never touched.",outcomePartial:"Your firewall slowed the bots down, but they switched addresses and got in for ten minutes before the creator noticed.",outcomeVulnerable:"The bots cracked the password and posted a crypto scam to 40 million subscribers. Thousands of fans lost money before the video came down.",learning:Q,consequence:"Channel hijacked · Scam sent to 40 million · Fans lose money"},{id:"vidora_sql_injection",name:"Payouts SQL Injection",attackType:"SQL Injection",scenario:"On the creator payouts page, an attacker types ' OR 1=1; -- into the search box. If the page passes it straight to the database, it will send back every creator's bank details and earnings.",protectedBy:["input_validation","pen_testers"],alsoHelpedBy:["user_access"],outcomeProtected:"The search box rejected the code, either because it validates every input or because your penetration testers found the hole and it was fixed. The attacker got nothing.",outcomePartial:"The injection worked, but the search page's database account could only read creators' channel names and payout dates, not their bank details. The attacker got a list of who earns what and when, and nothing they could steal money with.",outcomeVulnerable:"The database handed over two million creators' bank details and earnings. Creators were targeted by fraudsters and many left for rival platforms.",learning:U,consequence:"2 million creators exposed · Bank fraud · Creators quit"},{id:"vidora_blagging",name:"Live-Stream Blag",attackType:"Social Engineering",scenario:"Creator support gets a frantic call. 'I'm the manager of your biggest star. They go live to two million people in five minutes and they're locked out. Reset the password now or we move to another platform!' The caller is not the manager.",protectedBy:["staff_training"],alsoHelpedBy:[],outcomeProtected:"Your trained agent recognised the pressure tactics, refused to reset anything over the phone and checked with the creator through the app. The real creator went live on time.",outcomePartial:"The agent hesitated, but still gave away the email address on the account.",outcomeVulnerable:"Under pressure, the agent reset the password. The caller went live on the star's channel in front of two million viewers and streamed a scam.",learning:Z,consequence:"Star channel hijacked live · Scam to 2 million viewers · Trust destroyed"},{id:"vidora_trojan",name:"Editing Plugin Trojan",attackType:"Malware",scenario:"A Vidora engineer installs a 'free 8K video filter plugin' from a forum. It is a trojan: malware disguised as something useful. Behind the scenes it opens a back door into the servers that store unreleased videos from the platform's biggest stars.",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software recognised the plugin as a trojan and quarantined it before the back door ever opened.",outcomePartial:"The trojan ran, but the engineer's account could only reach the test servers. The attackers found dummy videos and nothing else.",outcomeVulnerable:"The back door stayed open for weeks. Hundreds of unreleased videos leaked online before their premieres, and furious creators threatened to leave.",learning:"A trojan is malware disguised as useful software, so the victim installs it themselves. Anti-malware software stops it by recognising it from known signatures and suspicious behaviour, then quarantining it before it runs. User access levels limit the damage, because the trojan can only reach what the infected account can reach.",consequence:"Unreleased videos leaked · Premieres ruined · Creators threaten to leave"},{id:"vidora_ddos",name:"World Cup Final DDoS",attackType:"Denial of Service",scenario:"Vidora has the rights to stream the World Cup final live to 300 million viewers. Ten minutes before kick-off, a botnet of hijacked computers floods the streaming servers with billions of fake requests.",protectedBy:["firewall"],alsoHelpedBy:[],outcomeProtected:"Your firewall recognised the flood from the botnet and its rules blocked those sources. The stream never buffered and Vidora set a world record for live viewers.",outcomePartial:"Some of the flood was filtered, but the stream froze for the whole first half.",outcomeVulnerable:"The stream collapsed before kick-off and stayed down for the whole match. 300 million viewers missed the final and advertisers demanded £200 million back.",learning:Y,consequence:"Final not shown · 300 million viewers lost · £200m refunds"},{id:"vidora_phishing",name:"Moderator Text Phish",attackType:"Social Engineering",scenario:"Vidora's content moderators get a text: 'ModDesk: your account will be suspended in 30 minutes. Verify now at vidora-moddesk.help.' The link opens a perfect copy of the moderation login page. A moderator account can delete any video and ban any creator.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your moderators spotted the fake web address and reported the text, or the stolen passwords were useless without the code sent to their phones. Not one video was touched.",outcomePartial:"Two moderators gave away their passwords, but user access levels meant each could only act on their own region's queue. A few hundred videos were hidden for an hour before the accounts were locked.",outcomeVulnerable:"Two moderators gave away their passwords and their accounts could reach everything. On a Saturday night the attackers banned the platform's top creators and deleted their channels.",learning:O,consequence:"Moderator accounts hijacked · Top channels deleted · Creators furious"},{id:"vidora_interception",name:"Hotel Wi-Fi Sniffing",attackType:"Data Interception and Theft",scenario:"The night before the Vidora Creator Awards, a Vidora talent manager sits in a hotel lobby and uploads the secret winners list to the show team over the hotel's free guest Wi-Fi. A guest across the lobby is on the same network, running packet-sniffing software on a laptop that captures every packet sent through the router.",protectedBy:["encryption"],alsoHelpedBy:[],outcomeProtected:"The winners list was encrypted before it left the laptop. The guest captured every packet but could only see scrambled nonsense, and the winners stayed secret until they were announced live on stage.",outcomePartial:"Most of the upload was protected, but some of the list was readable.",outcomeVulnerable:"Everything travelled as plain data. The guest pieced the packets back together and posted every winner online before midnight. By the time the show went live, millions of fans already knew the results and the creators had lost their big moment.",learning:G,consequence:"Winners leaked online · Awards show spoiled · Sponsors pull out"},{id:"vidora_virus",name:"Final Cut Virus",attackType:"Malware",scenario:"Two days before Vidora's biggest original series premieres, an editor finds a USB stick in the car park labelled 'S2 FINAL CUT' and plugs it in. Hidden on it is a virus, malware that attaches itself to files. It latches onto the episode files, and every time another edit machine opens a shared episode, the virus copies itself there and corrupts more footage.",protectedBy:["anti_malware"],alsoHelpedBy:["user_access"],outcomeProtected:"Your anti-malware software scanned the stick the moment it was plugged in, matched the virus to a known signature and quarantined it before it could attach to a single episode. The premiere went out on Friday as planned.",outcomePartial:"The virus attached itself to the editor's episode, but user access levels meant that account could only reach one shared folder. One episode was corrupted and rebuilt from backup while the other edit machines stayed clean.",outcomeVulnerable:"The virus rode the shared episode files onto every edit machine in the building, corrupting 3,412 clips as it spread. The premiere was cancelled after the trailer had already gone out, and fans flooded social media with complaints.",learning:"A virus is malware that attaches itself to a file or program. It runs when that file is opened, copies itself into other files, and spreads every time an infected file is run or shared. Unlike a worm, it needs a person to run or share the infected file. Anti-malware software stops it by checking files against known virus signatures and watching for suspicious behaviour, then quarantining infected files before they run. User access levels limit the damage, because a virus can only reach the shared folders the infected account can open.",consequence:"Virus on every edit machine · 3,412 clips corrupted · Premiere cancelled"},{id:"vidora_studio_break_in",name:"Creator Studio Break-in",attackType:"Data Theft",scenario:"Vidora's London creator studio is filming a secret collaboration between two of the world's biggest stars. A man carrying a box of props follows a runner through the side door, walks into the edit bay and leaves with the hard drive of raw footage.",protectedBy:["physical_security"],alsoHelpedBy:["encryption"],outcomeProtected:"The edit bay needed a keycard, the side door alarm sounded when it was held open and CCTV picked him out. Security stopped him in the car park with the drive still in the box.",outcomePartial:"He escaped with the drive, but it was encrypted. The studio lost the hardware, but not a second of watchable footage.",outcomeVulnerable:"The drive left the building and nothing on it was protected. The secret collaboration leaked online a week before its premiere and both stars blamed Vidora.",learning:"Not every attack comes over the internet. Physical security, such as keycard doors, door alarms, CCTV and not letting people follow you in, stops intruders reaching the hardware at all. Encryption is the backup plan: if a drive is stolen anyway, the data on it is unreadable without the key.",consequence:"Secret collab leaked · Premiere ruined · Stars blame Vidora"},{id:"vidora_shouldering",name:"Gaming Expo Shoulder Surf",attackType:"Social Engineering",scenario:"At a packed gaming expo, a Vidora engineer logs into the platform's admin panel on the stand laptop to fix a broken demo. A fan in the crowd is live-streaming the stand on his phone, and the stream shows every key she types.",protectedBy:["staff_training","two_factor"],alsoHelpedBy:["user_access"],outcomeProtected:"Either your trained engineer turned the laptop away, shielded the keyboard and spotted the phone, or the streamed password was useless without the code sent to the engineer's phone. Nobody got into the admin panel.",outcomePartial:"Thousands of viewers saw the password and someone logged in, but user access levels meant the engineer's account could only manage expo demos, not the home page. A demo video was swapped for a meme before the password was changed.",outcomeVulnerable:"Thousands of viewers saw the password and nothing else was needed. Within minutes someone logged into the admin panel and put a scam banner on Vidora's home page.",learning:K,consequence:"Admin panel breached · Scam on the home page · 2 billion viewers see it"}],be=[{id:"police",sector:"Public sector",organisation:"Northgate Police Service",manager:"Priya",briefing:"You run the network for a police force: the 999 control room, the evidence store and officers on the street.",budget:7e6,topUp:5e6,costScale:20,attacks:gi},{id:"hospital",sector:"Public sector",organisation:"St Elm University Hospital",manager:"Kwame",briefing:"You run the network for a major hospital: patient records, scanners, operating theatres and A&E.",budget:875e4,topUp:5e6,costScale:25,attacks:bi},{id:"civil",sector:"Public sector",organisation:"Civil Service Digital Identity Office",manager:"Eleanor",briefing:"You run the network behind passports, tax and benefits for 67 million citizens, from an office in Whitehall.",budget:16e6,topUp:8e6,costScale:40,attacks:wi},{id:"threadline",sector:"Private sector",organisation:"Threadline",manager:"Jade",briefing:"You run the network for an online fashion giant with 25 million customers, and Black Frida