n":3,"topic":"embedded systems","marks":3,"command_word":"identify","content":[{"type":"text","value":"Identify three real-world examples of embedded systems."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each valid example, to a maximum of 3 marks."},{"type":"list","items":["Accept: washing machine controller.","Accept: microwave oven.","Accept: traffic light controller.","Accept: car engine management unit.","Accept: smart thermostat.","Accept: digital camera.","Reject: laptop, desktop PC, smartphone (these are general purpose computers)."]}],"marks_breakdown":[{"criteria":"First valid example of an embedded system identified","marks":1},{"criteria":"Second valid example of an embedded system identified","marks":1},{"criteria":"Third valid example of an embedded system identified","marks":1}]}},{"question_id":"4(a)","parent_question":4,"topic":"sound representation","marks":2,"command_word":"describe","content":[{"type":"text","value":"A musician records a vocal track using a microphone connected to a computer."},{"type":"text","value":"Describe how the analogue sound from the microphone is converted into a digital file."}],"answer":{"guidance":[{"type":"text","value":"1 mark for sampling reference and 1 mark for binary/quantisation reference, to a maximum of 2 marks."},{"type":"list","items":["Accept: the amplitude of the wave is sampled (measured) at regular intervals (1).","Accept: each sample is then stored as a binary number (1).","Reject: vague references to 'the sound is digitised' without explanation."]}],"marks_breakdown":[{"criteria":"References sampling the analogue wave at regular intervals","marks":1},{"criteria":"References storing each sample as a binary value","marks":1}]}},{"question_id":"4(b)","parent_question":4,"topic":"sound representation","marks":2,"command_word":"give","content":[{"type":"text","value":"Give two effects of using a higher sample rate when recording the vocal track."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each valid effect, to a maximum of 2 marks."},{"type":"list","items":["Accept: the recording is closer to the original sound / higher quality.","Accept: the file size of the recording is larger.","Accept: more samples are taken per second.","Reject: 'better' on its own without context."]}],"marks_breakdown":[{"criteria":"First valid effect of higher sample rate given (e.g. higher quality)","marks":1},{"criteria":"Second valid effect of higher sample rate given (e.g. larger file size)","marks":1}]}},{"question_id":"5(a)","parent_question":5,"topic":"binary conversion","marks":1,"command_word":"convert","content":[{"type":"text","value":"Convert the 8-bit binary value 11010101 to denary."}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct denary value."},{"type":"list","items":["Correct answer: 213 (128 + 64 + 16 + 4 + 1).","Accept the correct working shown even if the final number is mis-copied, provided 213 is clearly indicated."]}],"marks_breakdown":[{"criteria":"Correct denary value 213 given","marks":1}]}},{"question_id":"5(b)","parent_question":5,"topic":"binary shift","marks":1,"command_word":"complete","content":[{"type":"text","value":"Complete the table to show the result of a right shift by 1 of the binary value 01101100."},{"type":"table","headers":["Original value","Right shift by 1"],"rows":[["01101100",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct 8-bit result with leading zero."},{"type":"list","items":["Correct answer: 00110110.","Reject: results that drop leading zeros (e.g. 110110 without leading 0)."]}],"marks_breakdown":[{"criteria":"Correct shifted value 00110110 given","marks":1}]}},{"question_id":"5(c)","parent_question":5,"topic":"binary shift","marks":2,"command_word":"explain","content":[{"type":"text","value":"Explain the effect that a binary shift has on a denary number."}],"answer":{"guidance":[{"type":"text","value":"1 mark for direction of shift linked to multiplication or 