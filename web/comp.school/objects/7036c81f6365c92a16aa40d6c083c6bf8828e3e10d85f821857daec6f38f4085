2023-june/question/page-007.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-024.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-3-b-iv.png"}},{"question_id":"3(c)(i)","parent_question":3,"topic":"text compression","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"A student has a text document and an image file that need to be compressed separately."},{"type":"text","value":"The student needs to reduce the file size of both of these files as much as possible."},{"type":"text","value":"Identify the most suitable type of compression for the text document. Justify your choice."},{"type":"text","value":"Type of compression: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying lossless."},{"type":"list","items":["Do not award an example of lossless (e.g. RLE) for the first mark but follow through for the justification.","Do not follow through for lossy.","Accept reverse arguments (e.g. lossy will remove data).","If the compression type is missing, read the justification","if it clearly states which type, award the justification.","MP1 requires reference to the data (or equivalent) not information","MP2 must be in the context of text files (information is allowed).","If not a valid compression type, 0 marks.","Valid justifications: lossless will not remove any data / no data is lost / file can be fully reconstructed","text files require all data to open/work / lossy cannot usually be used on text files / no required characters, words, spaces, case, formatting or information would be lost / the text will remain accurate / will not change meaning / will still make sense."]},{"type":"text","value":"1 mark each to max 2 for justification."}],"marks_breakdown":[{"criteria":"Lossless compression identified","marks":1},{"criteria":"Justification point 1 (e.g. no data is lost / file can be fully reconstructed)","marks":1},{"criteria":"Justification point 2 in text-file context (e.g. text remains accurate / all characters and formatting retained / lossy unsuitable for text)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-006.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-025.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-3-c-i.png"}},{"question_id":"3(c)(ii)","parent_question":3,"topic":"image compression","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Identify the most suitable type of compression for the image file. Justify your choice."},{"type":"text","value":"Type of compression: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying lossy."},{"type":"list","items":["Do not award an example of lossy (e.g. reduce resolution) for the first mark but follow through the justification.","Do not award lossless but follow through the justification if lossless is given (acceptable lossless justifications: quality/detail retained","no data lost permanently","file size can still be substantially reduced).","If compression type is missing, read the justification and award if the type is clearly stated.","Do not award 'how the file can be compressed' (e.g. reduce number of colours) unless the candidate also states that the change will not be noticed.","'It compresses the file more' is not enough (compression is in the question).","If not a valid compression type, 0 marks.","Accepted lossy justifications: will reduce the file size more/significantly than lossless","image will only lose quality / changes may not be noticed by the user / removes unnoticeable detail."]},{"type":"text","value":"1 mark each to max 2 for justification."}],"marks_breakdown":[{"criteria":"Lossy compression identified","marks":1},{"criteria":"Justification point 1 (e.g. reduces file size more/significantly than lossless)","marks":1},{"criteria":"Justification point 2 (e.g. only loses quality or removes unnoticeable detail, changes may not be noticed)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-007.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-023.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-3-c-ii.png"}},{"question_id":"4(a)","parent_question":4,"topic":"threat prevention methods","marks":4,"command_word":"tick","content":[{"type":"text","value":"Tick one or more boxes on each row to identify all of the methods that can help to prevent each threat."},{"type":"table","headers":["Threat","Anti-malware","Penetration testing","Encryption","Firewall"],"rows":[["Spyware","","","",""],["Brute-force attack","","","",""],["Data interception","","","",""],["SQL injection","","","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct row. Correct pattern (ticks where the method helps prevent the threat):"},{"type":"table","headers":["Threat","Method(s) that help prevent the threat"],"rows":[["Spyware","Anti-malware (and Firewall)"],["Brute-force attack","Firewall"],["Data interception","Encryption"],["SQL injection","Penetration testing (and Firewall)"]]},{"type":"text","value":"Extra or missing ticks within a row score 0 for that row. A firewall and penetration testing alone cannot stop data interception once data is in transit between computers."}],"marks_breakdown":[{"criteria":"Spyware row correct (Anti-malware, and Firewall)","marks":1},{"criteria":"Brute-force attack row correct (Firewall)","marks":1},{"criteria":"Data interception row correct (Encryption)","marks":1},{"criteria":"SQL injection row correct (Penetration testing, and Firewall)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-027.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-4-a.png"}},{"question_id":"4(b)","parent_question":4,"topic":"network threats","marks":3,"command_word":"name and describe","content":[{"type":"text","value":"Name and describe one threat to a computer system that is not Spyware, Brute Force attack, Data Interception or SQL Injection."},{"type":"text","value":"Threat: ____"},{"type":"text","value":"Description: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for naming a valid threat (not one of those excluded by the question). 1 mark each to max 2 for description. If threat is clearly wrong, do not follow through. If no threat named, read description for the name; if still none, do not award. Allow social engineering as the threat and phishing/pharming/shoulder surfing features in the description. Ransomware description cannot award a mark for 'ransom' alone without reference to it being paid."},{"type":"text","value":"Accepted threats and example descriptions:"},{"type":"table","headers":["Threat","Example description(s)"],"rows":[["Social engineering","using deception to manipulate users; to gain personal data"],["Shoulder surfing","watching a person enter a password; using it to access an account"],["Phishing","fake emails sent / click link from fake email; person sends / gives away personal data"],["Pharming","software redirects to fake website; person enters personal data"],["Denial of Service / DDoS","multiple requests sent to a server / server is flooded; more requests than the server can process / uses all bandwidth; server cannot respond / crashes / slows or denies access"],["Hacker","gaining unauthorised access; to delete/damage/access data"],["Virus/malware","software that replicates/spreads; fills disk space; deletes/corrupts data / allows unauthorised access"],["Trojan","malware disguised as legitimate software; once installed acts as a virus, e.g. deletes files or allows unauthorised access"],["Worm","replicates across a network; uses up bandwidth"],["Ransomware","encrypts/corrupts/locks access to data; cannot access data without paying a fee to decrypt / meet demands"],["Physical threat","damage to hardware; deletes/corrupts data"]]}],"marks_breakdown":[{"criteria":"Valid threat named (not Spyware, Brute Force, Data Interception or SQL Injection)","marks":1},{"criteria":"Description point 1 matching the named threat","marks":1},{"criteria":"Description point 2 matching the named threat","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-028.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-4-b.png"}},{"question_id":"5(a)(i)","parent_question":5,"topic":"primary and secondary storage","marks":2,"command_word":"explain","content":[{"type":"text","value":"An artist has a computer that they use to create images."},{"type":"text","value":"Their computer has both hardware and software."},{"type":"text","value":"The hardware includes primary and secondary storage."},{"type":"text","value":"Explain why a computer needs both primary and secondary storage."}],"answer":{"guidance":[{"type":"text","value":"1 mark each for a reason relating to primary storage and a reason relating to secondary storage."},{"type":"list","items":["Primary storage: to store (active) data/instructions/software/OS that the processor needs to access","without primary the computer won't start up / work","(ROM) so start-up instructions are not deleted when the computer turns off","(RAM) to store currently running data/software/instructions","(cache) to store frequently used data/instructions.","Secondary storage: to store data/files long-term / permanently","without secondary the user's files will not be stored when the power is turned off","to store data not currently being used."]},{"type":"text","value":"The question asks why each is needed, not what they store. Secondary storage answers must reference long-term / permanent storage, not just 'backup'."}],"marks_breakdown":[{"criteria":"Reason primary storage is needed (e.g. stores active data/instructions/OS the processor accesses, or without it the computer won't start)","marks":1},{"criteria":"Reason secondary storage is needed (e.g. stores data/files long-term / permanently so files persist when power is off)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-030.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-a-i.png"}},{"question_id":"5(a)(ii)","parent_question":5,"topic":"secondary storage devices","marks":2,"command_word":"give","content":[{"type":"text","value":"Give one example of a secondary storage device that the artist's computer will have and an example of the data that will be stored on it."},{"type":"text","value":"Secondary storage device: ____"},{"type":"text","value":"Example data: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid secondary storage device."},{"type":"list","items":["Question asks for a device not a type (magnetic/optical/solid state on its own is not enough","BOD 'optical disc').","USB on its own is not enough.","Accepted devices: hard drive, SSD, USB (memory) stick, flash memory card, CD, DVD, etc.","Accepted data examples: images created, documents, software, files, data moved from RAM to virtual memory.","Award the example even if the secondary device is incorrect.","Do not accept RAM or ROM as a secondary storage device."]},{"type":"text","value":"1 mark for an example of data."}],"marks_breakdown":[{"criteria":"Valid secondary storage device (e.g. hard drive, SSD, USB memory stick, flash memory card, CD, DVD)","marks":1},{"criteria":"Valid example of data stored (e.g. images created, documents, software, files)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-033.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-a-ii.png"}},{"question_id":"5(a)(iii)","parent_question":5,"topic":"virtual memory","marks":4,"command_word":"tick and rewrite","content":[{"type":"text","value":"The computer has Virtual Memory (VM)."},{"type":"text","value":"The table has four statements about VM. Not all of the statements are correct."},{"type":"text","value":"Tick the True column for the statements that are correct. Re-write any statement that is incorrect in the False column by changing the statement to make it true."},{"type":"table","headers":["Statement","True","False - rewrite the statement to make it true"],"rows":[["A section of primary storage is partitioned to act as virtual memory","",""],["Data from ROM is transferred into VM","",""],["VM is needed when RAM is full, or nearly full","",""],["Data from VM is transferred back to secondary storage when needed","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for each row. Allow a description of the error in column 2 rather than a full rewrite (e.g. 'primary should be secondary'). Accept HDD/SSD for secondary storage in row 1. Do not accept 'primary' on its own for RAM (rows 2 and 4) because primary would include ROM and cache."},{"type":"table","headers":["Row","True/False","Correct rewrite / marking guidance"],"rows":[["1","FALSE","A section of secondary storage is partitioned to act as virtual memory"],["2","FALSE","Data from RAM is transferred into VM"],["3","TRUE",""],["4","FALSE","Data from VM is transferred back to RAM when needed"]]}],"marks_breakdown":[{"criteria":"Row 1 identified as false and rewritten: secondary storage (not primary) is partitioned to act as VM","marks":1},{"criteria":"Row 2 identified as false and rewritten: data from RAM (not ROM) is transferred into VM","marks":1},{"criteria":"Row 3 ticked as True (VM is needed when RAM is full or nearly full)","marks":1},{"criteria":"Row 4 identified as false and rewritten: data from VM is transferred back to RAM (not secondary storage) when needed","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-031.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-a-iii.png"}},{"question_id":"5(b)","parent_question":5,"topic":"utility software purpose","marks":1,"command_word":"state","content":[{"type":"text","value":"The computer has an operating system and utility software."},{"type":"text","value":"State the need for utility software in a computer."}],"answer":{"guidance":[{"type":"list","items":["1 mark from: performs housekeeping actions","monitors/manages/maintains a computer system","helps the computer run smoothly/efficiently","diagnoses/fixes/identifies problems with a computer system.","Do not award an example of utility software on its own (e.g. defragmentation or file management)."]}],"marks_breakdown":[{"criteria":"Valid statement of the need for utility software (e.g. housekeeping/maintenance, helps computer run efficiently, diagnose/fix problems)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-030.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-b.png"}},{"question_id":"5(c)(i)","parent_question":5,"topic":"client-server client","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"The artist uploads images to be displayed on a website. This is a client-server relationship."},{"type":"text","value":"Identify the computer that is acting as the client in this scenario and justify your choice."},{"type":"text","value":"Client computer: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identification: the artist's computer / computer uploading the images (BOD 'the artist')."},{"type":"list","items":["If the computer is incorrect, do not award the justification.","If 'user's computer' is given, this is not enough but read on for the justification","'user viewing the website' is incorrect.","Be careful the justification is about uploading images to the web server, not downloading.","Accept 'host' for web server.","Accepted justifications: sends the files/data for storage / to the host / web server","the files are stored on the web server","performs the user's actions and sends the results to the web server","sends a request to the web server to store/upload its files","it does not store data for others to access","confirmation of upload or an error is received from the server for display."]},{"type":"text","value":"1 mark each to max 2 for justification."}],"marks_breakdown":[{"criteria":"Client identified as the artist's computer / the computer uploading the images","marks":1},{"criteria":"Justification point 1 (e.g. sends files/data to the web server for storage, or sends an upload request)","marks":1},{"criteria":"Justification point 2 (e.g. does not store data for others to access, or receives confirmation/error from the server)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-011.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-032.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-c-i.png"}},{"question_id":"5(c)(ii)","parent_question":5,"topic":"client-server server","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Identify the computer that is acting as the server in this scenario and justify your choice."},{"type":"text","value":"Server computer: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identification: web server."},{"type":"list","items":["If the computer named is incomplete or inaccurate (e.g. 'server' or 'website' instead of web server), do not award the identification mark but award the justification","allow follow-through in the justification if the same inaccurate term is used (e.g. 'images are sent to the website').","1 mark each to max 2 for justification: the images/data are stored on / uploaded to / sent to / hosted on the web server","web server receives a request (from the artist's computer to upload the images)","web server executes / responds to the request / is doing the processing or handling of the upload","web server returns confirmation or error of the processing/upload."]}],"marks_breakdown":[{"criteria":"Server identified as web server","marks":1},{"criteria":"Justification point 1 (e.g. images are stored/uploaded to/hosted on the web server, or server receives the upload request)","marks":1},{"criteria":"Justification point 2 (e.g. web server processes the upload, or returns confirmation/error to the client)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-011.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-033.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-c-ii.png"}},{"question_id":"5(d)(i)","parent_question":5,"topic":"proprietary software benefits","marks":4,"command_word":"describe","content":[{"type":"text","value":"An artist is working with a programmer on the development of a new piece of software."},{"type":"text","value":"The software will allow users to edit images on devices such as mobile telephones."},{"type":"text","value":"They are considering releasing the software as open source instead of proprietary."},{"type":"text","value":"Describe two benefits to the artist and programmer of releasing the software as proprietary."},{"type":"text","value":"Benefit 1: ____"},{"type":"text","value":"Benefit 2: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark each to max 4."},{"type":"list","items":["Do not award references to ownership/copyright because both proprietary and open source allow copyright of the code/program.","Accepted benefits (a point plus expansion): authors can earn money (e.g. by selling for a fee / using licences to stop unauthorised use)","no-one can see the code (e.g. users cannot edit/change the software / cannot insert malware / cannot be copied/resold/shared)","more control over intellectual property (e.g. restrict users, restrict what can be done with the software without permission)."]},{"type":"text","value":"Mark the answer as a whole. Benefits must be to the artist and programmer, not to the user."}],"marks_breakdown":[{"criteria":"Benefit 1 point (e.g. authors can earn money / no-one can see the code / more control over intellectual property)","marks":1},{"criteria":"Benefit 1 expansion (e.g. by selling for a fee or using licences; or code cannot be copied/resold; or restricting what users can do without permission)","marks":1},{"criteria":"Benefit 2 point (a second distinct benefit to the artist and programmer)","marks":1},{"criteria":"Benefit 2 expansion tied to that point","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-012.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-034.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-d-i.png"}},{"question_id":"5(d)(ii)","parent_question":5,"topic":"open source benefits","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe one benefit to the users of releasing the software as open source."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid point and 1 mark for a matching expansion."},{"type":"list","items":["Accepted point/expansion pairs: users can view/edit the (source) code / users can edit the program (to tailor/improve/adapt it to do what they need","so errors can be fixed by anyone","users can learn how the software works)","freely accessible (do not have to pay","can redistribute","with changes)."]},{"type":"text","value":"The benefit must be to the users (not to the artist and programmer)."}],"marks_breakdown":[{"criteria":"Valid benefit point to users (e.g. can view/edit the source code, or the software is freely accessible)","marks":1},{"criteria":"Matching expansion (e.g. can tailor/adapt it to their needs, fix errors, learn from it, or don't have to pay / can redistribute)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-012.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-033.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-d-ii.png"}},{"question_id":"6","parent_question":6,"topic":"facial recognition impact","marks":8,"command_word":"discuss","content":[{"type":"text","value":"A shopping centre has a security system that includes CCTV cameras to record activities in the centre. The security system is being upgraded to include the use of facial recognition to identify, track the movements of and record individuals throughout the shopping centre."},{"type":"text","value":"Discuss the positive and negative impacts of this upgrade including:"},{"type":"text","value":"- ethical issues\\n- privacy issues\\n- legal issues"}],"answer":{"guidance":[{"type":"text","value":"Levels-of-response banded mark scheme."},{"type":"table","headers":["Mark band","Marks","Descriptor"],"rows":[["Mark Band 3 - High Level","6-8","candidate demonstrates thorough knowledge and understanding of a wide range of considerations; material is accurate and detailed; applies knowledge consistently to the shopping-centre/facial-recognition context; evidence and examples are explicitly relevant; weighs up both sides with reference to the impact on all three areas (ethical, privacy, legal); well-developed line of reasoning, clear and logically structured, substantiated"],["Mark Band 2 - Mid Level","3-5","reasonable knowledge and understanding of a range of considerations; generally accurate but at times underdeveloped; applies knowledge to the context with one or two missed opportunities; examples mostly implicitly relevant; reasonable attempt to discuss impact; structured line of reasoning, mostly relevant and supported by some evidence"],["Mark Band 1 - Low Level","1-2","basic knowledge with limited understanding, some inaccuracies; limited attempt to apply knowledge; unsupported assertions; unstructured; limited evidence"],["0 marks","0","no attempt / response not worthy of credit"]]},{"type":"text","value":"Indicative content (not exhaustive; points may cover more than one issue)."},{"type":"text","value":"Legal issues:"},{"type":"list","items":["DPA must be followed or company could be fined (customers informed system is used; data held for specified time/reasons; data kept secure)","centre is private property so customers can choose not to enter","can identify people committing crimes (e.g. theft, used as evidence, makes sure correct people are caught)"]},{"type":"text","value":"Ethical issues:"},{"type":"list","items":["users feel safer because actions are monitored and help/action will be taken if needed","if users have not done anything wrong there is no reason to be tracked/recorded","users feel unsafe because they are being watched","users may be unaware they are being recorded and need to be informed / give consent","users do not know where the videos/data about them is stored or how it is used (DPA reference)"]},{"type":"text","value":"Privacy issues:"},{"type":"list","items":["users may feel it is an invasion of privacy","users are in a public place and can be legally recorded anyway","users may feel watched all the time","users have not given permission to be tracked","users may not know the system exists"]},{"type":"text","value":"Candidates should focus on the upgrade to facial recognition, not the existence of CCTV (CCTV is already in place)."}],"marks_breakdown":[{"criteria":"Band 1 (1-2 marks): basic knowledge with limited understanding, unsupported assertions, unstructured","marks":2},{"criteria":"Band 2 (3-5 marks): reasonable knowledge applied to context, some structure, most areas attempted","marks":3},{"criteria":"Band 3 (6-8 marks): thorough, balanced discussion across ethical, privacy and legal issues with well-developed reasoning and justified conclusions","marks":3}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-013.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-035.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-6.png"}},{"question_id":"7","parent_question":7,"topic":"embedded systems","marks":3,"command_word":"identify and explain","content":[{"type":"text","value":"A car comes with many embedded systems, for example parking sensors."},{"type":"text","value":"Identify one other embedded system that could be found in a car and explain why this is an embedded system."},{"type":"text","value":"Example embedded system: ____"},{"type":"text","value":"Explanation: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid example (anything reasonably within a car). If the example is not clearly an embedded system, read the explanation for justification (e.g. hazard lights could be embedded if automatically activated when the car crashes; award the example from the explanation if this occurs). 1 mark each to max 2 for explanation. If the justification is only generic features of an embedded system, max 1 for explanation. Do not award 'built into the car / larger machine' because this is stated in the question."},{"type":"text","value":"Accepted examples:"},{"type":"list","items":["auto lights","auto window wipers","sat nav / GPS","air-conditioning / climate control","radio / entertainment / infotainment / media system","lane assist","engine management system","auto-park","cruise control","auto-brake","follow-me","dashcam"]},{"type":"text","value":"Accepted explanations:"},{"type":"list","items":["limited functions (e.g. only checks the light and turns lights on/off)","dedicated microprocessor (e.g. a microprocessor only checking the lights)","hard to change function (e.g. user cannot make the light system do any other role)"]}],"marks_breakdown":[{"criteria":"Valid embedded system example within a car (e.g. auto lights, sat nav, cruise control, engine management)","marks":1},{"criteria":"Explanation point 1 (e.g. has a limited/single function, or a dedicated microprocessor, or hard to change its function)","marks":1},{"criteria":"Explanation point 2 (a second distinct feature of embedded systems applied to the chosen example)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-014.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-037.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-7.png"}}]`),n3={"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf"},i3={paper_id:Xj,qualification:Yj,component:Kj,title:Zj,year:e3,session:t3,total_marks:a3,questions:r3,maps:n3},s3="J277-01-2019-Practice",o3="J277",c3="01",l3="Computer Systems",d3=2019,u3="Practice",p3=80,h3=JSON.parse(`[{"question_id":"1(a)(i)","parent_question":1,"topic":"character set definition","marks":1,"command_word":"state","content":[{"type":"text","value":"The ASCII code for the character J is the denary number 74."},{"type":"text","value":"State what is meant by a character set."}],"answer":{"guidance":"1 mark for a definition that explains a character set as all the different characters a computer can represent. Do not award 'the set of characters' as this repeats the question.","marks_breakdown":[{"criteria":"Definition e.g. all the different characters a computer can represent","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-a-i.png"}},{"question_id":"1(a)(ii)","parent_question":1,"topic":"ASCII character capacity","marks":1,"command_word":"identify","content":[{"type":"text","value":"ASCII has 8 bits per character."},{"type":"text","value":"Identify the maximum number of different characters that ASCII can represent."}],"answer":{"guidance":"Correct answer only: 256.","marks_breakdown":[{"criteria":"Correct answer: 256","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-a-ii.png"}},{"question_id":"1(a)(iii)","parent_question":1,"topic":"file size calculation","marks":2,"command_word":"calculate","content":[{"type":"text","value":"A text file uses the ASCII character set. The text file has 2000 characters in it."},{"type":"text","value":"Calculate an estimate of the file size of the text file in Kilobytes. Show your working."}],"answer":{"guidance":"1 mark for working, 1 mark for answer. Example working: 2000 * 8 = 16000 bits; 16000 / 8 = 2000 bytes; 2000 / 1000 = 2 Kilobytes. Ignore any overheads e.g. adding 10%.","marks_breakdown":[{"criteria":"Working shown (e.g. 2000 * 8 = 16000 bits, then / 8 = 2000 bytes, then / 1000)","marks":1},{"criteria":"Correct answer: 2 Kilobytes","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-a-iii.png"}},{"question_id":"1(a)(iv)","parent_question":1,"topic":"alternative character set","marks":1,"command_word":"identify","content":[{"type":"text","value":"Identify one other character set."}],"answer":{"guidance":"1 mark for naming another character set. Accept: UNICODE.","marks_breakdown":[{"criteria":"UNICODE (or Unicode)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-a-iv.png"}},{"question_id":"1(b)","parent_question":1,"topic":"ASCII binary conversion","marks":1,"command_word":"write","content":[{"type":"text","value":"Write the 8-bit binary number for the ASCII character J in the following boxes:"}],"answer":{"guidance":"Correct answer only (cao): 01001010.","marks_breakdown":[{"criteria":"Correct answer: 01001010","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-b.png"}},{"question_id":"1(c)","parent_question":1,"topic":"hexadecimal conversion","marks":2,"command_word":"give","content":[{"type":"text","value":"Give the hexadecimal number for the ASCII character K."},{"type":"text","value":"Show your working."}],"answer":{"guidance":"1 mark for adding 1 to J (binary 01001011) or showing the conversion from J to hexadecimal and adding 1. 1 mark for the final answer 4B. Allow 1 mark only for converting J to 4A without adding 1.","marks_breakdown":[{"criteria":"Adds 1 to J (binary 01001011) / converts J to hex then adds 1","marks":1},{"criteria":"Correct answer: 4B","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-003.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-c.png"}},{"question_id":"1(d)","parent_question":1,"topic":"binary shift multiplication","marks":2,"command_word":"identify","content":[{"type":"text","value":"A binary shift can be performed on a binary integer."},{"type":"text","value":"Identify which shift will multiply a number by 8."}],"answer":{"guidance":"1 mark for left, 1 mark for 3 places. Ignore any reference to arithmetic/logical.","marks_breakdown":[{"criteria":"Left (shift direction)","marks":1},{"criteria":"3 places","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-003.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-d.png"}},{"question_id":"2","parent_question":2,"topic":"digital technology in medicine","marks":8,"command_word":"discuss","content":[{"type":"text","value":"*The use of digital technology in medicine is constantly evolving."},{"type":"text","value":"Discuss the impact of digital technology on medicine including:"},{"type":"text","value":"- diagnosing patients\\n- treating patients\\n- storage of records."}],"answer":{"guidance":[{"type":"text","value":"Banded mark scheme."},{"type":"table","headers":["Band","Marks","Guidance"],"rows":[["Band 3","6-8 marks","thorough knowledge and understanding of a wide range of considerations; material is accurate and detailed; applies knowledge directly and consistently to the context; weighs both sides of the discussion; well-developed, logically structured line of reasoning"],["Band 2","3-5 marks","reasonable knowledge; material generally accurate but at times underdeveloped; applies knowledge directly but misses one or two opportunities; line of reasoning with some structure"],["Band 1","1-2 marks","basic knowledge with limited understanding; unsupported assertions; unstructured communication"],["0 marks","0 marks","no attempt or response not worthy of credit"]]},{"type":"text","value":"Indicative content (not prescriptive):"},{"type":"table","headers":["Area","Indicative content"],"rows":[["Diagnosis","search records faster, identify range of possibilities based on symptoms, identify patterns, more accurate/automated/AI equipment, may miss some symptoms or suggest incorrect results"],["Treating","AI/automated surgery (can be controlled from another country), access to specialists who are not local, technology may be subject to hacking, software errors could have fatal consequences, may have little human interaction"],["Storage","centralised storage, all medical staff can access all information about patients from all people involved in care, concerns over privacy and security of data e.g. personal information may be leaked if storage is accessed"]]}],"marks_breakdown":[{"criteria":"Band 1 (1-2 marks): Basic knowledge with limited understanding; unsupported assertions; unstructured communication","marks":2},{"criteria":"Band 2 (3-5 marks): Reasonable knowledge across a range of considerations; applies knowledge to context with one or two omissions; line of reasoning with some structure","marks":3},{"criteria":"Band 3 (6-8 marks): Thorough, detailed knowledge across diagnosis, treatment and storage; balanced discussion with weighing of both sides; well-developed, logically structured reasoning","marks":3}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-014.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-2.png"}},{"question_id":"3(a)(i)","parent_question":3,"topic":"CPU components identification","marks":4,"command_word":"tick","content":[{"type":"text","value":"The table has five components of a computer, and four statements."},{"type":"text","value":"Tick one or more boxes in each row to identify which component(s) each statement describes."},{"type":"table","headers":["Statement","MAR","MDR","Cache","Program Counter","RAM"],"rows":[["It stores a single address","","","","",""],["It stores frequently used instructions","","","","",""],["It is a register","","","","",""],["It stores all currently running data and instructions","","","","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for correct ticks and gaps on each row. If any extra ticks on a row, 0 marks for that row."},{"type":"table","headers":["Row","Statement","Correct ticks"],"rows":[["Row 1","It stores a single address","tick MAR only"],["Row 2","It stores frequently used instructions","tick Cache only"],["Row 3","It is a register","tick MAR, MDR and Program Counter"],["Row 4","It stores all currently running data and instructions","tick RAM only"]]}],"marks_breakdown":[{"criteria":"Row 1 correct: MAR ticked only (for 'It stores a single address')","marks":1},{"criteria":"Row 2 correct: Cache ticked only (for 'It stores frequently used instructions')","marks":1},{"criteria":"Row 3 correct: MAR, MDR and Program Counter all ticked (for 'It is a register')","marks":1},{"criteria":"Row 4 correct: RAM ticked only (for 'It stores all currently running data and instructions')","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-005.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-016.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-3-a-i.png"}},{"question_id":"3(a)(ii)","parent_question":3,"topic":"register name and purpose","marks":2,"command_word":"identify and describe","content":[{"type":"text","value":"Identify the name of one register not given in part (i) and describe its purpose."},{"type":"text","value":"Register: ____"},{"type":"text","value":"Purpose: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for naming a valid register (e.g. Accumulator / ACC / Current Instruction Register / CIR). 1 mark for a matching description of its purpose."},{"type":"list","items":["Accumulator stores the result of arithmetic operations","CIR stores the instruction currently being decoded/executed"]}],"marks_breakdown":[{"criteria":"Valid register named (e.g. Accumulator / CIR)","marks":1},{"criteria":"Matching description of purpose (e.g. stores the result of arithmetic operations)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-005.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-016.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-3-a-ii.png"}},{"question_id":"3(b)","parent_question":3,"topic":"clock speed and performance","marks":2,"command_word":"explain","content":[{"type":"text","value":"Computer A has a single core, 3.2 GHz processor."},{"type":"text","value":"Computer B has a single core, 1.2 GHz processor."},{"type":"text","value":"Explain why Computer A will usually run faster than Computer B."}],"answer":{"guidance":[{"type":"text","value":"1 mark per bullet to max 2. Points:"},{"type":"list","items":["Computer A has a faster/higher clock speed","3.2 GHz will run more Fetch-Execute (F-E) cycles per second","therefore more instructions can be executed per second (by calculation)"]}],"marks_breakdown":[{"criteria":"Computer A has a faster/higher clock speed, so it runs more Fetch-Execute cycles per second","marks":1},{"criteria":"Therefore more instructions can be executed per second","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-005.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-016.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-3-b.png"}},{"question_id":"4","parent_question":4,"topic":"embedded systems","marks":4,"command_word":"complete","content":[{"type":"text","value":"The following paragraph describes embedded systems."},{"type":"text","value":"Complete the paragraph by selecting terms from the list and writing them in the correct places. Not all terms are used."},{"type":"text","value":"Terms: actuator, applications, change, functions, laptop, larger, lights, microprocessor, processor, range, smaller, washing machine"},{"type":"text","value":"Embedded systems have limited ____. They are often built into a ____ machine. Two examples of embedded systems are a ____ and automated ____ in a car."}],"answer":{"guidance":"1 mark for each completed term. Gap 1: functions. Gap 2: larger. Gap 3: washing machine. Gap 4: lights.","marks_breakdown":[{"criteria":"Gap 1: functions","marks":1},{"criteria":"Gap 2: larger","marks":1},{"criteria":"Gap 3: washing machine","marks":1},{"criteria":"Gap 4: lights","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-006.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-017.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-4.png"}},{"question_id":"5(a)","parent_question":5,"topic":"image storage true or false","marks":2,"command_word":"tick","content":[{"type":"text","value":"Layla is an artist. She draws images by hand. The image is then scanned and stored on a computer."},{"type":"text","value":"The table has four statements about the storage of images on a computer."},{"type":"text","value":"Tick one box in each row to identify if the statement is true or false."},{"type":"table","headers":["Statement","True","False"],"rows":[["Each colour has a unique binary code","",""],["Metadata stores the colour of each pixel in the image","",""],["A bitmap is made of pixels","",""],["The higher the colour depth, the smaller the number of different colours that can be displayed","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for 2 correct ticks; 2 marks for all 4 correct ticks. Two ticks in one row is incorrect. Correct answers:"},{"type":"table","headers":["Statement","Answer"],"rows":[["Each colour has a unique binary code","True"],["Metadata stores the colour of each pixel in the image","False"],["A bitmap is made of pixels","True"],["The higher the colour depth, the smaller the number of different colours that can be displayed","False"]]}],"marks_breakdown":[{"criteria":"At least 2 of the 4 rows ticked correctly (True for 'unique binary code' and 'bitmap is made of pixels'; False for 'metadata stores the colour of each pixel' and 'higher colour depth, smaller number of colours')","marks":1},{"criteria":"All 4 rows ticked correctly","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-018.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-a.png"}},{"question_id":"5(b)(i)","parent_question":5,"topic":"storage capacity calculation","marks":2,"command_word":"calculate","content":[{"type":"text","value":"Layla stores her images on a secondary storage device."},{"type":"text","value":"Each image has a fixed size of 1 MB. The storage device has a capacity of 3 GB."},{"type":"text","value":"Calculate how many images can be saved on the storage device. Show your working."}],"answer":{"guidance":"1 mark for working, 1 mark for answer. Working: 1000 * 3 (there are 1000 MB in 1 GB, so 3 GB = 3000 MB). Answer: 3000 images.","marks_breakdown":[{"criteria":"Working shown (e.g. 1000 * 3, or 3 GB = 3000 MB)","marks":1},{"criteria":"Correct answer: 3000 images","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-018.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-b-i.png"}},{"question_id":"5(b)(ii)","parent_question":5,"topic":"storage device selection","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Layla uses the images to make videos. These videos are stored on her computer's internal storage device."},{"type":"text","value":"Identify the most appropriate type of storage device for Layla to use in her computer. Justify your choice."},{"type":"text","value":"Type of storage device: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for a suitable type: solid state or magnetic. Then 1 mark per bullet of justification to max 2, with points matching the chosen type."},{"type":"table","headers":["Type","Justifications"],"rows":[["Solid state","large enough capacity; can move computer without damaging storage; faster access speeds"],["Magnetic","largest capacity; computer is not moved so moving parts do not matter; more reliable long-term"]]}],"marks_breakdown":[{"criteria":"Suitable type identified: solid state or magnetic","marks":1},{"criteria":"Justification point 1 matching the chosen type (e.g. solid state: faster access / not damaged when moved; magnetic: largest capacity / reliable long-term)","marks":1},{"criteria":"Justification point 2 matching the chosen type","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-018.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-b-ii.png"}},{"question_id":"5(b)(iii)","parent_question":5,"topic":"sound storage true or false","marks":3,"command_word":"tick","content":[{"type":"text","value":"The videos include sound. The table has statements about the storage of sound in a computer."},{"type":"text","value":"Tick one box in each row to identify if the statement is true or false."},{"type":"table","headers":["Statement","True","False"],"rows":[["The sample rate is the number of times the amplitude is recorded per second","",""],["The smaller the bit depth the smaller the range of sounds recorded","",""],["The larger the sample rate the larger the bit depth","",""],["The frequency and pitch of the sound wave are measured","",""],["Sound is stored using pixels","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for 2 correct ticks; 2 marks for 3 or 4 correct ticks; 3 marks for all 5 correct. Two ticks in one row is incorrect. Correct answers:"},{"type":"table","headers":["Statement","Answer"],"rows":[["sample rate is number of times amplitude is recorded per second","True"],["smaller the bit depth, smaller the range of sounds recorded","True"],["larger sample rate means larger bit depth","False"],["frequency and pitch of the sound wave are measured","False"],["sound is stored using pixels","False"]]}],"marks_breakdown":[{"criteria":"At least 2 rows ticked correctly","marks":1},{"criteria":"At least 3 or 4 rows ticked correctly","marks":1},{"criteria":"All 5 rows ticked correctly (True, True, False, False, False in order)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-019.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-b-iii.png"}},{"question_id":"5(c)(i)","parent_question":5,"topic":"compression reasons","marks":2,"command_word":"explain","content":[{"type":"text","value":"Layla uploads her images and videos to a website."},{"type":"text","value":"Explain why Layla compresses the images and videos before uploading them."}],"answer":{"guidance":[{"type":"text","value":"1 mark per bullet to max 2. Points:"},{"type":"list","items":["reduces the file size","takes up less space on the server","faster upload to server","faster download for users"]}],"marks_breakdown":[{"criteria":"Reduces file size / takes up less space on the server","marks":1},{"criteria":"Faster upload to server / faster download for users","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-019.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-c-i.png"}},{"question_id":"5(c)(ii)","parent_question":5,"topic":"compression method choice","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Layla wants to reduce the file size of the images and videos by the largest amount possible."},{"type":"text","value":"Identify the method of compression that would be most appropriate. Justify your choice."},{"type":"text","value":"Compression method: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for lossy. 1 mark per bullet of justification to max 2. Justifications:"},{"type":"list","items":["lossy will most likely reduce the file size by a larger amount than lossless","lossy will remove data that is not noticeable, so changes allow further reduction without the user noticing"]},{"type":"text","value":"Award follow-through marks for justifying lossless appropriately to max 2."}],"marks_breakdown":[{"criteria":"Compression method: lossy","marks":1},{"criteria":"Justification point 1 (e.g. lossy reduces file size by a larger amount than lossless)","marks":1},{"criteria":"Justification point 2 (e.g. lossy removes data that is not noticeable / user will not notice the changes)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-019.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-c-ii.png"}},{"question_id":"5(d)","parent_question":5,"topic":"copyright legislation","marks":1,"command_word":"identify","content":[{"type":"text","value":"Layla wants to protect her images so they cannot be copied by other people."},{"type":"text","value":"Identify which legislation can help protect Layla's images."}],"answer":{"guidance":"1 mark for naming the relevant legislation: Copyright, Designs and Patents Act.","marks_breakdown":[{"criteria":"Copyright, Designs and Patents Act","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-018.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-5-d.png"}},{"question_id":"6(a)","parent_question":6,"topic":"network type identification","marks":1,"command_word":"identify","content":[{"type":"text","value":"Amir has a home network that includes two laptop computers, four mobile phones, and two televisions."},{"type":"text","value":"Identify the type of network Amir has at home."}],"answer":{"guidance":"1 mark for LAN or Local Area Network.","marks_breakdown":[{"criteria":"LAN / Local Area Network","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-020.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-6-a.png"}},{"question_id":"6(b)(i)","parent_question":6,"topic":"switch vs router","marks":6,"command_word":"describe","content":[{"type":"text","value":"The network uses a star topology with a central switch. The switch has an integrated wireless access point (WAP)."},{"type":"text","value":"Describe the similarities and differences between a switch and a router."},{"type":"text","value":"Similarities: ____"},{"type":"text","value":"Differences: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark per bullet. Maximum 4 marks for similarities and maximum 4 marks for differences, overall total 6."},{"type":"text","value":"Similarities:"},{"type":"list","items":["they both connect devices","they receive data from the devices","they determine the correct destination for the data","they transmit the data to its destination"]},{"type":"text","value":"Differences:"},{"type":"list","items":["a switch uses MAC addresses","a router uses IPs","a switch connects nodes/computers","a router connects networks/Internet","a router stores the addresses of devices attached","a switch records the addresses as they are accessed (a switch has to look for the correct address before sending)"]}],"marks_breakdown":[{"criteria":"Similarity: both connect devices / receive data from devices","marks":1},{"criteria":"Similarity: determine the correct destination / transmit data to its destination","marks":1},{"criteria":"Difference: a switch uses MAC addresses, a router uses IP addresses","marks":1},{"criteria":"Difference: a switch connects nodes/computers within a network; a router connects networks / connects to the Internet","marks":1},{"criteria":"Difference: a router stores the addresses of devices attached to it","marks":1},{"criteria":"Difference: a switch records addresses as they are accessed / has to look up the correct address before sending","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-020.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-6-b-i.png"}},{"question_id":"6(b)(ii)","parent_question":6,"topic":"star topology diagram","marks":3,"command_word":"draw","content":[{"type":"text","value":"Draw the star topology for Amir's home network. Clearly label each device."},{"type":"text","value":"[Student response: hand-drawn diagram — capture via canvas or upload]"}],"answer":{"guidance":[{"type":"text","value":"This is a hand-drawn diagram question — mark the diagram, not prose. 1 mark per bullet. Required:"},{"type":"list","items":["a clearly labelled switch at the centre","the correct set of devices (2 laptops, 4 phones, 2 TVs)","every device connected to the switch and to nothing else"]}],"marks_breakdown":[{"criteria":"Clearly labelled switch at the centre of the topology","marks":1},{"criteria":"Correct devices shown: 2 laptops, 4 mobile phones, 2 televisions","marks":1},{"criteria":"All devices connected directly to the switch and nothing else (no other interconnections)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-020.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-6-b-ii.png"}},{"question_id":"6(c)","parent_question":6,"topic":"network security table","marks":6,"command_word":"complete","content":[{"type":"text","value":"Amir wants to protect the computers on his network from threats such as unauthorised access."},{"type":"text","value":"The following incomplete table contains a form of attack, description and method of preventing each attack."},{"type":"text","value":"Complete the table by writing the missing Forms of attack, Descriptions and Methods of prevention."},{"type":"table","headers":["Form of attack","Description of attack","Method of prevention"],"rows":[["","A program attempting all possible password combinations",""],["Data interception","",""],["","","Anti-virus"]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for each completed box (6 total)."},{"type":"table","headers":["Row","Completed boxes"],"rows":[["Row 1","Form of attack = Brute-force attack; Method of prevention = strong password / set number of password attempts / firewall"],["Row 2","Description = data transmission being read by an unauthorised user/program; Method of prevention = encryption"],["Row 3","Form of attack = Malware / Virus / Trojan (etc.); Description = software that damages/deletes data"]]}],"marks_breakdown":[{"criteria":"Row 1 form of attack: Brute-force attack","marks":1},{"criteria":"Row 1 method of prevention: strong password / set number of password attempts / firewall","marks":1},{"criteria":"Row 2 description: data transmission being read by an unauthorised user/program","marks":1},{"criteria":"Row 2 method of prevention: encryption","marks":1},{"criteria":"Row 3 form of attack: Malware / Virus / Trojan (etc.)","marks":1},{"criteria":"Row 3 description: software that damages or deletes data","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-021.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-6-c.png"}},{"question_id":"7(a)","parent_question":7,"topic":"defragmentation benefits","marks":3,"command_word":"explain",