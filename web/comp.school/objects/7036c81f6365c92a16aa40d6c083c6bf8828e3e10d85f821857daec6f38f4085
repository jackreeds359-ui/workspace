nt":[{"type":"text","value":"Add the following two 8-bit binary numbers."},{"type":"list","items":["10110100","01010011"]},{"type":"text","value":"Give your 8-bit answer and state whether an overflow has occurred."}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct 8-bit result. 1 mark for correctly stating overflow status."},{"type":"list","items":["Result = 00000111 (with carry out of the most significant bit).","Overflow has occurred. Accept 'yes, overflow' or equivalent.","Do not award the overflow mark if the candidate states no overflow."]}],"marks_breakdown":[{"criteria":"8-bit result = 00000111","marks":1},{"criteria":"States overflow has occurred","marks":1}]}},{"question_id":"1(d)","parent_question":1,"topic":"binary shift","marks":1,"command_word":"state","content":[{"type":"text","value":"State the effect of performing a logical left shift of 2 places on an 8-bit binary number."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a correct effect."},{"type":"list","items":["The number is multiplied by 4.","Accept: value becomes four times larger.","Accept: bits shifted off the left are lost / zeros added on the right.","Do not accept 'multiplied by 2' on its own."]}],"marks_breakdown":[{"criteria":"States the value is multiplied by 4 (or equivalent)","marks":1}]}},{"question_id":"1(e)","parent_question":1,"topic":"hex to denary","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe how to convert the hexadecimal value 7C to denary. Show your working."}],"answer":{"guidance":[{"type":"text","value":"1 mark for correct method shown. 1 mark for the correct final answer."},{"type":"list","items":["Method: 7 x 16 + 12 (or 7 x 16 + C where C = 12).","Final answer = 124.","Award full marks for a correct answer of 124 with valid working.","If only 124 is given with no working, award 1 mark."]}],"marks_breakdown":[{"criteria":"Correct method shown (7 x 16 + 12)","marks":1},{"criteria":"Final answer = 124","marks":1}]}},{"question_id":"2(a)","parent_question":2,"topic":"character sets","marks":2,"command_word":"write","content":[{"type":"text","value":"In ASCII, the character 'A' is represented by the denary value 65."},{"type":"text","value":"Write the 7-bit binary representation of the character 'M'."}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying the denary value 77. 1 mark for the correct 7-bit binary."},{"type":"list","items":["M is the 13th letter, so denary = 65 + 12 = 77.","7-bit binary = 1001101.","Accept 8-bit form 01001101 if the leading zero is included.","Award full marks for the correct binary even if denary working is not shown."]}],"marks_breakdown":[{"criteria":"Identifies denary value 77 for 'M'","marks":1},{"criteria":"7-bit binary = 1001101","marks":1}]}},{"question_id":"2(b)","parent_question":2,"topic":"character sets","marks":2,"command_word":"explain","content":[{"type":"text","value":"A company develops messaging applications used in many countries."},{"type":"text","value":"Explain why the company uses Unicode rather than ASCII to encode characters."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each distinct point, to a maximum of 2."},{"type":"list","items":["Unicode supports a much larger range of characters than ASCII.","Unicode can represent characters from many different writing systems / languages.","Unicode includes symbols and emoji used in modern messaging.","ASCII only encodes 128 characters, which is not enough for global use.","Do not award two marks for the same point reworded."]}],"marks_breakdown":[{"criteria":"First valid point about Unicode supporting more characters / languages","marks":1},{"criteria":"Second distinct valid point","marks":1}]}},{"question_id":"3(a)","parent_question":3,"topic":"secondary storage","marks":4,"command_word":"identify and justify","content":[{"type":"text","value":"A hospital archives patient X-ray scans for many years. The scans are large image files that must be kept reliably and rarely need to be edited."},{"type":"text","value":"Identify a suitable secondary storage device for this archive. Justify your choice with three points."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a suitable device. 1 mark for each justification point, to a maximum of 3."},{"type":"list","items":["Suitable device: magnetic tape. Accept: optical disc (Blu-ray / archival DVD), magnetic hard disk drive.","Justification points (any three): high storage capacity for large image files; low cost per gigabyte for long-term archive; long-lasting / durable medium suited to archival; portable so copies can be stored off-site; reliable when written once and stored carefully; suitable for write-once, read-rarely use.","Do not award justification marks if the device chosen is not a secondary storage device.","Do not credit speed of access for tape: archives prioritise capacity and cost."]}],"marks_breakdown":[{"criteria":"Identifies a suitable device (e.g. magnetic tape, optical disc, magnetic HDD)","marks":1},{"criteria":"First valid justification point","marks":1},{"criteria":"Second valid justification point","marks":1},{"criteria":"Third valid justification point","marks":1}]}},{"question_id":"3(b)(i)","parent_question":3,"topic":"compression","marks":1,"command_word":"state","content":[{"type":"text","value":"State one reason why files are compressed."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid reason."},{"type":"list","items":["To reduce the file size / use less storage space.","To reduce the time taken to transmit / download the file.","To use less bandwidth when sending the file.","Do not accept 'to make the file smaller' on its own without context."]}],"marks_breakdown":[{"criteria":"Gives one valid reason for compression","marks":1}]}},{"question_id":"3(b)(ii)","parent_question":3,"topic":"compression","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"A company creates a nightly backup of its customer database. The database contains text records only."},{"type":"text","value":"Identify whether lossless or lossy compression should be used. Justify your choice with two points."}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying lossless. 1 mark for each valid justification point, to a maximum of 2."},{"type":"list","items":["Correct choice: lossless.","Justification points (any two): no data is lost so the records remain accurate; the backup must be restored exactly to its original form; text data does not compress well with lossy methods; customer records may be required for legal or audit purposes and must be unchanged.","Do not award justification marks if the candidate has chosen lossy."]}],"marks_breakdown":[{"criteria":"Identifies lossless compression","marks":1},{"criteria":"First valid justification point","marks":1},{"criteria":"Second valid justification point","marks":1}]}},{"question_id":"3(b)(iii)","parent_question":3,"topic":"compression","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Customers upload scanned receipts as images to a finance app. The app needs to display the receipts on screen so the figures can still be read."},{"type":"text","value":"Identify whether lossless or lossy compression should be used. Justify your choice with two points."}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying lossy. 1 mark for each valid justification point, to a maximum of 2."},{"type":"list","items":["Correct choice: lossy.","Justification points (any two): a much smaller file size makes uploads faster on mobile data; less storage is needed on the company servers when many users upload daily; some image quality can be discarded as the figures only need to remain readable; lossy compression is well suited to photographic and scanned images.","Accept lossless if a strong justification is given (e.g. receipts may be needed as legal evidence) but only award the choice mark in that case if both justification points genuinely support lossless."]}],"marks_breakdown":[{"criteria":"Identifies lossy compression","marks":1},{"criteria":"First valid justification point","marks":1},{"criteria":"Second valid justification point","marks":1}]}},{"question_id":"3(c)","parent_question":3,"topic":"image file size","marks":2,"command_word":"calculate","content":[{"type":"text","value":"An uncompressed bitmap image is 200 pixels wide and 150 pixels tall. The colour depth is 8 bits per pixel."},{"type":"text","value":"Calculate the file size of the image. Give your answer in kilobytes (KB) to 2 decimal places. Use 1 KB = 1000 bytes."}],"answer":{"guidance":[{"type":"text","value":"1 mark for correct method shown. 1 mark for the correct final answer in KB to 2 d.p."},{"type":"list","items":["Method: 200 x 150 x 8 = 240000 bits, then divide by 8 to get 30000 bytes, then divide by 1000.","Final answer = 30.00 KB.","Accept 30 KB written as 30.00 KB.","Accept 29.30 KB if the candidate consistently uses 1 KB = 1024 bytes (award method mark and answer mark for that working).","If only the final answer is given with no working, award 1 mark."]}],"marks_breakdown":[{"criteria":"Correct method shown (width x height x colour depth, then converted to bytes / KB)","marks":1},{"criteria":"Final answer = 30.00 KB","marks":1}]}},{"question_id":"4(a)","parent_question":4,"topic":"LAN characteristics","marks":4,"command_word":"tick","content":[{"type":"text","value":"Four statements about a Local Area Network (LAN) are shown in the table."},{"type":"text","value":"Tick one box in each row to show whether the statement is true or false."},{"type":"table","headers":["Statement","True","False"],"rows":[["A LAN covers a small geographical area such as a single building or site.","",""],["A LAN always uses the public internet to connect its devices.","",""],["The hardware in a LAN is usually owned by the organisation that uses it.","",""],["Devices on a LAN cannot share files or printers with each other.","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correctly classified row to a maximum of 4. Do not award the mark if more than one box is ticked in a single row."},{"type":"list","items":["Row 1 ('small geographical area'): True.","Row 2 ('always uses the public internet'): False.","Row 3 ('hardware usually owned by the organisation'): True.","Row 4 ('cannot share files or printers'): False."]}],"marks_breakdown":[{"criteria":"Row 1 correctly identified as True","marks":1},{"criteria":"Row 2 correctly identified as False","marks":1},{"criteria":"Row 3 correctly identified as True","marks":1},{"criteria":"Row 4 correctly identified as False","marks":1}]}},{"question_id":"4(b)","parent_question":4,"topic":"network topology","marks":4,"command_word":"describe","content":[{"type":"text","value":"A school is replacing an older bus topology network with a star topology."},{"type":"text","value":"Describe two benefits of a star topology compared to a bus topology."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each benefit identified, plus 1 further mark for each benefit described in context."},{"type":"list","items":["Benefit 1: if one cable or device fails, only that device is affected (the rest of the network continues to work).","Benefit 2: better performance under heavy use because each device has its own dedicated connection to the switch (no shared bus / fewer collisions).","Benefit 3: easier to add or remove a device without disrupting the whole network.","Benefit 4: data is sent only to the intended device, improving security.","Each benefit must be a distinct point. Do not credit the same idea twice."]}],"marks_breakdown":[{"criteria":"First benefit identified","marks":1},{"criteria":"First benefit described / expanded","marks":1},{"criteria":"Second distinct benefit identified","marks":1},{"criteria":"Second benefit described / expanded","marks":1}]}},{"question_id":"4(c)","parent_question":4,"topic":"network protocols","marks":4,"command_word":"complete","content":[{"type":"text","value":"Complete the table by writing the most appropriate network protocol for each task."},{"type":"table","headers":["Task","Protocol"],"rows":[["Browsing a news website that does not require a login.",""],["Sending an email from a mail client to a mail server.",""],["Downloading a large file from a remote server.",""],["Logging in securely to an online banking website.",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct protocol to a maximum of 4."},{"type":"list","items":["Row 1 = HTTP.","Row 2 = SMTP.","Row 3 = FTP.","Row 4 = HTTPS.","Accept POP3 or IMAP for row 2 only if the candidate clearly describes retrieving rather than sending; otherwise SMTP only.","Do not accept 'TCP' or 'IP' as these are not application-layer protocols for these tasks."]}],"marks_breakdown":[{"criteria":"Row 1 protocol = HTTP","marks":1},{"criteria":"Row 2 protocol = SMTP","marks":1},{"criteria":"Row 3 protocol = FTP","marks":1},{"criteria":"Row 4 protocol = HTTPS","marks":1}]}},{"question_id":"4(d)","parent_question":4,"topic":"network hardware","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe the role of a router in a network."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each distinct point, to a maximum of 2."},{"type":"list","items":["Connects two or more separate networks together (for example, a home LAN to the internet).","Forwards data packets between networks based on their destination IP address.","Determines the most appropriate route for a packet to take.","Do not accept 'connects devices to the internet' on its own without reference to networks or packets."]}],"marks_breakdown":[{"criteria":"First valid point about the router's role","marks":1},{"criteria":"Second distinct valid point","marks":1}]}},{"question_id":"5(a)","parent_question":5,"topic":"virtual memory","marks":4,"command_word":"tick and rewrite","content":[{"type":"text","value":"A student has written four statements about virtual memory. Some of the statements are wrong."},{"type":"text","value":"Tick one box in each row to show whether the statement is true or false. For each statement that you mark as false, rewrite it in the final column so that it becomes correct."},{"type":"table","headers":["Statement","True","False","If false, rewrite to make it correct"],"rows":[["Virtual memory is an area of secondary storage used as if it were RAM.","","",""],["Virtual memory is faster to access than RAM.","","",""],["Virtual memory is used when the RAM becomes full.","","",""],["Programs that rely heavily on virtual memory will run more quickly than they would in RAM.","","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per row, to a maximum of 4. Award the mark either for ticking True on a true statement or for ticking False on a false statement together with a sensible rewrite. Do not award the mark for the rewrite alone if False has not been ticked."},{"type":"list","items":["Row 1: True. No rewrite required.","Row 2: False. Sample rewrite: 'Virtual memory is slower to access than RAM.'","Row 3: True. No rewrite required.","Row 4: False. Sample rewrite: 'Programs that rely heavily on virtual memory will run more slowly than they would in RAM.'","Accept any rewrite that conveys the correct meaning."]}],"marks_breakdown":[{"criteria":"Row 1 correctly identified as True","marks":1},{"criteria":"Row 2 identified as False with a sensible rewrite (e.g. virtual memory is slower than RAM)","marks":1},{"criteria":"Row 3 correctly identified as True","marks":1},{"criteria":"Row 4 identified as False with a sensible rewrite (e.g. programs run more slowly with heavy virtual memory use)","marks":1}]}},{"question_id":"5(b)","parent_question":5,"topic":"operating system","marks":3,"command_word":"explain","content":[{"type":"text","value":"A user runs several applications at the same time on a laptop."},{"type":"text","value":"Explain how the operating system manages multiple programs running at once."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each distinct point, to a maximum of 3. Look for points that show understanding of multitasking."},{"type":"list","items":["The operating system shares processor time between programs by allocating short time slices to each in turn.","The CPU switches rapidly between programs so it appears that they are running at the same time.","The operating system schedules processes based on priority so important tasks run first.","Each program is given its own area of memory so they do not interfere with each other.","Do not credit 'the OS runs the programs' on its own without further detail."]}],"marks_breakdown":[{"criteria":"First valid point about managing multiple programs","marks":1},{"criteria":"Second distinct valid point","marks":1},{"criteria":"Third distinct valid point","marks":1}]}},{"question_id":"5(c)(i)","parent_question":5,"topic":"utility software","marks":3,"command_word":"complete","content":[{"type":"text","value":"Complete the table by writing a one-line purpose for each utility tool."},{"type":"table","headers":["Utility tool","Purpose"],"rows":[["Defragmentation",""],["Backup",""],["Encryption",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct purpose to a maximum of 3."},{"type":"list","items":["Defragmentation: rearranges files on a magnetic disk so the parts of each file are stored together / contiguously.","Backup: creates a copy of files so they can be restored if the original is lost or corrupted.","Encryption: scrambles data so it can only be read by someone with the correct key.","Accept other clear, accurate one-line descriptions.","Do not accept 'makes the computer faster' for defragmentation on its own."]}],"marks_breakdown":[{"criteria":"Defragmentation purpose correct","marks":1},{"criteria":"Backup purpose correct","marks":1},{"criteria":"Encryption purpose correct","marks":1}]}},{"question_id":"5(c)(ii)","parent_question":5,"topic":"defragmentation","marks":2,"command_word":"state","content":[{"type":"text","value":"State two reasons why defragmentation can improve the performance of a computer."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each distinct reason, to a maximum of 2."},{"type":"list","items":["Files are stored together / contiguously so the read-write head moves less to access them.","Files can be opened more quickly because fewer disk accesses are needed.","Free space is consolidated so new files can be written without being split into many fragments.","Do not accept 'makes the computer faster' on its own."]}],"marks_breakdown":[{"criteria":"First valid reason","marks":1},{"criteria":"Second distinct valid reason","marks":1}]}},{"question_id":"6(a)","parent_question":6,"topic":"fetch-execute cycle","marks":3,"command_word":"describe","content":[{"type":"text","value":"Describe what happens during the fetch stage of the fetch-execute cycle."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each distinct point, to a maximum of 3."},{"type":"list","items":["The address of the next instruction is taken from the program counter and copied to the MAR.","The instruction at that memory address is copied from RAM into the MDR.","The instruction is then transferred to the CIR ready to be decoded.","The program counter is incremented to point to the next instruction.","Do not credit anything that describes only the decode or execute stage."]}],"marks_breakdown":[{"criteria":"First valid point about the fetch stage","marks":1},{"criteria":"Second distinct valid point","marks":1},{"criteria":"Third distinct valid point","marks":1}]}},{"question_id":"6(b)","parent_question":6,"topic":"CPU registers","marks":4,"command_word":"complete","content":[{"type":"text","value":"Complete the table by writing a one-line purpose for each CPU register."},{"type":"table","headers":["Register","Purpose"],"rows":[["Program Counter (PC)",""],["Memory Address Register (MAR)",""],["Memory Data Register (MDR)",""],["Accumulator (ACC)",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct purpose to a maximum of 4."},{"type":"list","items":["PC: holds the memory address of the next instruction to be fetched.","MAR: holds the memory address that is currently being read from or written to.","MDR: holds the data or instruction that has just been read from, or is about to be written to, memory.","ACC: stores the result of calculations performed by the ALU.","Accept equivalent wording that conveys the same meaning."]}],"marks_breakdown":[{"criteria":"PC purpose correct","marks":1},{"criteria":"MAR purpose correct","marks":1},{"criteria":"MDR purpose correct","marks":1},{"criteria":"ACC purpose correct","marks":1}]}},{"question_id":"6(c)","parent_question":6,"topic":"CPU performance","marks":3,"command_word":"explain","content":[{"type":"text","value":"A new desktop computer has a processor with multiple cores."},{"type":"text","value":"Explain how increasing the number of cores can improve performance. Include one limitation in your answer."}],"answer":{"guidance":[{"type":"text","value":"Up to 2 marks for explaining the performance benefit. 1 mark for a valid limitation."},{"type":"list","items":["Each core can fetch and execute its own instructions independently.","More tasks / threads can be processed at the same time (true parallel processing).","Multitasking is smoother because work can be shared across the cores.","Limitation: not all software is written to take advantage of multiple cores.","Limitation: some tasks cannot be split into parallel parts so extra cores give no benefit.","Limitation: more cores increase heat output and power consumption.","Do not award the limitation mark for 'cores cost more money' on its own."]}],"marks_breakdown":[{"criteria":"First valid point about how more cores improve performance","marks":1},{"criteria":"Second distinct valid point about performance","marks":1},{"criteria":"Valid limitation given","marks":1}]}},{"question_id":"7(a)","parent_question":7,"topic":"malware","marks":4,"command_word":"name and describe","content":[{"type":"text","value":"Name and describe two different forms of malware."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correctly named form of malware. 1 mark for each accurate description. The two forms must be distinct."},{"type":"list","items":["Virus: malicious code that attaches itself to a host file and spreads when that file is run.","Worm: self-replicating malware that spreads across a network without needing a host file.","Trojan: malware disguised as legitimate software that runs harmful code when opened.","Spyware: secretly records user activity (such as keystrokes) and sends the data to an attacker.","Ransomware: encrypts the user's files and demands a payment for the decryption key.","Do not credit 'phishing' as a form of malware (it is a social engineering technique)."]}],"marks_breakdown":[{"criteria":"First form of malware correctly named","marks":1},{"criteria":"First form of malware accurately described","marks":1},{"criteria":"Second distinct form of malware correctly named","marks":1},{"criteria":"Second form of malware accurately described","marks":1}]}},{"question_id":"7(b)","parent_question":7,"topic":"network security","marks":3,"command_word":"describe","content":[{"type":"text","value":"Describe how a brute force attack works and describe one method that can be used to prevent it."}],"answer":{"guidance":[{"type":"text","value":"Up to 2 marks for describing how the attack works. 1 mark for a valid prevention method described."},{"type":"list","items":["An attacker tries many possible passwords / keys in turn until the correct one is found.","The attempts are usually automated by software so a large number of guesses can be made quickly.","Often combinations are tried systematically or from a list of common passwords.","Prevention: lock the account after a small number of failed login attempts.","Prevention: enforce strong passwords (length, mix of characters) so the search space is much larger.","Prevention: use two-factor authentication so a password alone is not enough.","Prevention: add a CAPTCHA to slow down automated attempts.","Do not award the prevention mark for 'use a password' on its own."]}],"marks_breakdown":[{"criteria":"Describes that the attack tries many passwords / keys until one works","marks":1},{"criteria":"Adds further detail (automated software, systematic guessing or use of password lists)","marks":1},{"criteria":"Describes one valid prevention method","marks":1}]}},{"question_id":"8","parent_question":8,"topic":"smart speakers impact","marks":8,"command_word":"discuss","content":[{"type":"text","value":"A family installs smart speakers throughout their home, including the kitchen, the living room and the children's bedrooms. The speakers respond to voice commands, play music, control lights and order shopping."},{"type":"text","value":"Discuss the positive and negative impacts of using smart speakers in this way. Your answer should include:"},{"type":"list","items":["ethical issues","privacy issues","legal issues"]}],"answer":{"guidance":[{"type":"text","value":"Levels-of-response banded mark scheme."},{"type":"table","headers":["Mark band","Marks","Descriptor"],"rows":[["Mark Band 3 - High Level","6-8","Candidate demonstrates thorough knowledge and understanding of smart speakers in the home. The discussion covers all three required areas (ethical, privacy, legal) in depth, with both positive and negative impacts considered. Points are clearly linked to the family context and balanced judgements are made. Specialist terms are used accurately throughout. The response is well structured and clearly expressed."],["Mark Band 2 - Mid Level","3-5","Candidate demonstrates reasonable knowledge and understanding. At least two of the three required areas are addressed and some attempt is made to cover both positive and negative impacts. Points are mostly linked to the family context, although some may be generic. Some specialist terms are used. The response shows some structure."],["Mark Band 1 - Low Level","1-2","Candidate shows basic knowledge with limited understanding. The response covers only one of the three required areas, or makes only generic points without linking to the family context. Few or no specialist terms used. Little structure."],["0 marks","0","No attempt made or response not worthy of credit."]]},{"type":"text","value":"Indicative content (not exhaustive; points may cover more than one issue)."},{"type":"list","items":["Privacy: smart speakers contain always-listening microphones that wait for a wake word, so background conversations may be captured accidentally.","Privacy: voice recordings are sent to and stored on the manufacturer's servers, where the family has limited control over how long they are kept.","Privacy: third parties (such as skill / app developers or human reviewers employed to improve voice recognition) may gain access to recordings of the family.","Ethical: placing devices in children's bedrooms raises concerns because young children cannot give informed consent to being recorded.","Ethical: accidental activation can capture private moments such as arguments, medical conversations or visitors who never agreed to be recorded.","Ethical: voice profiles may be used to target the family with advertising, which some would consider manipulative.","Legal: under GDPR and the Data Protection Act 2018, the manufacturer must process voice data lawfully, fairly and transparently and only keep it for as long as necessary.","Legal: the family must agree to the terms of service, but children's data has additional protections under data protection law and parents are responsible for that consent.","Legal: recordings could potentially be requested by law enforcement under a court order, which the family may not expect.","Positive: convenience benefits such as setting timers, playing music and controlling lights without needing to use a screen.","Positive: accessibility benefits for family members with limited mobility or visual impairments who can use voice instead of touch.","Positive: automation of household tasks such as creating shopping lists or reading out reminders, which can save time for a busy family.","Negative: children may become reliant on the device and be exposed to content that has not been checked by parents.","Balanced judgement: the family can reduce risks by muting microphones, deleting recordings regularly and not placing devices in bedrooms, but some risk remains."]}],"marks_breakdown":[{"criteria":"Mark Band 1 (1-2 marks): Candidate shows basic knowledge with limited understanding. The response covers only one of the three required areas, or makes only generic points without linking to the family context. Few or no specialist terms used. Little structure.","marks":2},{"criteria":"Mark Band 2 (3-5 marks): Candidate demonstrates reasonable knowledge and understanding. At least two of the three required areas are addressed and some attempt is made to cover both positive and negative impacts. Points are mostly linked to the family context, although some may be generic. Some specialist terms are used. The response shows some structure.","marks":3},{"criteria":"Mark Band 3 (6-8 marks): Candidate demonstrates thorough knowledge and understanding of smart speakers in the home. The discussion covers all three required areas (ethical, privacy, legal) in depth, with both positive and negative impacts considered. Points are clearly linked to the family context and balanced judgements are made. Specialist terms are used accurately throughout. The response is well structured and clearly expressed.","marks":3}]}}]`),E3={paper_id:S3,qualification:A3,component:j3,title:O3,year:T3,session:P3,total_marks:J3,questions:I3},R3="J277-01-TeacherVariant-B",D3="J277",M3="01",N3="Computer Systems",L3=null,B3="TeacherVariant-B",F3=80,$3=JSON.parse(`[{"question_id":"1(a)","parent_question":1,"topic":"sound representation","marks":6,"command_word":"complete","content":[{"type":"text","value":"A music student records audio for a school podcast. The recording software stores sound digitally."},{"type":"text","value":"Complete the table below by giving a definition for each property and stating the effect on file size of increasing it."},{"type":"table","headers":["Property","Definition","Effect on file size of increasing this property"],"rows":[["Sample rate","",""],["Bit depth","",""],["Recording duration","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct cell, to a maximum of 6. Definitions must reference the audio context."},{"type":"list","items":["Sample rate definition: the number of samples taken per second (accept Hz / kHz reference).","Sample rate effect: file size increases (accept 'doubles if rate doubles').","Bit depth definition: the number of bits used to store each sample.","Bit depth effect: file size increases.","Recording duration definition: the length of the audio recorded, in seconds.","Recording duration effect: file size increases proportionally with duration.","Accept equivalent wording. Reject vague answers such as 'it is bigger' without linking to file size."]}],"marks_breakdown":[{"criteria":"Sample rate defined as samples per second","marks":1},{"criteria":"Sample rate increase causes larger file size","marks":1},{"criteria":"Bit depth defined as number of bits per sample","marks":1},{"criteria":"Bit depth increase causes larger file size","marks":1},{"criteria":"Recording duration defined as length of audio recorded","marks":1},{"criteria":"Duration increase causes larger file size","marks":1}]}},{"question_id":"1(b)(i)","parent_question":1,"topic":"image representation","marks":1,"command_word":"define","content":[{"type":"text","value":"Define the term pixel."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a definition referencing the smallest addressable element of an image."},{"type":"list","items":["Accept: the smallest single point of colour in an image.","Accept: a picture element making up a bitmap image.","Reject: 'a small dot' without reference to image or colour."]}],"marks_breakdown":[{"criteria":"Definition identifies a pixel as the smallest addressable element of a bitmap image","marks":1}]}},{"question_id":"1(b)(ii)","parent_question":1,"topic":"image file size","marks":2,"command_word":"calculate","content":[{"type":"text","value":"The student saves a photograph that is 1024 pixels wide by 768 pixels tall using a colour depth of 24 bits per pixel."},{"type":"text","value":"Calculate the file size of the image. Give your answer in megabytes (MB) and show your working."}],"answer":{"guidance":[{"type":"text","value":"1 mark for correct working, 1 mark for correct final answer in MB."},{"type":"list","items":["Working: 1024 x 768 x 24 = 18 874 368 bits.","Convert to bytes: 18 874 368 / 8 = 2 359 296 bytes.","Convert to MB: 2 359 296 / 1 048 576 = 2.25 MB.","Accept 2.25 MB or 2.36 MB if the student uses 1 000 000 bytes per MB.","Award full marks for the correct final value even if working is shown only as a calculator expression."]}],"marks_breakdown":[{"criteria":"Correct working: width x height x bit depth, then divide by 8","marks":1},{"criteria":"Correct final answer of 2.25 MB (or 2.36 MB equivalent)","marks":1}]}},{"question_id":"1(b)(iii)","parent_question":1,"topic":"colour depth","marks":1,"command_word":"state","content":[{"type":"text","value":"State the effect on the quality of the image of doubling the colour depth."}],"answer":{"guidance":[{"type":"text","value":"1 mark for any valid effect on quality."},{"type":"list","items":["Accept: more colours can be represented per pixel, so image quality improves.","Accept: greater range of shades / more accurate colour reproduction.","Reject: answers that only mention file size without referencing quality."]}],"marks_breakdown":[{"criteria":"Identifies that doubling colour depth allows more colours and improves image quality","marks":1}]}},{"question_id":"1(c)","parent_question":1,"topic":"secondary storage","marks":4,"command_word":"identify and justify","content":[{"type":"text","value":"A wildlife photographer travels to a remote forest for two weeks. There is no internet connection and limited mains power. The photographer needs secondary storage for thousands of high resolution photos."},{"type":"text","value":"Identify the most suitable type of secondary storage and justify your choice with three points."}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying a suitable storage type, plus up to 3 marks for justification points relevant to the scenario."},{"type":"list","items":["Identification: solid state storage (SSD) or flash memory (e.g. SD card / portable SSD).","Justification 1: low power consumption, important when mains power is limited.","Justification 2: durable / no moving parts, suitable for travel in a remote forest.","Justification 3: high capacity available, can store thousands of high resolution photos.","Justification 4: small and lightweight, easy to carry.","Justification 5: fast read and write speeds for large image files.","Accept magnetic (portable HDD) only if all justifications are valid (e.g. high capacity, low cost per GB).","Reject optical (CD/DVD/Blu-ray): capacity too low, fragile, requires drive."]}],"marks_breakdown":[{"criteria":"Identifies a suitable secondary storage type (e.g. solid state / flash)","marks":1},{"criteria":"First valid justification linked to the scenario","marks":1},{"criteria":"Second valid justification linked to the scenario","marks":1},{"criteria":"Third valid justification linked to the scenario","marks":1}]}},{"question_id":"2(a)","parent_question":2,"topic":"operating system","marks":5,"command_word":"tick","content":[{"type":"text","value":"An operating system performs a number of tasks for the user."},{"type":"text","value":"Tick one box in each row to identify which operating system function performs each task."},{"type":"table","headers":["Task","Memory management","File management","Peripheral management","User interface","User accounts"],"rows":[["Allocating RAM space to a new program when it is opened.","","","","",""],["Allowing a user to drag and drop a document into a folder.","","","","",""],["Installing a driver so a new printer can be used.","","","","",""],["Displaying icons, windows and menus on the screen.","","","","",""],["Requiring a username and password before granting access.","","","","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct row. Do not award the mark if more than one box is ticked on a row."},{"type":"list","items":["Row 1 (allocating RAM space): Memory management.","Row 2 (drag and drop a document): File management.","Row 3 (installing a printer driver): Peripheral management.","Row 4 (displaying icons and windows): User interface.","Row 5 (username and password): User accounts."]}],"marks_breakdown":[{"criteria":"Row 1 identified as Memory management","marks":1},{"criteria":"Row 2 identified as File management","marks":1},{"criteria":"Row 3 identified as Peripheral management","marks":1},{"criteria":"Row 4 identified as User interface","marks":1},{"criteria":"Row 5 identified as User accounts","marks":1}]}},{"question_id":"2(b)","parent_question":2,"topic":"utility software","marks":3,"command_word":"explain","content":[{"type":"text","value":"An employee uses encryption software on their work laptop. The laptop is later stolen from a cafe."},{"type":"text","value":"Explain how the encryption software protects the data stored on the laptop."}],"answer":{"guidance":[{"type":"text","value":"Up to 3 marks for a clear explanation linking encryption to data protection on the stolen laptop."},{"type":"list","items":["Encryption converts the data on the laptop into ciphertext using a key / algorithm.","Without the correct decryption key, the thief sees only scrambled data that is unreadable.","Even if the storage drive is removed and read on another machine, the data remains protected.","The original data is only restored when the authorised user supplies the correct key.","Accept reference to symmetric or asymmetric keys."]}],"marks_breakdown":[{"criteria":"Identifies that encryption scrambles data into ciphertext using a key","marks":1},{"criteria":"Explains that without the key the data is unreadable to the thief","marks":1},{"criteria":"Links the protection back to the stolen laptop scenario (e.g. drive removal still safe)","marks":1}]}},{"question_id":"3","parent_question":3,"topic":"self-driving delivery vehicles","marks":8,"command_word":"discuss","content":[{"type":"text","value":"A national retailer is replacing its human delivery drivers with self-driving electric vans for last-mile parcel delivery in towns and cities."},{"type":"text","value":"Discuss the positive and negative impacts of this decision. Your answer should include:"},{"type":"list","items":["ethical issues","legal issues","environmental issues"]}],"answer":{"guidance":[{"type":"text","value":"Levels-of-response banded mark scheme."},{"type":"table","headers":["Mark band","Marks","Descriptor"],"rows":[["Mark Band 3 - High Level","6-8","thorough knowledge and understanding of the impact of self-driving delivery vans, with a balanced discussion that covers all three bullets (ethical, legal, environmental) using clear context-specific points and well reasoned conclusions; technical terms used accurately"],["Mark Band 2 - Mid Level","3-5","reasonable knowledge and understanding with a discussion that covers at least two of the bullets; some context to the retailer scenario; conclusions are limited or one sided"],["Mark Band 1 - Low Level","1-2","basic knowledge with isolated points; little or no context-specific discussion; few or no technical terms"],["0 marks","0","no attempt / response not worthy of credit"]]},{"type":"text","value":"Indicative content (not exhaustive; points may cover more than one issue)."},{"type":"list","items":["Ethical: job displacement of human delivery drivers leading to unemployment in the local area.","Ethical: programmed decision making in unavoidable accidents (e.g. trolley problem analogues) raises questions about who is held responsible.","Ethical: reduced human contact for vulnerable customers who relied on the daily interaction with their driver.","Legal: accountability for accidents is unclear, the manufacturer, software developer or retailer may share liability.","Legal: vehicles must comply with the Road Traffic Act and follow Highway Code rules even when driverless.","Legal: insurance and liability law must be updated to cover automated vehicles, the Automated and Electric Vehicles Act applies.","Legal: vehicles require DVSA approval and ongoing safety certification before deployment on public roads.","Environmental: electric powertrains produce no tailpipe emissions, reducing urban air pollution and noise.","Environmental: battery production has a high environmental cost in raw materials such as lithium and cobalt.","Environmental: optimised routing can reduce mileage and ease urban congestion compared with multiple human driven vans.","Environmental: range and weather limitations may force more frequent charging or backup diesel vehicles, offsetting some gains."]}],"marks_breakdown":[{"criteria":"Mark Band 3 (6-8 marks): comprehensive discussion meeting band descriptor across all three bullets","marks":8}]}},{"question_id":"4(a)","parent_question":4,"topic":"LAN vs WAN","marks":2,"command_word":"identify","content":[{"type":"text","value":"Identify two differences between a LAN and a WAN."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each clear difference. The answer must compare the two, not describe one alone."},{"type":"list","items":["A LAN covers a small geographical area (e.g. one site), whereas a WAN covers a large geographical area (e.g. across countries).","A LAN is owned by a single organisation, whereas a WAN is usually made up of infrastructure owned by third parties.","A LAN typically uses owned cabling and wireless equipment, whereas a WAN uses leased lines, satellite or telephone networks.","A LAN typically has higher bandwidth and lower latency than a WAN.","Reject single sided descriptions such as 'a LAN is small'."]}],"marks_breakdown":[{"criteria":"First valid comparative difference between LAN and WAN","marks":1},{"criteria":"Second valid comparative difference between LAN and WAN","marks":1}]}},{"question_id":"4(b)(i)","parent_question":4,"topic":"network topology","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe a mesh topology."}],"answer":{"guidance":[{"type":"text","value":"Up to 2 marks for a clear description of a mesh topology."},{"type":"list","items":["Each device / node is connected to multiple other devices in the network.","In a full mesh, every node is connected directly to every other node; in a partial mesh, only some nodes have multiple connections.","Data can take more than one route from sender to receiver.","Accept reference to wireless mesh networks where nodes relay data for each other."]}],"marks_breakdown":[{"criteria":"States that each node is connected to multiple other nodes","marks":1},{"criteria":"States that data can take more than one route, or distinguishes full vs partial mesh","marks":1}]}},{"question_id":"4(b)(ii)","parent_question":4,"topic":"network topology","marks":4,"command_word":"describe","content":[{"type":"text","value":"Describe two differences between a mesh topology and a star topology."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correctly described point and 1 mark for each contrasting point about the other topology, to a maximum of 4. Each difference must be a clear comparison."},{"type":"list","items":["A mesh has multiple connections between nodes, whereas a star has each device connected only to a central switch / hub.","Mesh provides multiple redundant paths if one link fails, whereas in a star a failed central switch brings the whole network down.","Mesh requires more cabling and is more expensive to install than a star.","Star is easier to add new devices to (just connect to the central switch), whereas mesh requires multiple new connections.","Reject single sided points without a clear comparison."]}],"marks_breakdown":[{"criteria":"First difference: point about mesh topology","marks":1},{"criteria":"First difference: contrasting point about star topology","marks":1},{"criteria":"Second difference: point about mesh topology","marks":1},{"criteria":"Second difference: contrasting point about star topology","marks":1}]}},{"question_id":"4(c)","parent_question":4,"topic":"network connections","marks":3,"command_word":"explain","content":[{"type":"text","value":"A university library is choosing between wired Ethernet and Wi-Fi for its student computers."},{"type":"text","value":"Explain three benefits of using wired Ethernet rather than Wi-Fi for these computers."}],"answer":{"guidance":[{"type":"text","value":"1 mark per benefit, where the benefit is explained in the context of the library."},{"type":"list","items":["Faster data transfer speeds, so students can download large research files more quickly.","More reliable / stable connection because wires are not affected by signal interference from walls or other devices.","More secure because an attacker would need physical access to the cabling to intercept data.","Lower latency, useful when many students access the same online resources at once.","Reject vague answers like 'it is better' without explanation linked to the library."]}],"marks_breakdown":[{"criteria":"First explained benefit linked to the library scenario","marks":1},{"criteria":"Second explained benefit linked to the library scenario","marks":1},{"criteria":"Third explained benefit linked to the library scenario","marks":1}]}},{"question_id":"4(d)","parent_question":4,"topic":"network performance","marks":4,"command_word":"complete","content":[{"type":"text","value":"Complete the table by giving a description of how each factor affects the performance of a network."},{"type":"table","headers":["Factor","Description of effect on network performance"],"rows":[["Bandwidth",""],["Number of users",""],["Transmission media",""],["Interference",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct description, to a maximum of 4."},{"type":"list","items":["Bandwidth: the maximum amount of data that can be transmitted per second; higher bandwidth allows more data to be sent in a given time.","Number of users: more users sharing the same connection reduces the bandwidth available to each, slowing performance.","Transmission media: fibre and Ethernet cabling generally provide higher speeds and lower latency than older copper wiring or wireless.","Interference: signals can be disrupted by other electrical devices or physical obstacles, causing dropped packets and retransmissions.","Accept equivalent technical wording."]}],"marks_breakdown":[{"criteria":"Correct description for Bandwidth","marks":1},{"criteria":"Correct description for Number of users","marks":1},{"criteria":"Correct description for Transmission media","marks":1},{"criteria":"Correct description for Interference","marks":1}]}},{"question_id":"4(e)(i)","parent_question":4,"topic":"IPv4 addresses","marks":4,"command_word":"tick","content":[{"type":"text","value":"Four candidate IPv4 addresses are shown in the table."},{"type":"text","value":"Tick one box in each row to show whether the address is a valid IPv4 address. For each address you mark as not valid, give a brief reason in the comments column."},{"type":"table","headers":["Candidate address","Valid","Not valid","Comment if not valid"],"rows":[["192.168.0.10","","",""],["256.1.1.1","","",""],["10.0.0","","",""],["172.16.45.200","","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correctly classified row to a maximum of 4. For a row marked Not valid, the mark is only awarded if the comment gives a correct reason."},{"type":"list","items":["192.168.0.10: Valid.","256.1.1.1: Not valid. Each octet must be in the range 0 to 255, so 256 is out of range.","10.0.0: Not valid. An IPv4 address must have four octets separated by dots.","172.16.45.200: Valid.","Accept any clear comment that conveys the correct rejection reason."]}],"marks_breakdown":[{"criteria":"192.168.0.10 marked as Valid","marks":1},{"criteria":"256.1.1.1 marked as Not valid with reason that octet exceeds 255","marks":1},{"criteria":"10.0.0 marked as Not valid with reason that there are fewer than four octets","marks":1},{"criteria":"172.16.45.200 marked as Valid","marks":1}]}},{"question_id":"4(e)(ii)","parent_question":4,"topic":"DNS","marks":4,"command_word":"describe","content":[{"type":"text","value":"A student types a domain name into a web browser."},{"type":"text","value":"Describe how the Domain Name System (DNS) resolves the domain name into an IP address."}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct ordered step, to a maximum of 4."},{"type":"list","items":["Step 1: the browser sends the domain name to a DNS server (often the local resolver).","Step 2: the DNS server checks its records (cache) for a matching IP address.","Step 3: if the address is not held, the request is passed to higher level DNS servers (e.g. root, top level domain, authoritative) until a match is found.","Step 4: the IP address is returned to the browser, which uses it to request the web page from the web server.","Accept descriptions that mention recursive / iterative lookups."]}],"marks_breakdown":[{"criteria":"Browser sends the domain name to a DNS server","marks":1},{"criteria":"DNS server checks its records / cache for a matching IP address","marks":1},{"criteria":"If not found, the request is passed to higher level DNS servers until matched","marks":1},{"criteria":"IP address is returned to the browser to request the web page","marks":1}]}},{"question_id":"4(f)","parent_question":4,"topic":"legislation","marks":4,"command_word":"identify and describe","content":[{"type":"text","value":"The university library wants to ensure that students using its computers behave lawfully."},{"type":"text","value":"Identify and describe two pieces of UK legislation that are relevant to the library's users."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct piece of legislation named (max 2), and 1 mark for each matching description (max 2)."},{"type":"list","items":["Data Protection Act (2018): controls how personal data is collected, stored and used; library staff must keep student records secure and only use them for stated purposes.","Computer Misuse Act (1990): makes it illegal to gain unauthorised access to a computer system, modify data without permission, or create malware; covers students attempting to log in to other accounts.","Copyright, Designs and Patents Act (1988): protects the rights of creators; students must not download or share copyrighted material such as ebooks or music without permission.","Accept a brief but accurate description of the act's purpose. Reject acts named with no description or descriptions that do not match the named act."]}],"marks_breakdown":[{"criteria":"First valid piece of UK legislation named","marks":1},{"criteria":"Matching description of first piece of legislation","marks":1},{"criteria":"Second valid piece of UK legislation named","marks":1},{"criteria":"Matching description of second piece of legislation","marks":1}]}},{"question_id":"5(a)","parent_question":5,"topic":"data units","marks":1,"command_word":"tick","content":[{"type":"text","value":"Tick one box to identify the correct conversion."},{"type":"table","headers":["Statement","Tick one box"],"rows":[["1 GB = 100 MB",""],["1 GB = 512 MB",""],["1 GB = 1024 MB",""],["1 GB = 8000 MB",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct row."},{"type":"list","items":["Correct answer: 1 GB = 1024 MB.","Do not award the mark if more than one box is ticked."]}],"marks_breakdown":[{"criteria":"Identifies '1 GB = 1024 MB' as the correct conversion","marks":1}]}},{"question_id":"5(b)","parent_question":5,"topic":"number base conversion","marks":4,"command_word":"complete","content":[{"type":"text","value":"Complete the table by filling in the missing values. Each row should show the same number written in denary, 8 bit binary and hexadecimal."},{"type":"table","headers":["Denary","8 bit binary","Hexadecimal"],"rows":[["45","","2D"],["","10110010","B2"],["200","11001000",""],["","00001111","0F"]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct missing cell, to a maximum of 4."},{"type":"list","items":["Row 1 binary: 00101101.","Row 2 denary: 178.","Row 3 hex: C8.","Row 4 denary: 15.","Accept hex letters in lower case (e.g. c8). Allow leading zeros to be omitted only in the hex column."]}],"marks_breakdown":[{"criteria":"Row 1 binary completed as 00101101","marks":1},{"criteria":"Row 2 denary completed as 178","marks":1},{"criteria":"Row 3 hex completed as C8","marks":1},{"criteria":"Row 4 denary completed as 15","marks":1}]}},{"question_id":"5(c)","parent_question":5,"topic":"binary addition","marks":2,"command_word":"add","content":[{"type":"text","value":"Add the two 8 bit binary values below. Show your working and state whether overflow has occurred."},{"type":"table","headers":["Value"],"rows":[["10110101"],["01001110"]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct 8 bit result, 1 mark for the correct statement about overflow."},{"type":"list","items":["10110101 + 01001110 = 1 00000011 (9 bit result).","8 bit result kept: 00000011.","Overflow has occurred because the result requires 9 bits but only 8 are available.","Award the overflow mark if the candidate clearly identifies a carry out of the most significant bit."]}],"marks_breakdown":[{"criteria":"Correct 8 bit sum 00000011","marks":1},{"criteria":"States that overflow has occurred (carry out of the most significant bit)","marks":1}]}},{"question_id":"5(d)","parent_question":5,"topic":"binary shift","marks":1,"command_word":"complete","content":[{"type":"text","value":"Perform a logical right shift of one place on the 8 bit binary value 11001100. Show the result as an 8 bit binary value."}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct result."},{"type":"list","items":["Correct result: 01100110.","Do not award the mark if the leading 0 is missing or if the result is not 8 bits."]}],"marks_breakdown":[{"criteria":"Result given as 01100110","marks":1}]}},{"question_id":"5(e)","parent_question":5,"topic":"binary shift","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe how a binary right shift performs division and identify one limitation of using it."}],"answer":{"guidance":[{"type":"text","value":"1 mark for the description of how shifting performs division, 1 mark for a valid limitation."},{"type":"list","items":["Description: shifting all bits one place to the right divides the value by 2; shifting by n places divides by 2^n.","Limitation: the least significant bits are lost, so any fractional part is discarded (loss of precision).","Limitation: only divides by powers of 2; cannot divide by, for example, 3 or 10.","Accept either limitation for the second mark."]}],"marks_breakdown":[{"criteria":"Describes that shifting right by n places divides by 2^n","marks":1},{"criteria":"Identifies a valid limitation (loss of precision or only divides by powers of 2)","marks":1}]}},{"question_id":"6(a)","parent_question":6,"topic":"character sets","marks":2,"command_word":"write","content":[{"type":"text","value":"In ASCII the lower case letter a has the denary value 97."},{"type":"text","value":"Write the 8 bit binary representation for the lower case letter k."}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying the correct denary value (107), 1 mark for the correct 8 bit binary value."},{"type":"list","items":["Letter k is the 11th letter, so its denary value is 97 + 10 = 107.","107 in 8 bit binary is 01101011.","Award full marks for the correct binary even if the working is not shown."]}],"marks_breakdown":[{"criteria":"Identifies that k has the denary value 107","marks":1},{"criteria":"Correct 8 bit binary 01101011","marks":1}]}},{"question_id":"6(b)","parent_question":6,"topic":"character sets","marks":2,"command_word":"identify","content":[{"type":"text","value":"Identify two differences between Unicode and ASCII."}],"answer":{"guidance":[{"type":"text","value":"1 mark per valid comparative difference, to a maximum of 2."},{"type":"list","items":["Unicode uses more bits per character (e.g. 16 or 32 bits) than ASCII (7 or 8 bits).","Unicode can represent many more characters, including non Latin alphabets and emoji, whereas ASCII only represents English letters, digits and basic symbols.","Unicode files are typically larger than equivalent ASCII files.","Reject single sided descriptions of one character set alone."]}],"marks_breakdown":[{"criteria":"First valid comparative difference between Unicode and ASCII","marks":1},{"criteria":"Second valid comparative difference between Unicode and ASCII","marks":1}]}},{"question_id":"6(c)","parent_question":6,"topic":"CPU registers","marks":2,"command_word":"complete","content":[{"type":"text","value":"Complete the table by writing a brief description of each CPU register."},{"type":"table","headers":["Register","Description"],"rows":[["Program Counter (PC)",""],["Memory Address Register (MAR)",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark per correct description."},{"type":"list","items":["Program Counter: holds the memory address of the next instruction to be fetched / executed.","Memory Address Register: holds the memory address that is currently being read from or written to.","Accept brief but accurate alternatives."]}],"marks_breakdown":[{"criteria":"Correct description for the Program Counter","marks":1},{"criteria":"Correct description for the Memory Address Register","marks":1}]}},{"question_id":"7(a)","parent_question":7,"topic":"CPU performance","marks":3,"command_word":"explain","content":[{"type":"text","value":"Explain how the size of the cache affects the performance of a CPU."}],"answer":{"guidance":[{"type":"text","value":"Up to 3 marks for a clear explanation linking cache size to CPU performance."},{"type":"list","items":["Cache stores frequently used instructions and data close to the CPU.","A larger cache can hold more instructions and data, increasing the cache hit rate.","More cache hits mean fewer fetches from slower main memory (RAM), so the CPU spends less time waiting and runs faster.","However, very large caches are expensive and can have slightly slower access times."]}],"marks_breakdown":[{"criteria":"States that cache stores frequently used instructions / data near the CPU","marks":1},{"criteria":"Explains that larger cache holds more data, increasing hit rate","marks":1},{"criteria":"Links higher hit rate to fewer slow RAM fetches and improved performance","marks":1}]}},{"question_id":"7(b)","parent_question":7,"topic":"network security","marks":4,"command_word":"name and describe","content":[{"type":"text","value":"A small company is concerned about threats to its network."},{"type":"text","value":"Name and describe two different network threats. Then describe one prevention method that helps protect against both of the threats you have named."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each threat named with a brief description (max 2), 1 mark for a prevention method, 1 mark for explaining how it helps against both threats."},{"type":"list","items":["Threat: malware, software designed to damage or gain unauthorised access to a system, often spread via email attachments or downloads.","Threat: phishing, fraudulent emails or websites that trick users into revealing usernames, passwords or banking details.","Threat: brute force attack, repeated automated attempts to guess a password.","Threat: denial of service attack, flooding the network with traffic to make services unavailable.","Prevention: user access training and policies that teach staff to recognise suspicious emails and to handle attachments safely; this reduces both malware infections and successful phishing attempts.","Prevention: firewall combined with up to date anti malware software; this blocks malicious traffic and known malware while filtering suspicious links.","Accept any other reasonable prevention method that plausibly addresses both named threats."]}],"marks_breakdown":[{"criteria":"First network threat named and briefly described","marks":1},{"criteria":"Second different network threat named and briefly described","marks":1},{"criteria":"One sensible prevention method named","marks":1},{"criteria":"Explains how the prevention method helps against both named threats","marks":1}]}}]`),z3={paper_id:R3,qualification:D3,component:M3,title:N3,year:L3,session:B3,total_marks:F3,questions:$3},W3="J277-01-TeacherVariant-C",Q3="J277",V3="01",U3="Computer Systems",H3=null,G3="TeacherVariant-C",X3=80,Y3=JSON.parse(`[{"question_id":"1(a)","parent_question":1,"topic":"CPU performance","marks":1,"command_word":"identify","content":[{"type":"text","value":"A student is comparing two laptops in a shop. They want to know which factor most affects how quickly the CPU can carry out instructions."},{"type":"text","value":"Tick one box to identify the factor that most directly affects the speed at which a CPU executes instructions."},{"type":"table","headers":["Factor","Tick one box"],"rows":[["Number of cores",""],["Cache size",""],["Clock speed",""],["Amount of RAM",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct row only. Do not award the mark if more than one box is ticked."},{"type":"list","items":["Correct answer: Clock speed","Reject any answer where multiple boxes are ticked."]}],"marks_breakdown":[{"criteria":"Row 'Clock speed' identified as the factor most directly affecting CPU instruction speed","marks":1}]}},{"question_id":"1(b)","parent_question":1,"topic":"CPU performance","marks":2,"command_word":"identify","content":[{"type":"text","value":"Identify two parts of a CPU that affect its performance."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct part identified, to a maximum of 2 marks."},{"type":"list","items":["Accept: cache (memory)","Accept: number of cores","Accept: clock / clock speed","Accept: control unit","Accept: ALU / arithmetic logic unit","Accept: registers","Reject: RAM, hard drive, GPU (these are not parts of the CPU)"]}],"marks_breakdown":[{"criteria":"First valid CPU part identified (e.g. cache, cores, clock, ALU, control unit, registers)","marks":1},{"criteria":"Second valid CPU part identified (e.g. cache, cores, clock, ALU, control unit, registers)","marks":1}]}},{"question_id":"1(c)","parent_question":1,"topic":"CPU performance","marks":2,"command_word":"explain","content":[{"type":"text","value":"A CPU manufacturer increases the cache size in a new processor."},{"type":"text","value":"Explain the effect that a larger cache has on CPU performance."}],"answer":{"guidance":[{"type":"text","value":"1 mark for an identification linked to cache, plus 1 mark for the linked explanation, to a maximum of 2 marks."},{"type":"list","items":["Accept: more frequently used data / instructions can be stored in the cache (1) so the CPU spends less time fetching from slower RAM (1).","Accept: fewer cache misses (1) which improves overall throughput of the CPU (1)."]}],"marks_breakdown":[{"criteria":"Identifies that more data or instructions can be held closer to the CPU in cache","marks":1},{"criteria":"Explains the effect on performance (e.g. fewer fetches from RAM, faster processing)","marks":1}]}},{"question_id":"1(d)","parent_question":1,"topic":"fetch-execute cycle","marks":2,"command_word":"identify","content":[{"type":"text","value":"Identify two events that occur during the fetch stage of the fetch-execute cycle."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct event, to a maximum of 2 marks."},{"type":"list","items":["Accept: the address of the next instruction is copied from the program counter to the MAR (Memory Address Register).","Accept: the program counter is incremented.","Accept: the instruction at the address in the MAR is copied into the MDR (Memory Data Register).","Accept: the instruction is loaded into the CIR (Current Instruction Register).","Reject: decoding or executing the instruction (these are later stages)."]}],"marks_breakdown":[{"criteria":"First valid fetch-stage event identified","marks":1},{"criteria":"Second valid fetch-stage event identified","marks":1}]}},{"question_id":"2(a)","parent_question":2,"topic":"secondary storage","marks":1,"command_word":"define","content":[{"type":"text","value":"Define the term secondary storage."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a definition that conveys non-volatile, long-term storage held outside main memory."},{"type":"list","items":["Accept: non-volatile storage used to keep programs and data when the computer is switched off.","Accept: storage that is not directly accessed by the CPU and which retains data without power.","Reject: simply 'storage' or 'a hard drive' without reference to persistence."]}],"marks_breakdown":[{"criteria":"Definition references non-volatile / persistent storage held outside main memory","marks":1}]}},{"question_id":"2(b)","parent_question":2,"topic":"secondary storage","marks":3,"command_word":"identify","content":[{"type":"text","value":"Three users need to choose a type of secondary storage."},{"type":"text","value":"For each scenario, identify the most suitable storage type from: magnetic, optical or solid state."},{"type":"table","headers":["Scenario","Storage type"],"rows":[["A backup company that needs to archive several terabytes of records cheaply each night.",""],["A film studio that distributes a finished movie to cinemas on physical discs.",""],["A photographer who needs fast, shock-resistant storage inside a portable camera.",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct identification, to a maximum of 3 marks."},{"type":"list","items":["Backup company: magnetic (e.g. magnetic tape or HDD).","Film studio: optical (e.g. Blu-ray / DVD).","Photographer: solid state (e.g. SD card / SSD)."]}],"marks_breakdown":[{"criteria":"Backup scenario identified as magnetic","marks":1},{"criteria":"Film studio scenario identified as optical","marks":1},{"criteria":"Photographer scenario identified as solid state","marks":1}]}},{"question_id":"2(c)","parent_question":2,"topic":"secondary storage","marks":4,"command_word":"state","content":[{"type":"text","value":"State one characteristic of each of the following secondary storage devices."},{"type":"table","headers":["Device","Characteristic"],"rows":[["Hard disk drive (HDD)",""],["Solid state drive (SSD)",""],["Optical disc",""],["Magnetic tape",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for one valid characteristic per device, to a maximum of 4 marks. Do not credit the same characteristic twice."},{"type":"list","items":["HDD: large capacity for low cost; uses spinning magnetic platters; sensitive to physical shock.","SSD: very fast read/write speeds; no moving parts so silent and shock-resistant; more expensive per GB than HDD.","Optical disc: read using a laser; portable and cheap to produce; relatively low capacity.","Magnetic tape: very high capacity for low cost; sequential access only; commonly used for backups."]}],"marks_breakdown"