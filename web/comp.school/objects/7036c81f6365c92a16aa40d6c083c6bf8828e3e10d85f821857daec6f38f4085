erence.","marks_breakdown":[{"criteria":"Clear difference stated with both sides (e.g. RAM is volatile / ROM is non-volatile, or RAM contents can change / ROM contents cannot)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2022.pdf","question-png":[["data/png/j277/yearpapers/paper-1-2022-june/question/page-011.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2022-june/markscheme/page-035.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2022-june/dev-qa/q-7-a-i.png"}},{"question_id":"7(a)(ii)","parent_question":7,"topic":"RAM data examples","marks":2,"command_word":"give","content":[{"type":"text","value":"Give two examples of data that a smart television could store in RAM."}],"answer":{"guidance":[{"type":"text","value":"1 mark each to max 2. E.g."},{"type":"list","items":["Web browser/application that is running","parts of the operating system currently running","current video/film being watched","data being downloaded/buffered","button pressed by the user","current volume","current channel"]},{"type":"text","value":"Must be clearly RAM (not just 'stores the software/OS' which is secondary storage)."}],"marks_breakdown":[{"criteria":"Example 1 (e.g. running application, currently watched video, buffered data, user input)","marks":1},{"criteria":"Example 2","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2022.pdf","question-png":[["data/png/j277/yearpapers/paper-1-2022-june/question/page-011.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2022-june/markscheme/page-036.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2022-june/dev-qa/q-7-a-ii.png"}},{"question_id":"7(b)(i)","parent_question":7,"topic":"secondary storage need","marks":2,"command_word":"state","content":[{"type":"text","value":"A smart television has secondary storage."},{"type":"text","value":"State, using an example, why the smart television needs secondary storage."}],"answer":{"guidance":[{"type":"text","value":"1 mark for example (e.g. the OS, web browser software, recorded show, user preferences)."},{"type":"text","value":"1 mark for: to store data once the computer is turned off / permanently / for non-volatile storage."},{"type":"text","value":"Allow 2 marks by example if it covers both points."}],"marks_breakdown":[{"criteria":"Valid example of data stored (e.g. OS, software, recorded shows, preferences)","marks":1},{"criteria":"Reason: to store data permanently / when turned off / non-volatile","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2022.pdf","question-png":[["data/png/j277/yearpapers/paper-1-2022-june/question/page-012.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2022-june/markscheme/page-037.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2022-june/dev-qa/q-7-b-i.png"}},{"question_id":"7(b)(ii)","parent_question":7,"topic":"secondary storage type","marks":4,"command_word":"identify and justify","content":[{"type":"text","value":"Identify one appropriate type of secondary storage for the smart television. Justify your choice."},{"type":"text","value":"Secondary storage type: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for choice: either magnetic or solid state. 1 mark per bullet to max 3 for justification matching the choice."},{"type":"table","headers":["Type","Justifications"],"rows":[["Magnetic","large storage capacity (for storing software/videos), TV unlikely to be moved (durability not needed), low cost, fits in a TV, reliable"],["Solid state","large capacity, TV may be moved (so durable/robust), fast data access (more responsive), low cost, runs quieter, less heat, less energy, compact/lightweight"]]},{"type":"text","value":"If type is inappropriate (e.g. optical), do not award."}],"marks_breakdown":[{"criteria":"Valid storage type identified (magnetic or solid state)","marks":1},{"criteria":"Justificati