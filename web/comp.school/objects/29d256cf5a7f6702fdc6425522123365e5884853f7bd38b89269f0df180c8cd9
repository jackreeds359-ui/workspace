j277/yearpapers/paper-1-specimen/question/page-006.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-015.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-7-a.png"}},{"question_id":"7(b)(i)","parent_question":7,"topic":"protocol layer definition","marks":1,"command_word":"define","content":[{"type":"text","value":"TCP/IP is a set of protocols based on layers."},{"type":"text","value":"With regards to network protocols, define what is meant by a 'layer'."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a correct definition."},{"type":"list","items":["Accept: a division of network functionality.","Candidate's responses may differ from the given answer but must represent conceptually the same thing - e.g. 'a layer is where jobs / processes are split up' would receive the mark."]}],"marks_breakdown":[{"criteria":"A division of network functionality (e.g. where jobs / processes are split up)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-007.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-015.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-7-b-i.png"}},{"question_id":"7(b)(ii)","parent_question":7,"topic":"protocol layer advantage","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe one advantage of using layers to construct network protocols."}],"answer":{"guidance":[{"type":"text","value":"1 mark for the correct identification and 1 mark for a valid description, to a maximum of 2 marks."},{"type":"list","items":["Accept: it is self-contained (1) so it allows different developers to concentrate on one aspect of the network (1)","a layer can be taken out and edited without affecting other layers (1) so it promotes interoperability between vendors and systems (1)."]}],"marks_breakdown":[{"criteria":"Identifies a valid advantage (e.g. layers are self-contained / a layer can be edited without affecting other layers)","marks":1},{"criteria":"Provides a valid description / consequence (e.g. allows developers to concentrate on one aspect, promotes interoperability between vendors and systems)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-007.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-015.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-7-b-ii.png"}},{"question_id":"7(c)","parent_question":7,"topic":"star topology reasons","marks":2,"command_word":"give","content":[{"type":"text","value":"Give two reasons why the bakery may use a star network topology for their LAN."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct reason, to a maximum of 2 marks."},{"type":"list","items":["Accept: it is easy to add a new node or device","fewer data collisions can occur","if a node or device fails it does not affect the rest of the network","a signal does not need to be transmitted to all computers in the network.","Any valid comparisons to other topologies can be awarded marks."]}],"marks_breakdown":[{"criteria":"First valid reason (e.g. easy to add a new node/device, fewer data collisions, node failure does not affect the rest of the network, signal not transmitted to all computers)","marks":1},{"criteria":"Second valid reason (different from the first)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-007.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-015.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-7-c.png"}},{"question_id":"8(a)","parent_question":8,"topic":"network security methods","marks":6,"command_word":"explain","content":[{"type":"text","value":"A hospital stores patients' details on its computer network. The hospital is concerned about the security of its patients' details."},{"type":"text","value":"Staff already use strong passwords to protect systems. Explain, with reference to system security, three other ways that the hospital could protect the network system."}],"answer":{"guidance":[{"type":"text","value":"1 mark to be awarded for each correct type to a maximum of 3 marks (AO2 1a)."},{"type":"text","value":"1 mark to be awarded for each correct explanation to a maximum of 3 marks (AO2 1b). Accept:"},{"type":"table","headers":["Type","Explanation"],"rows":[["Firewall","prevents unauthorised access"],["Anti-malware","removes viruses / spyware from infecting the system"],["Encryption","any intercepted data is rendered useless"],["User access levels","users have restricted access"],["Network policies","rules that define acceptable use"]]}],"marks_breakdown":[{"criteria":"First security method identified (e.g. firewall, anti-malware, encryption, user access levels, network policies)","marks":1},{"criteria":"Explanation of the first method (e.g. firewall prevents unauthorised access)","marks":1},{"criteria":"Second security method identified (different from the first)","marks":1},{"criteria":"Explanation of the second method","marks":1},{"criteria":"Third security method identified (different from the first two)","marks":1},{"criteria":"Explanation of the third method","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-018.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-8-a.png"}},{"question_id":"8(b)","parent_question":8,"topic":"network security errors","marks":6,"command_word":"identify and outline","content":[{"type":"text","value":"Identify three errors that the hospital staff could make that may endanger the security of the network. Outline a procedure that could be put in place to prevent each error."}],"answer":{"guidance":[{"type":"text","value":"1 mark to be awarded for each correct identification of an error to a maximum of 3 marks (AO2 1a)."},{"type":"text","value":"1 mark to be awarded for each correct outlining of a procedure to a maximum of 3 marks (AO2 1b)."},{"type":"text","value":"Allow any reasonable combination of error and procedure to mitigate the risk. Accept:"},{"type":"table","headers":["Error","Procedure"],"rows":[["brings in files via any medium","not allowing or stopping external devices being used on the network"],["downloading infected files from the internet","blocking or restricting access to insecure websites"],["allowing physical access to the network","locking of doors, key cards or any physical security procedure"],["sending or sharing sensitive data with third parties","blocking or restricting access to USB ports, email, internet or printing"]]}],"marks_breakdown":[{"criteria":"First error identified (e.g. bringing in files via external media, downloading infected files, allowing physical access, sharing sensitive data with third parties)","marks":1},{"criteria":"Procedure that mitigates the first error (e.g. block external devices, restrict insecure websites, lock doors / use key cards, restrict USB / email / printing)","marks":1},{"criteria":"Second error identified (different from the first)","marks":1},{"criteria":"Procedure that mitigates the second error","marks":1},{"criteria":"Third error identified (different from the first two)","marks":1},{"criteria":"Procedure that mitigates the third error","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-018.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-8-b.png"}},{"question_id":"9(a)","parent_question":9,"topic":"disk fragmentation cause","marks":4,"command_word":"explain","content":[{"type":"text","value":"A restaurant has a computer-based ordering system which is running slowly. A technician has said that the hard disc drive is fragmented. The technician has suggested using utility software to defragment the drive."},{"type":"text","value":"Explain how the restaurant's hard disc could have become fragmented."}],"answer":{"guidance":[{"type":"text","value":"Up to a maximum of 4 marks."},{"type":"text","value":"A maximum of three marks if there is no contextualisation."},{"type":"text","value":"Allow a mark if candidates state that fragmentation increases access time. Accept:"},{"type":"list","items":["orders have been saved onto the system as they order food and then deleted once processed (1)","once other orders have been made, new files are created (1) which may be bigger than the spaces left by the deleted files (1)","the order files are split up (1)"]}],"marks_breakdown":[{"criteria":"Order files are saved to the disc as customers order food and deleted once processed","marks":1},{"criteria":"As more orders are made, new files are created (and saved into the available spaces)","marks":1},{"criteria":"New files may be bigger than the spaces left by the deleted files","marks":1},{"criteria":"The (order) files are split up / stored in non-contiguous blocks across the disc","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-019.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-9-a.png"}},{"question_id":"9(b)","parent_question":9,"topic":"defragmentation software","marks":3,"command_word":"explain","content":[{"type":"text","value":"Explain how defragmentation software could overcome the issue of the slow computer system."}],"answer":{"guidance":[{"type":"text","value":"Up to a maximum of 3 marks. Accept:"},{"type":"list","items":["files on the hard disk drive are moved (1)","empty spaces collected together (1)","files are moved to be stored together (1)","fewer disc accesses are needed (1)"]}],"marks_breakdown":[{"criteria":"Files on the hard disk drive are moved (rearranged)","marks":1},{"criteria":"Empty spaces are collected together / files belonging to the same file are stored together (contiguously)","marks":1},{"criteria":"Fewer disc accesses are needed (so the system runs faster)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-019.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-9-b.png"}},{"question_id":"10(a)","parent_question":10,"topic":"WAN definition","marks":1,"command_word":"define","content":[{"type":"text","value":"A law company currently use a Local Area Network (LAN) linked to a Wide Area Network (WAN)."},{"type":"text","value":"They want to upgrade their system to utilise cloud storage."},{"type":"text","value":"Define what is meant by a Wide Area Network."}],"answer":{"guidance":[{"type":"text","value":"1 mark only for a correct definition. Accept:"},{"type":"list","items":["the computers are geographically remote / distanced / more than a mile apart","communication medium is not owned by the law firm (e.g. the company doesn't own the infrastructure)"]},{"type":"text","value":"Do not accept 'network over a wide area' or similar arrangement of wording."}],"marks_breakdown":[{"criteria":"Computers are geographically remote/distanced (more than a mile apart) and/or the communication medium/infrastructure is not owned by the organisation","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Specimen (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-specimen/question/page-010.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-specimen/markscheme/page-020.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-specimen/dev-qa/q-10-a.png"}},{"question_id":"10(b)","parent_question":10,"topic":"cloud storage advantages","marks":4,"command_word":"explain","content":[{"type":"text","value":"Explain two advantages to the law company of storing their data in the Cloud."}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct advantage, with a mark for a discussion of the advantage related to the law firm, to a maximum of 2 advantages (4 marks total)."},{"type":"text","value":"Responses which are not contextualised will gain a maximum of 1 mark per advantage."},{"type":"text","value":"Accept advantages such as:"},{"type":"list","items":["it would offer additional storage (1) so the company can take on more cases (1)","it is a very efficient method of backing up data (1) and so saves the firm time and money (1)","it would allow their employees to work from anywhere (1) so they can take cases from other countries (1)","it is environmentally friendly (1)","easy to increase availability of storage (1)","you don't need specialist network skills (1) so the firm don't need to employ more staff (1)","the third party provides security (1) so the company saves money on staff and software/hardware (1)","the third party provides backup (1) so the company saves money on staff and software/hardware (1)","cheaper as don't need own infrastructure (1)"]}],"marks_breakdown":[{"criteria":"First valid advantage of cloud storage identified","marks":1},{"criteria":"First advantage contextualised / discussed in relation to the law firm","marks":1},{"criteria":"Second valid advantage of cloud storage identifie