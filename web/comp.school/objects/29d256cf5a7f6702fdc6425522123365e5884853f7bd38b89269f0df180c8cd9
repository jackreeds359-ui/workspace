ng/j277/yearpapers/paper-1-2023-june/markscheme/page-024.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-3-b-iv.png"}},{"question_id":"3(c)(i)","parent_question":3,"topic":"text compression","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"A student has a text document and an image file that need to be compressed separately."},{"type":"text","value":"The student needs to reduce the file size of both of these files as much as possible."},{"type":"text","value":"Identify the most suitable type of compression for the text document. Justify your choice."},{"type":"text","value":"Type of compression: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying lossless."},{"type":"list","items":["Do not award an example of lossless (e.g. RLE) for the first mark but follow through for the justification.","Do not follow through for lossy.","Accept reverse arguments (e.g. lossy will remove data).","If the compression type is missing, read the justification","if it clearly states which type, award the justification.","MP1 requires reference to the data (or equivalent) not information","MP2 must be in the context of text files (information is allowed).","If not a valid compression type, 0 marks.","Valid justifications: lossless will not remove any data / no data is lost / file can be fully reconstructed","text files require all data to open/work / lossy cannot usually be used on text files / no required characters, words, spaces, case, formatting or information would be lost / the text will remain accurate / will not change meaning / will still make sense."]},{"type":"text","value":"1 mark each to max 2 for justification."}],"marks_breakdown":[{"criteria":"Lossless compression identified","marks":1},{"criteria":"Justification point 1 (e.g. no data is lost / file can be fully reconstructed)","marks":1},{"criteria":"Justification point 2 in text-file context (e.g. text remains accurate / all characters and formatting retained / lossy unsuitable for text)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-006.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-025.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-3-c-i.png"}},{"question_id":"3(c)(ii)","parent_question":3,"topic":"image compression","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Identify the most suitable type of compression for the image file. Justify your choice."},{"type":"text","value":"Type of compression: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identifying lossy."},{"type":"list","items":["Do not award an example of lossy (e.g. reduce resolution) for the first mark but follow through the justification.","Do not award lossless but follow through the justification if lossless is given (acceptable lossless justifications: quality/detail retained","no data lost permanently","file size can still be substantially reduced).","If compression type is missing, read the justification and award if the type is clearly stated.","Do not award 'how the file can be compressed' (e.g. reduce number of colours) unless the candidate also states that the change will not be noticed.","'It compresses the file more' is not enough (compression is in the question).","If not a valid compression type, 0 marks.","Accepted lossy justifications: will reduce the file size more/significantly than lossless","image will only lose quality / changes may not be noticed by the user / removes unnoticeable detail."]},{"type":"text","value":"1 mark each to max 2 for justification."}],"marks_breakdown":[{"criteria":"Lossy compression identified","marks":1},{"criteria":"Justification point 1 (e.g. reduces file size more/significantly than lossless)","marks":1},{"criteria":"Justification point 2 (e.g. only loses quality or removes unnoticeable detail, changes may not be noticed)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-007.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-023.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-3-c-ii.png"}},{"question_id":"4(a)","parent_question":4,"topic":"threat prevention methods","marks":4,"command_word":"tick","content":[{"type":"text","value":"Tick one or more boxes on each row to identify all of the methods that can help to prevent each threat."},{"type":"table","headers":["Threat","Anti-malware","Penetration testing","Encryption","Firewall"],"rows":[["Spyware","","","",""],["Brute-force attack","","","",""],["Data interception","","","",""],["SQL injection","","","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for each correct row. Correct pattern (ticks where the method helps prevent the threat):"},{"type":"table","headers":["Threat","Method(s) that help prevent the threat"],"rows":[["Spyware","Anti-malware (and Firewall)"],["Brute-force attack","Firewall"],["Data interception","Encryption"],["SQL injection","Penetration testing (and Firewall)"]]},{"type":"text","value":"Extra or missing ticks within a row score 0 for that row. A firewall and penetration testing alone cannot stop data interception once data is in transit between computers."}],"marks_breakdown":[{"criteria":"Spyware row correct (Anti-malware, and Firewall)","marks":1},{"criteria":"Brute-force attack row correct (Firewall)","marks":1},{"criteria":"Data interception row correct (Encryption)","marks":1},{"criteria":"SQL injection row correct (Penetration testing, and Firewall)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-027.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-4-a.png"}},{"question_id":"4(b)","parent_question":4,"topic":"network threats","marks":3,"command_word":"name and describe","content":[{"type":"text","value":"Name and describe one threat to a computer system that is not Spyware, Brute Force attack, Data Interception or SQL Injection."},{"type":"text","value":"Threat: ____"},{"type":"text","value":"Description: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for naming a valid threat (not one of those excluded by the question). 1 mark each to max 2 for description. If threat is clearly wrong, do not follow through. If no threat named, read description for the name; if still none, do not award. Allow social engineering as the threat and phishing/pharming/shoulder surfing features in the description. Ransomware description cannot award a mark for 'ransom' alone without reference to it being paid."},{"type":"text","value":"Accepted threats and example descriptions:"},{"type":"table","headers":["Threat","Example description(s)"],"rows":[["Social engineering","using deception to manipulate users; to gain personal data"],["Shoulder surfing","watching a person enter a password; using it to access an account"],["Phishing","fake emails sent / click link from fake email; person sends / gives away personal data"],["Pharming","software redirects to fake website; person enters personal data"],["Denial of Service / DDoS","multiple requests sent to a server / server is flooded; more requests than the server can process / uses all bandwidth; server cannot respond / crashes / slows or denies access"],["Hacker","gaining unauthorised access; to delete/damage/access data"],["Virus/malware","software that replicates/spreads; fills disk space; deletes/corrupts data / allows unauthorised access"],["Trojan","malware disguised as legitimate software; once installed acts as a virus, e.g. deletes files or allows unauthorised access"],["Worm","replicates across a network; uses up bandwidth"],["Ransomware","encrypts/corrupts/locks access to data; cannot access data without paying a fee to decrypt / meet demands"],["Physical threat","damage to hardware; deletes/corrupts data"]]}],"marks_breakdown":[{"criteria":"Valid threat named (not Spyware, Brute Force, Data Interception or SQL Injection)","marks":1},{"criteria":"Description point 1 matching the named threat","marks":1},{"criteria":"Description point 2 matching the named threat","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-008.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-028.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-4-b.png"}},{"question_id":"5(a)(i)","parent_question":5,"topic":"primary and secondary storage","marks":2,"command_word":"explain","content":[{"type":"text","value":"An artist has a computer that they use to create images."},{"type":"text","value":"Their computer has both hardware and software."},{"type":"text","value":"The hardware includes primary and secondary storage."},{"type":"text","value":"Explain why a computer needs both primary and secondary storage."}],"answer":{"guidance":[{"type":"text","value":"1 mark each for a reason relating to primary storage and a reason relating to secondary storage."},{"type":"list","items":["Primary storage: to store (active) data/instructions/software/OS that the processor needs to access","without primary the computer won't start up / work","(ROM) so start-up instructions are not deleted when the computer turns off","(RAM) to store currently running data/software/instructions","(cache) to store frequently used data/instructions.","Secondary storage: to store data/files long-term / permanently","without secondary the user's files will not be stored when the power is turned off","to store data not currently being used."]},{"type":"text","value":"The question asks why each is needed, not what they store. Secondary storage answers must reference long-term / permanent storage, not just 'backup'."}],"marks_breakdown":[{"criteria":"Reason primary storage is needed (e.g. stores active data/instructions/OS the processor accesses, or without it the computer won't start)","marks":1},{"criteria":"Reason secondary storage is needed (e.g. stores data/files long-term / permanently so files persist when power is off)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-030.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-a-i.png"}},{"question_id":"5(a)(ii)","parent_question":5,"topic":"secondary storage devices","marks":2,"command_word":"give","content":[{"type":"text","value":"Give one example of a secondary storage device that the artist's computer will have and an example of the data that will be stored on it."},{"type":"text","value":"Secondary storage device: ____"},{"type":"text","value":"Example data: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid secondary storage device."},{"type":"list","items":["Question asks for a device not a type (magnetic/optical/solid state on its own is not enough","BOD 'optical disc').","USB on its own is not enough.","Accepted devices: hard drive, SSD, USB (memory) stick, flash memory card, CD, DVD, etc.","Accepted data examples: images created, documents, software, files, data moved from RAM to virtual memory.","Award the example even if the secondary device is incorrect.","Do not accept RAM or ROM as a secondary storage device."]},{"type":"text","value":"1 mark for an example of data."}],"marks_breakdown":[{"criteria":"Valid secondary storage device (e.g. hard drive, SSD, USB memory stick, flash memory card, CD, DVD)","marks":1},{"criteria":"Valid example of data stored (e.g. images created, documents, software, files)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-009.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-033.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-a-ii.png"}},{"question_id":"5(a)(iii)","parent_question":5,"topic":"virtual memory","marks":4,"command_word":"tick and rewrite","content":[{"type":"text","value":"The computer has Virtual Memory (VM)."},{"type":"text","value":"The table has four statements about VM. Not all of the statements are correct."},{"type":"text","value":"Tick the True column for the statements that are correct. Re-write any statement that is incorrect in the False column by changing the statement to make it true."},{"type":"table","headers":["Statement","True","False - rewrite the statement to make it true"],"rows":[["A section of primary storage is partitioned to act as virtual memory","",""],["Data from ROM is transferred into VM","",""],["VM is needed when RAM is full, or nearly full","",""],["Data from VM is transferred back to secondary storage when needed","",""]]}],"answer":{"guidance":[{"type":"text","value":"1 mark for each row. Allow a description of the error in column 2 rather than a full rewrite (e.g. 'primary should be secondary'). Accept HDD/SSD for secondary storage in row 1. Do not accept 'primary' on its own for RAM (rows 2 and 4) because primary would include ROM and cache."},{"type":"table","headers":["Row","True/False","Correct rewrite / marking guidance"],"rows":[["1","FALSE","A section of secondary storage is partitioned to 