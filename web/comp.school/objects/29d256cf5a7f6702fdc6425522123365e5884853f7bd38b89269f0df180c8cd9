scheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-030.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-b.png"}},{"question_id":"5(c)(i)","parent_question":5,"topic":"client-server client","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"The artist uploads images to be displayed on a website. This is a client-server relationship."},{"type":"text","value":"Identify the computer that is acting as the client in this scenario and justify your choice."},{"type":"text","value":"Client computer: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identification: the artist's computer / computer uploading the images (BOD 'the artist')."},{"type":"list","items":["If the computer is incorrect, do not award the justification.","If 'user's computer' is given, this is not enough but read on for the justification","'user viewing the website' is incorrect.","Be careful the justification is about uploading images to the web server, not downloading.","Accept 'host' for web server.","Accepted justifications: sends the files/data for storage / to the host / web server","the files are stored on the web server","performs the user's actions and sends the results to the web server","sends a request to the web server to store/upload its files","it does not store data for others to access","confirmation of upload or an error is received from the server for display."]},{"type":"text","value":"1 mark each to max 2 for justification."}],"marks_breakdown":[{"criteria":"Client identified as the artist's computer / the computer uploading the images","marks":1},{"criteria":"Justification point 1 (e.g. sends files/data to the web server for storage, or sends an upload request)","marks":1},{"criteria":"Justification point 2 (e.g. does not store data for others to access, or receives confirmation/error from the server)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-011.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-032.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-c-i.png"}},{"question_id":"5(c)(ii)","parent_question":5,"topic":"client-server server","marks":3,"command_word":"identify and justify","content":[{"type":"text","value":"Identify the computer that is acting as the server in this scenario and justify your choice."},{"type":"text","value":"Server computer: ____"},{"type":"text","value":"Justification: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for identification: web server."},{"type":"list","items":["If the computer named is incomplete or inaccurate (e.g. 'server' or 'website' instead of web server), do not award the identification mark but award the justification","allow follow-through in the justification if the same inaccurate term is used (e.g. 'images are sent to the website').","1 mark each to max 2 for justification: the images/data are stored on / uploaded to / sent to / hosted on the web server","web server receives a request (from the artist's computer to upload the images)","web server executes / responds to the request / is doing the processing or handling of the upload","web server returns confirmation or error of the processing/upload."]}],"marks_breakdown":[{"criteria":"Server identified as web server","marks":1},{"criteria":"Justification point 1 (e.g. images are stored/uploaded to/hosted on the web server, or server receives the upload request)","marks":1},{"criteria":"Justification point 2 (e.g. web server processes the upload, or returns confirmation/error to the client)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-011.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-033.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-c-ii.png"}},{"question_id":"5(d)(i)","parent_question":5,"topic":"proprietary software benefits","marks":4,"command_word":"describe","content":[{"type":"text","value":"An artist is working with a programmer on the development of a new piece of software."},{"type":"text","value":"The software will allow users to edit images on devices such as mobile telephones."},{"type":"text","value":"They are considering releasing the software as open source instead of proprietary."},{"type":"text","value":"Describe two benefits to the artist and programmer of releasing the software as proprietary."},{"type":"text","value":"Benefit 1: ____"},{"type":"text","value":"Benefit 2: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark each to max 4."},{"type":"list","items":["Do not award references to ownership/copyright because both proprietary and open source allow copyright of the code/program.","Accepted benefits (a point plus expansion): authors can earn money (e.g. by selling for a fee / using licences to stop unauthorised use)","no-one can see the code (e.g. users cannot edit/change the software / cannot insert malware / cannot be copied/resold/shared)","more control over intellectual property (e.g. restrict users, restrict what can be done with the software without permission)."]},{"type":"text","value":"Mark the answer as a whole. Benefits must be to the artist and programmer, not to the user."}],"marks_breakdown":[{"criteria":"Benefit 1 point (e.g. authors can earn money / no-one can see the code / more control over intellectual property)","marks":1},{"criteria":"Benefit 1 expansion (e.g. by selling for a fee or using licences; or code cannot be copied/resold; or restricting what users can do without permission)","marks":1},{"criteria":"Benefit 2 point (a second distinct benefit to the artist and programmer)","marks":1},{"criteria":"Benefit 2 expansion tied to that point","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-012.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-034.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-d-i.png"}},{"question_id":"5(d)(ii)","parent_question":5,"topic":"open source benefits","marks":2,"command_word":"describe","content":[{"type":"text","value":"Describe one benefit to the users of releasing the software as open source."}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid point and 1 mark for a matching expansion."},{"type":"list","items":["Accepted point/expansion pairs: users can view/edit the (source) code / users can edit the program (to tailor/improve/adapt it to do what they need","so errors can be fixed by anyone","users can learn how the software works)","freely accessible (do not have to pay","can redistribute","with changes)."]},{"type":"text","value":"The benefit must be to the users (not to the artist and programmer)."}],"marks_breakdown":[{"criteria":"Valid benefit point to users (e.g. can view/edit the source code, or the software is freely accessible)","marks":1},{"criteria":"Matching expansion (e.g. can tailor/adapt it to their needs, fix errors, learn from it, or don't have to pay / can redistribute)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-012.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-033.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-5-d-ii.png"}},{"question_id":"6","parent_question":6,"topic":"facial recognition impact","marks":8,"command_word":"discuss","content":[{"type":"text","value":"A shopping centre has a security system that includes CCTV cameras to record activities in the centre. The security system is being upgraded to include the use of facial recognition to identify, track the movements of and record individuals throughout the shopping centre."},{"type":"text","value":"Discuss the positive and negative impacts of this upgrade including:"},{"type":"text","value":"- ethical issues\\n- privacy issues\\n- legal issues"}],"answer":{"guidance":[{"type":"text","value":"Levels-of-response banded mark scheme."},{"type":"table","headers":["Mark band","Marks","Descriptor"],"rows":[["Mark Band 3 - High Level","6-8","candidate demonstrates thorough knowledge and understanding of a wide range of considerations; material is accurate and detailed; applies knowledge consistently to the shopping-centre/facial-recognition context; evidence and examples are explicitly relevant; weighs up both sides with reference to the impact on all three areas (ethical, privacy, legal); well-developed line of reasoning, clear and logically structured, substantiated"],["Mark Band 2 - Mid Level","3-5","reasonable knowledge and understanding of a range of considerations; generally accurate but at times underdeveloped; applies knowledge to the context with one or two missed opportunities; examples mostly implicitly relevant; reasonable attempt to discuss impact; structured line of reasoning, mostly relevant and supported by some evidence"],["Mark Band 1 - Low Level","1-2","basic knowledge with limited understanding, some inaccuracies; limited attempt to apply knowledge; unsupported assertions; unstructured; limited evidence"],["0 marks","0","no attempt / response not worthy of credit"]]},{"type":"text","value":"Indicative content (not exhaustive; points may cover more than one issue)."},{"type":"text","value":"Legal issues:"},{"type":"list","items":["DPA must be followed or company could be fined (customers informed system is used; data held for specified time/reasons; data kept secure)","centre is private property so customers can choose not to enter","can identify people committing crimes (e.g. theft, used as evidence, makes sure correct people are caught)"]},{"type":"text","value":"Ethical issues:"},{"type":"list","items":["users feel safer because actions are monitored and help/action will be taken if needed","if users have not done anything wrong there is no reason to be tracked/recorded","users feel unsafe because they are being watched","users may be unaware they are being recorded and need to be informed / give consent","users do not know where the videos/data about them is stored or how it is used (DPA reference)"]},{"type":"text","value":"Privacy issues:"},{"type":"list","items":["users may feel it is an invasion of privacy","users are in a public place and can be legally recorded anyway","users may feel watched all the time","users have not given permission to be tracked","users may not know the system exists"]},{"type":"text","value":"Candidates should focus on the upgrade to facial recognition, not the existence of CCTV (CCTV is already in place)."}],"marks_breakdown":[{"criteria":"Band 1 (1-2 marks): basic knowledge with limited understanding, unsupported assertions, unstructured","marks":2},{"criteria":"Band 2 (3-5 marks): reasonable knowledge applied to context, some structure, most areas attempted","marks":3},{"criteria":"Band 3 (6-8 marks): thorough, balanced discussion across ethical, privacy and legal issues with well-developed reasoning and justified conclusions","marks":3}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-013.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-035.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-6.png"}},{"question_id":"7","parent_question":7,"topic":"embedded systems","marks":3,"command_word":"identify and explain","content":[{"type":"text","value":"A car comes with many embedded systems, for example parking sensors."},{"type":"text","value":"Identify one other embedded system that could be found in a car and explain why this is an embedded system."},{"type":"text","value":"Example embedded system: ____"},{"type":"text","value":"Explanation: ____"}],"answer":{"guidance":[{"type":"text","value":"1 mark for a valid example (anything reasonably within a car). If the example is not clearly an embedded system, read the explanation for justification (e.g. hazard lights could be embedded if automatically activated when the car crashes; award the example from the explanation if this occurs). 1 mark each to max 2 for explanation. If the justification is only generic features of an embedded system, max 1 for explanation. Do not award 'built into the car / larger machine' because this is stated in the question."},{"type":"text","value":"Accepted examples:"},{"type":"list","items":["auto lights","auto window wipers","sat nav / GPS","air-conditioning / climate control","radio / entertainment / infotainment / media system","lane assist","engine management system","auto-park","cruise control","auto-brake","follow-me","dashcam"]},{"type":"text","value":"Accepted explanations:"},{"type":"list","items":["limited functions (e.g. only checks the light and turns lights on/off)","dedicated microprocessor (e.g. a microprocessor only checking the lights)","hard to change function (e.g. user cannot make the light system do any other role)"]}],"marks_breakdown":[{"criteria":"Valid embedded system example within a car (e.g. auto lights, sat nav, cruise control, engine management)","marks":1},{"criteria":"Explanation point 1 (e.g. has a limited/single function, or a dedicated microprocessor, or hard to change its function)","marks":1},{"criteria":"Explanation point 2 (a second distinct feature of embedded systems applied to the chosen example)","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2023-june/question/page-014.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2023-june/markscheme/page-037.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2023-june/dev-qa/q-7.png"}}]`),hte={"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_June_2023 (2).pdf"},gte={paper_id:nte,qualification:ote,component:cte,title:lte,year:dte,session:pte,total_marks:ute,questions:mte,maps:hte},fte="J277-01-2019-Practice",yte="J277",bte="01",wte="Computer Systems",vte=2019,Ate="Practice",kte=80,xte=JSON.parse(`[{"question_id":"1(a)(i)","parent_question":1,"topic":"character set definition","marks":1,"command_word":"state","content":[{"type":"text","value":"The ASCII code for the character J is the denary number 74."},{"type":"text","value":"State what is meant by a character set."}],"answer":{"guidance":"1 mark for a definition that explains a character set as all the different characters a computer can represent. Do not award 'the set of characters' as this repeats the question.","marks_breakdown":[{"criteria":"Definition e.g. all the different characters a computer can represent","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_Systems_Practice_2019 (1).pdf","question-png":[["data/png/j277/yearpapers/paper-1-2019-practice/question/page-002.png"]],"markscheme-png":[["data/png/j277/yearpapers/paper-1-2019-practice/markscheme/page-013.png"]],"dev-qa":"e2e/screenshots/yearpapers/paper-1-2019-practice/dev-qa/q-1-a-i.png"}},{"question_id":"1(a)(ii)","parent_question":1,"topic":"ASCII character capacity","marks":1,"command_word":"identify","content":[{"type":"text","value":"ASCII has 8 bits per character."},{"type":"text","value":"Identify the maximum number of different characters that ASCII can represent."}],"answer":{"guidance":"Correct answer only: 256.","marks_breakdown":[{"criteria":"Correct answer: 256","marks":1}]},"maps":{"pdf-source":"data/pdf/j277/yearpapers/J27701_Computer_System