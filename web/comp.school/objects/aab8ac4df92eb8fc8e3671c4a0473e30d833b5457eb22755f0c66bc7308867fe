.upgrade-bay{background:radial-gradient(ellipse 70% 40% at 50% 0,rgba(253,230,138,.1),transparent 70%),radial-gradient(circle at 7px 7px,rgba(2,6,23,.55) 1.6px,transparent 2px) 0 0 / 14px 14px,linear-gradient(180deg,#111c2e,#0b1220)}.upgrade-bay[data-phase=intro]{padding:0;overflow:hidden}.upgrade-bay .ub-board-label{font:600 11px system-ui,sans-serif;fill:#a7f3d0;letter-spacing:.06em;text-transform:uppercase}.upgrade-bay .ub-board-value{font:700 14px ui-monospace,monospace;fill:#fef3c7}.upgrade-bay .ub-core-text{font:700 11px ui-monospace,monospace}.upgrade-bay .ub-cache-text{font:700 12px ui-monospace,monospace;fill:#f5f3ff}.upgrade-bay .ub-chip-name{font:800 9px system-ui,sans-serif;fill:#64748b;letter-spacing:.3em}.upgrade-bay [data-board-part]{transition:filter .2s ease}.upgrade-bay .ub-focus{filter:drop-shadow(0 0 6px #fde047) drop-shadow(0 0 2px #fde047)}.upgrade-bay .ub-tick{transform-box:fill-box;transform-origin:center;animation:ub-tick var(--ub-tick, .6s) ease-out infinite}@keyframes ub-tick{0%{opacity:1;transform:scale(1.25)}60%{opacity:.35;transform:scale(.9)}to{opacity:1;transform:scale(1.25)}}.upgrade-bay .ub-core-busy{animation:ub-core .5s ease-in-out infinite alternate}@keyframes ub-core{0%{fill:#0d9488}to{fill:#2dd4bf}}.upgrade-bay .ub-busy{transform-box:fill-box;transform-origin:center;animation:ub-spin 1.2s linear infinite}@keyframes ub-spin{to{transform:rotate(360deg)}}.upgrade-bay .ub-dial{position:relative;border:1px solid #334155;border-radius:.75rem;background:#02061799;padding:.6rem .75rem .5rem}.upgrade-bay .ub-dial[data-upgraded]{border-color:#2dd4bf8c}.upgrade-bay .ub-info{display:inline-flex;height:2rem;width:2rem;align-items:center;justify-content:center;border-radius:9999px;color:#94a3b8}.upgrade-bay .ub-info:hover,.upgrade-bay .ub-info[aria-expanded=true]{color:#5eead4}.upgrade-bay .ub-info:focus-visible{outline:2px solid #2dd4bf;outline-offset:1px}.upgrade-bay .ub-tip{position:absolute;top:2.5rem;left:.5rem;right:.5rem;z-index:10;border:1px solid #334155;border-radius:.5rem;background:#0f172a;padding:.5rem .65rem;font-size:.8125rem;line-height:1.35rem;color:#e2e8f0;box-shadow:0 10px 24px #02061799}.upgrade-bay .ub-step{display:inline-flex;height:2.75rem;width:2.75rem;flex-shrink:0;align-items:center;justify-content:center;border:1px solid #475569;border-radius:9999px;color:#f1f5f9;transition:background-color .15s ease}.upgrade-bay .ub-step:hover:not(:disabled){background:#1e293b}.upgrade-bay .ub-step:disabled{cursor:not-allowed;opacity:.3}.upgrade-bay .ub-step:focus-visible,.upgrade-bay .ub-gauge:focus-visible{outline:2px solid #2dd4bf;outline-offset:2px}.upgrade-bay .ub-gauge{min-width:0;flex:1;max-height:4.5rem;border-radius:.5rem;cursor:default}.upgrade-bay .ub-needle{transform-origin:60px 60px;transition:transform .35s cubic-bezier(.3,1.4,.5,1)}.upgrade-bay .ub-race-fill{transform-origin:left}html[data-reduce-motion=true] .upgrade-bay .ub-tick,html[data-reduce-motion=true] .upgrade-bay .ub-core-busy,html[data-reduce-motion=true] .upgrade-bay .ub-busy{animation:none}html[data-reduce-motion=true] .upgrade-bay .ub-needle,html[data-reduce-motion=true] .upgrade-bay [data-board-part]{transition:none}
