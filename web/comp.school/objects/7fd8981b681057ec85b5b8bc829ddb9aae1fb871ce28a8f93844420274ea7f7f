.case-files{--noir-cream: #f4e8cd;--noir-amber: #d4a574;background:radial-gradient(ellipse at top,#1a1f2e,#0a0d14 60%,#050709);position:relative;isolation:isolate}.case-files:before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;background-image:repeating-linear-gradient(45deg,transparent,transparent 2px,rgba(255,255,255,.008) 2px,rgba(255,255,255,.008) 4px);pointer-events:none}.case-files .font-typewriter{font-family:Special Elite,Courier Prime,Courier New,monospace}.case-files .font-typewriter-bold{font-family:Courier Prime,Courier New,monospace;font-weight:700}.case-files .font-serif-display{font-family:Playfair Display,Georgia,serif}.case-files .text-noir-cream{color:var(--noir-cream)}.case-files .case-scenario{color:#0c0a09!important}.case-files .manilla-folder{position:relative;background:linear-gradient(135deg,#e8d5a4,#d9be83);box-shadow:inset 0 1px #fff6,0 4px 12px #0006,0 1px 2px #0000004d}.case-files .stamp-confidential{display:inline-block;padding:6px 18px;border:3px solid #b91c1c;color:#b91c1c;font-family:Special Elite,Courier New,monospace;font-weight:700;letter-spacing:.15em;opacity:.8;transform:rotate(-4deg)}.case-files .stamp-classified{display:inline-block;padding:4px 14px;border:4px double #b91c1c;background:#fee2e21a;color:#b91c1c;font-family:Special Elite,Courier New,monospace;font-weight:700;letter-spacing:.2em;text-shadow:1px 1px 0 rgba(185,28,28,.2);opacity:.85;transform:rotate(-8deg)}.case-files .detective-card{background:linear-gradient(180deg,#fdf6e3,#f4e8cd);color:#2a1f10;font-family:Special Elite,Courier New,monospace;box-shadow:0 1px #fff9 inset,0 4px 14px #00000080,0 1px 3px #0006}.case-files .evidence-mount{position:relative;transform:rotate(-1.5deg)}.case-files .evidence-photo{position:relative;z-index:1;padding:10px 10px 8px;background:#fbf7ee;box-shadow:0 1px 2px #00000040,0 8px 18px #3c280a59}.case-files .evidence-photo svg{filter:sepia(.18) saturate(.92)}.case-files .evidence-clip{position:absolute;top:-20px;left:26px;width:18px;height:50px;transform:rotate(-6deg)}.case-files .evidence-clip-back{z-index:0}.case-files .evidence-clip-front{z-index:2;filter:drop-shadow(1px 2px 1px rgba(0,0,0,.35))}.case-files .case-tab{display:block;height:16px;width:30px;box-shadow:inset 0 1px #ffffff4d}.case-files .case-tab-open{width:80px}.case-files .case-tab-open-slot{position:absolute;top:-10px;left:30px}.case-files .case-tab-rail{position:absolute;top:-10px;right:24px;display:flex;gap:4px}@keyframes case-files-stamp-slam{0%{transform:rotate(-30deg) scale(3);opacity:0}60%{transform:rotate(-12deg) scale(.9);opacity:1}80%{transform:rotate(-7deg) scale(1.05)}to{transform:rotate(-8deg) scale(1);opacity:.85}}.case-files .animate-stamp-slam{animation:case-files-stamp-slam .5s cubic-bezier(.4,0,.2,1)}@media(prefers-reduced-motion:reduce){.case-files .animate-stamp-slam{animation:none}}
