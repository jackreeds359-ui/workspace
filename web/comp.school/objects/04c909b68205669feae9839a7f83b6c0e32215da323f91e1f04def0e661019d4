.ip{--ip-ink: #f8fafc;--ip-soft: #e2e8f0;--ip-fill: rgba(2, 6, 23, .82);--ip-accent: #5eead4;position:relative;display:flex;flex-direction:column;justify-content:flex-end;width:calc(100% + 2 * var(--game-gutter, 1rem))!important;min-height:100dvh;margin:calc(-1 * var(--game-top, 0px)) calc(-1 * var(--game-gutter, 1rem)) -1.5rem;overflow:hidden;color:var(--ip-ink);touch-action:pan-y}.ip-art{position:absolute;inset:0}.ip-art>svg{display:block;width:100%;height:100%}.ip:after{content:"";position:absolute;inset:auto 0 0;height:55%;background:linear-gradient(to top,#020617eb,#02061799 55%,#02061700);pointer-events:none}.ip-overlay{position:relative;z-index:1;display:flex;flex-direction:column;gap:.75rem;padding:0 var(--game-gutter, 1rem) calc(env(safe-area-inset-bottom,0px) + 1.25rem)}.ip-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:.4rem .75rem;margin:0}.ip-name{padding:.1rem .5rem;border-radius:.4rem;background:var(--ip-fill);box-decoration-break:clone;-webkit-box-decoration-break:clone;font-size:1.6rem;font-weight:700;line-height:1.35}.ip-aside{padding:.1rem .5rem;border-radius:.4rem;background:var(--ip-fill);color:var(--ip-accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:1.1rem;font-weight:700}.ip-line{margin:0;color:var(--ip-soft);font-size:1.05rem;line-height:1.5}.ip-nav{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.75rem;margin-top:.25rem}.ip-arrow{display:inline-flex;align-items:center;justify-content:center;width:3rem;height:3rem;border:1px solid rgba(248,250,252,.45);border-radius:999px;background:var(--ip-fill);color:var(--ip-ink)}.ip-arrow>svg{width:1.5rem;height:1.5rem}.ip-choose{justify-content:center;min-height:3rem;border-radius:999px;font-size:1.05rem;font-weight:700}.ip-count{margin:0;color:var(--ip-soft);font-size:.9rem;text-align:center}.ip :focus-visible{outline:2px solid var(--ip-accent);outline-offset:2px}
